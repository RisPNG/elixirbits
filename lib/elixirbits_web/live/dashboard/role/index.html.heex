<Layouts.dashboard user_timezone={@user_timezone} flash={@flash} nav={@nav}>
  <%= if @compact_layout? do %>
    <.index_compact {assigns} />
  <% else %>
    <.page
      id="roles-collection"
      data-dashboard-layout="expanded"
      class="space-y-4"
    >
      <:title>{@page_title}</:title>

      <:actions :let={position} :if={can?(@permissions, @current_path, :create)}>
        <.action_button
          navigate={~p"/dashboard/admin/roles/create"}
          id={if position == :top, do: "new-role", else: "new-role-bottom"}
          action={:create}
        />
      </:actions>

      <.cinder_collection
        id={@collection_id}
        query={@query}
        actor={@current_user}
        query_opts={[authorize?: true]}
        layout={:table}
        show_filters={true}
        url_state={%{filters: @collection_state}}
        on_state_change={:collection_state_change}
      >
        <:controls :let={controls}>
          <.cinder_controls controls={controls} />
        </:controls>

        <:col
          :let={r}
          :for={{field, label} <- @collection_fields}
          field={Atom.to_string(field)}
          label={label}
          sort
          filter
          search
        >
          {Map.fetch!(r, field)}
        </:col>

        <:col :let={r} field="description" label="Description">{r.description}</:col>

        <:col :let={r} label="Actions">
          <div class="grid grid-cols-[max-content] grid-flow-col auto-cols-max items-center justify-start gap-2">
            <.action_button
              :if={can?(@permissions, @current_path, :read)}
              action={:read}
              navigate={~p"/dashboard/admin/roles/#{r.id}/read"}
            />
            <.action_button
              :if={can?(@permissions, @current_path, :update)}
              action={:update}
              navigate={~p"/dashboard/admin/roles/#{r.id}/update"}
            />
            <.action_button
              :if={r.code != "superuser" and can?(@permissions, @current_path, :delete)}
              action={:delete}
              phx-click="request_delete"
              phx-value-id={r.id}
            />
          </div>
        </:col>
      </.cinder_collection>
    </.page>

    <.delete_confirmation
      :if={@to_delete}
      label="role"
      name={@to_delete.name}
      remove_assignments?={@remove_assignments?}
    />
  <% end %>
</Layouts.dashboard>
