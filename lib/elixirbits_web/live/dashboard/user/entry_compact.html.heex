<% editable? =
  @live_action in [:create, :update] and can?(@permissions, @current_path, @live_action) %>
<History.history audit={@audit} user_timezone={@user_timezone} entry_sections={@entry_sections} />
<.form
  for={@form}
  id="user-form"
  data-dashboard-layout="compact"
  phx-change={if editable?, do: "validate"}
  phx-submit={if editable?, do: "save"}
  class="space-y-6 record-entry-compact"
>
  <.page>
    <:title>
      {case @live_action do
        :create -> "New User"
        :read -> "User Details"
        :update -> "Edit User"
      end}
    </:title>

    <:actions>
      <div class="grid grid-cols-[max-content] grid-flow-col auto-cols-max items-center gap-2">
        <.action_button action={:back} navigate={~p"/dashboard/admin/users"} />
        <.action_button
          :if={@live_action == :update and can?(@permissions, @current_path, :read)}
          action={:read}
          navigate={~p"/dashboard/admin/users/#{@user.id}/read"}
        />
        <.action_button
          :if={@audit.available?}
          action={:history}
          patch={@audit.history_path}
        />
        <.action_button
          :if={@live_action == :read and can?(@permissions, @current_path, :update)}
          action={:update}
          navigate={~p"/dashboard/admin/users/#{@user.id}/update"}
        />
        <.action_button
          :if={editable?}
          action={:save}
          type="submit"
        />
        <.action_button
          :if={@live_action == :update and can?(@permissions, @current_path, :delete)}
          action={:delete}
          type="button"
          phx-click="request_delete"
        />
      </div>
    </:actions>

    <% roles? = List.keymember?(@entry_sections, "roles", 0)
    email = to_string(@form[:email].value)

    full_name =
      [@form[:first_name].value, @form[:middle_name].value, @form[:last_name].value]
      |> Enum.map(&String.trim(to_string(&1)))
      |> Enum.reject(&(&1 == ""))
      |> Enum.join(" ")

    name =
      Enum.find([@form[:display_name].value, full_name, email], fn value ->
        is_binary(value) and String.trim(value) != ""
      end) %>

    <div
      class="grid min-w-0 grid-cols-[4.5rem_minmax(0,1fr)] items-center gap-3 border-b border-outline pb-4"
      data-audit-side={@audit.selected && to_string(@audit.side)}
      data-audit-changed={
        if @audit.selected &&
             Enum.any?(
               @audit.fields,
               &(&1.key in ["display_pic_url", "display_pic_name"] and &1.status == :changed)
             ),
           do: "true"
      }
    >
      <div class="relative size-18">
        <span
          :if={@existing_display_pic == nil && @uploads.display_pic.entries == []}
          role="img"
          aria-label="No profile picture"
          class="absolute inset-0 grid place-items-center rounded-full bg-secondary text-xl font-medium text-brand"
        >
          <%= if name do %>
            {name |> String.trim() |> String.first() |> String.upcase()}
          <% else %>
            <.icon name="hero-user" class="size-6" />
          <% end %>
        </span>
        <.file_preview
          :if={@live_action != :read}
          id="user-profile-picture-preview"
          class="relative size-18 [&_[data-file-item]>[data-file-preview-as]]:rounded-full [&_[data-file-edit]]:min-h-11 [&_[data-file-edit]]:min-w-11 [&_[data-file-edit]]:pointer-events-auto [&_[data-file-edit]]:opacity-100"
        />
        <img
          :if={@live_action == :read && @existing_display_pic}
          src={@existing_display_pic}
          alt="Profile picture"
          class="size-full rounded-full object-cover"
        />
      </div>

      <div :if={name} class="min-w-0 space-y-1 [overflow-wrap:anywhere]">
        <p class="text-base font-semibold text-content">{name}</p>
        <p :if={email != "" && email != name} class="text-sm text-subcontent">{email}</p>
      </div>
    </div>

    <div>
      <.tabs
        id="user-entry-sections"
        type={:connected}
        label="User sections"
        active={@entry_section}
      >
        <:tab
          :for={{id, label, _fields} <- @entry_sections}
          value={id}
          controls={"user-entry-#{id}"}
          click={JS.push("entry_section", value: %{section: id})}
        >
          {label}
        </:tab>
      </.tabs>

      <div class="tabs-connected-panel">
        <section
          id="user-entry-account"
          role="tabpanel"
          aria-labelledby="user-entry-sections-account"
          hidden={@entry_section != "account"}
          class="min-w-0 p-4"
        >
          <fieldset disabled={!editable?} class="grid min-w-0 gap-4">
            <div :if={@live_action != :read} class="group/profile-picture space-y-2">
              <label for={@uploads.display_pic.ref} class="block text-sm font-medium text-content">
                Profile Picture
              </label>
              <div class="grid grid-cols-[max-content_max-content] items-center justify-start gap-2">
                <label
                  id="user-profile-picture-picker"
                  for={@uploads.display_pic.ref}
                  class={[
                    "button-base button-neutral grid min-h-11 place-items-center rounded-default px-4 py-2 text-sm group-has-[input:focus-visible]/profile-picture:outline-2 group-has-[input:focus-visible]/profile-picture:outline-brand",
                    if(editable?,
                      do: "cursor-pointer",
                      else: "cursor-not-allowed text-subcontent"
                    )
                  ]}
                >
                  {if @existing_display_pic || @uploads.display_pic.entries != [],
                    do: "Change picture",
                    else: "Upload picture"}
                </label>
                <.button
                  :for={entry <- @uploads.display_pic.entries}
                  id="user-profile-picture-cancel"
                  type="button"
                  variant={:text}
                  phx-click="cancel_upload"
                  phx-value-ref={entry.ref}
                >
                  Cancel
                </.button>
                <.button
                  :if={@uploads.display_pic.entries == []}
                  id="user-profile-picture-remove"
                  type="button"
                  variant={:text}
                  phx-click="remove_upload"
                  disabled={@existing_display_pic == nil}
                >
                  Remove
                </.button>
              </div>
              <p class="text-sm text-subcontent">
                128x128 pixels. Maximum {div(@uploads.display_pic.max_file_size, 1_000_000)} MB.
              </p>
              <.input
                type="file"
                name="display_pic"
                aria-label="Profile Picture"
                class="sr-only"
                upload={@uploads.display_pic}
                stored={List.wrap(@existing_display_pic)}
                preview={true}
                preview_id="user-profile-picture-preview"
                editor={%{width: 128, height: 128}}
                preview_as="thumbnail"
                thumbnail_class="h-full w-full"
                disabled={!editable?}
              >
                <:stored_preview :let={url}>
                  <img
                    src={url}
                    alt="Profile picture"
                    class="size-full rounded-full object-cover"
                  />
                </:stored_preview>
                <:pending_preview :let={entry}>
                  <.live_img_preview
                    entry={entry}
                    alt="Selected profile picture"
                    class="size-full rounded-full object-cover"
                  />
                </:pending_preview>
              </.input>
            </div>

            <.input
              field={@form[:email]}
              type="email"
              label="Email"
              disabled={!editable? or @live_action == :update}
            />
            <.input field={@form[:username]} type="text" label="Username" disabled={!editable?} />
            <.input
              field={@form[:display_name]}
              type="text"
              label="Display Name"
              disabled={!editable?}
            />
            <.input
              :if={@live_action == :create}
              field={@form[:password]}
              type="password"
              label="Password"
              autocomplete="new-password"
              disabled={!editable?}
            />
            <.input
              :if={@live_action == :create}
              field={@form[:password_confirmation]}
              type="password"
              label="Confirm Password"
              autocomplete="new-password"
              disabled={!editable?}
            />
          </fieldset>
        </section>

        <section
          id="user-entry-personal"
          role="tabpanel"
          aria-labelledby="user-entry-sections-personal"
          hidden={@entry_section != "personal"}
          class="min-w-0 p-4"
        >
          <fieldset disabled={!editable?} class="grid min-w-0 gap-4">
            <.input
              field={@form[:first_name]}
              type="text"
              label="First Name"
              disabled={!editable?}
            />
            <.input
              field={@form[:middle_name]}
              type="text"
              label="Middle Name"
              disabled={!editable?}
            />
            <.input field={@form[:last_name]} type="text" label="Last Name" disabled={!editable?} />
            <.input
              field={@form[:tel_no]}
              type="tel"
              label="Phone"
              render_as={if editable?, do: "enabled", else: "disabled"}
            />
            <.input
              field={@form[:sex]}
              type="combobox"
              label="Sex"
              options={@sex_options}
              prompt="None"
              disabled={!editable?}
            />
            <.input field={@form[:dob]} type="date" label="Date of Birth" disabled={!editable?} />
            <div class="grid grid-cols-[minmax(0,2fr)_minmax(0,4fr)] subgap-2">
              <.input
                field={@form[:locale]}
                type="combobox"
                label="Locale"
                options={@locale_options}
                prompt="None"
                disabled={!editable?}
              />
              <.input
                field={@form[:timezone]}
                type="combobox"
                label="Timezone"
                options={@nav.timezone_options}
                placeholder="Automatic (browser)"
                clear_button={false}
                disabled={!editable?}
              />
            </div>
          </fieldset>
        </section>

        <section
          id="user-entry-addresses"
          role="tabpanel"
          aria-labelledby="user-entry-sections-addresses"
          hidden={@entry_section != "addresses"}
          class="min-w-0 p-4"
        >
          <fieldset disabled={!editable?} class="grid min-w-0 gap-4">
            <.button
              :if={editable? and can?(@permissions, @current_path, :create)}
              type="button"
              phx-click="add_form"
              phx-value-field="addresses"
              variant={:neutral}
              class="justify-self-start"
            >
              <.icon name="hero-plus-micro" class="size-4" /> Add address
            </.button>

            <p :if={@form.source.forms[:addresses] in [nil, []]} class="text-sm text-subcontent">
              No addresses.
            </p>

            <div id={@form[:addresses].id} class="grid min-w-0 gap-4">
              <.inputs_for :let={af} field={@form[:addresses]}>
                <% recorded_fields =
                  af.source.data &&
                    Ash.Resource.get_metadata(af.source.data, :audit_recorded_fields)

                position =
                  cond do
                    editable? ->
                      af.index + 1

                    Ash.Resource.get_metadata(af.source.data, :audit_removed?) ->
                      nil

                    recorded_fields && not MapSet.member?(recorded_fields, "sequence") ->
                      Ash.Resource.get_metadata(af.source.data, :audit_position) + 1

                    true ->
                      af[:sequence].value
                  end %>
                <.entry_panel id={"#{af.id}-panel"} label="Address" index={af.index}>
                  <:sequence>
                    <.input
                      field={af[:sequence]}
                      name={"address_position[#{af.index}]"}
                      type={if editable?, do: "number", else: "text"}
                      render_as={if editable?, do: "text", else: "text-disabled"}
                      value={position || "nil"}
                      min={1}
                      max={length(@form.source.forms[:addresses] || [])}
                      step={1}
                      clear_button={false}
                      disabled={!editable?}
                      aria-label={"Address #{position || "nil"} sequence"}
                      phx-debounce={nil}
                      class="min-w-0 w-full appearance-none border-0 bg-transparent p-0 py-1 text-left text-sm font-semibold text-content focus:outline-none focus:ring-0 focus-visible:underline disabled:text-subcontent disabled:cursor-not-allowed"
                    />
                  </:sequence>
                  <:actions>
                    <.action_button
                      :if={
                        editable? and
                          (af.source.type == :create or can?(@permissions, @current_path, :delete))
                      }
                      type="button"
                      phx-click="remove_form"
                      phx-value-path={af.name}
                      action={:delete}
                    />
                  </:actions>

                  <div class="grid grid-cols-[minmax(0,2fr)_minmax(0,3fr)] subgap-2">
                    <.input
                      id={"#{af.id}_label_select"}
                      field={af[:label]}
                      type="combobox"
                      label="Label"
                      options={@label_options}
                      prompt="None"
                      disabled={!editable?}
                    />
                    <.input
                      field={af[:other_label]}
                      type="text"
                      label="Nickname"
                      disabled={!editable?}
                    />
                  </div>
                  <.input
                    field={af[:contact_name]}
                    type="text"
                    label="Contact Name"
                    disabled={!editable?}
                  />
                  <.input
                    field={af[:contact_tel_no]}
                    type="text"
                    label="Contact"
                    render_as={if editable?, do: "enabled", else: "disabled"}
                  />
                  <.input field={af[:line_1]} type="text" label="Line 1" disabled={!editable?} />
                  <.input field={af[:line_2]} type="text" label="Line 2" disabled={!editable?} />
                  <.input field={af[:line_3]} type="text" label="Line 3" disabled={!editable?} />
                  <div class="grid grid-cols-[minmax(0,2fr)_minmax(0,3fr)] subgap-2">
                    <.input
                      field={af[:postal_code]}
                      type="text"
                      label="Postal Code"
                      disabled={!editable?}
                    />
                    <.input field={af[:city]} type="text" label="City" disabled={!editable?} />
                  </div>
                  <.input field={af[:state]} type="text" label="State" disabled={!editable?} />
                  <.input field={af[:country]} type="text" label="Country" disabled={!editable?} />
                </.entry_panel>
              </.inputs_for>
            </div>
          </fieldset>
        </section>

        <section
          :if={roles?}
          id="user-entry-roles"
          role="tabpanel"
          aria-labelledby="user-entry-sections-roles"
          hidden={@entry_section != "roles"}
          class="min-w-0 p-4"
        >
          <div id="user-roles">
            <.input
              field={@form[:roles]}
              type="combobox"
              multiple
              label="Roles"
              options={@role_options}
              disabled={!editable?}
            />
          </div>
        </section>
      </div>
    </div>
  </.page>
</.form>
<.delete_confirmation
  :if={@to_delete}
  label="user"
  name={@to_delete.display_name || to_string(@to_delete.email)}
/>
