<Layouts.app user_timezone={@user_timezone} flash={@flash} content_class="mx-auto w-full max-w-md">
  <.card>
    <.header>
      Register
      <:subtitle>Create an account with your email and a password.</:subtitle>
    </.header>

    <.form
      class="flex flex-col gap-4"
      for={@form}
      id="register-form"
      action={~p"/auth/user/password/register"}
      method="post"
      phx-change="validate"
      phx-submit="submit"
      phx-trigger-action={@trigger_action}
    >
      <.input field={@form[:email]} type="email" label="Email" required />
      <.input field={@form[:password]} type="password" label="Password" required />
      <.input
        field={@form[:password_confirmation]}
        type="password"
        label="Confirm password"
        required
      />

      <div class="flex flex-col">
        <.button
          type="submit"
          variant={:primary}
          phx-disable-with="Registering..."
        >
          Register
        </.button>
      </div>
    </.form>

    <p class="border-t border-outline pt-4 text-sm text-subcontent">
      Already have an account?
      <.link
        navigate={~p"/sign-in"}
        class="text-brand underline-offset-4 hover:underline focus-visible:underline"
      >Sign in</.link>
    </p>
  </.card>
</Layouts.app>
