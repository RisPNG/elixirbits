<Layouts.app flash={@flash} content_class="mx-auto w-full max-w-md">
  <section class="rounded-lg border border-secondary bg-primary shadow-sm">
    <div class="flex flex-col p-6 gap-6">
      <.header>
        Register
        <:subtitle>Create an account with your email and a password.</:subtitle>
      </.header>

      <.form
        for={@form}
        id="register-form"
        action={~p"/auth/user/password/register"}
        method="post"
        phx-change="validate"
        phx-submit="submit"
        phx-trigger-action={@trigger_action}
      >
        <.input field={@form[:email]} type="email" label="Email" required />
        <.input field={@form[:password]} type="password" label="Password" required />
        <.input
          field={@form[:password_confirmation]}
          type="password"
          label="Confirm password"
          required
        />

        <div class="flex flex-col mt-4">
          <.button
            type="submit"
            class="px-4 py-2 text-sm bg-brand text-content-alt hover:bg-brand-alt"
            phx-disable-with="Registering..."
          >
            Register
          </.button>
        </div>
      </.form>

      <p class="text-sm text-subcontent">
        Already have an account?
        <.link navigate={~p"/sign-in"} class="text-brand hover:underline">Sign in</.link>
      </p>
    </div>
  </section>
</Layouts.app>
