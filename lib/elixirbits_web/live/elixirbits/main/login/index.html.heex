<Layouts.app user_timezone={@user_timezone} flash={@flash} content_class="mx-auto w-full max-w-md">
  <.card>
    <.header level={1}>
      Sign In
      <:subtitle>Use your email and password, or request a magic link.</:subtitle>
    </.header>

    <.form
      class="flex flex-col gap-4"
      for={@form}
      id="login-form"
      phx-change="validate"
      phx-submit="submit"
    >
      <.input
        field={@form[:email]}
        type="email"
        label="Email"
        required
      />
      <.input field={@form[:password]} type="password" label="Password" required />
      <div class="grid grid-cols-[1fr_max-content] items-center gap-4">
        <.input
          field={@form[:remember_me]}
          type="checkbox"
          variant="alt"
          label="Remember me"
          tooltip="Keeps you signed in for a year."
        />
        <.button
          navigate={~p"/reset"}
          variant={:text}
        >Forgot password?</.button>
      </div>

      <div class="flex flex-col gap-2">
        <.button
          type="submit"
          variant={:primary}
          phx-disable-with="Signing in..."
        >
          Sign in
        </.button>
        <.button
          type="button"
          variant={:text}
          class="self-center"
          phx-click="request_magic_link"
        >
          Email me a magic link
        </.button>
      </div>
    </.form>

    <p class="border-t border-outline pt-4 text-center text-sm text-subcontent">
      <.button
        navigate={~p"/register"}
        variant={:text}
      >Create an account</.button>
    </p>
  </.card>
</Layouts.app>
