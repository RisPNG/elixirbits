<Layouts.app flash={@flash} content_class="mx-auto w-full max-w-md">
  <section class="rounded-lg border border-base-300 bg-base-100 shadow-sm">
    <div class="flex flex-col p-6 gap-6">
      <.header>
        Sign In
        <:subtitle>Use your email and password, or request a magic link.</:subtitle>
      </.header>

      <.form for={@form} id="login-form" phx-change="validate" phx-submit="submit">
        <.input field={@form[:email]} type="email" label="Email" required />
        <.input field={@form[:password]} type="password" label="Password" required />
        <.input field={@form[:remember_me]} type="checkbox" label="Remember me" />

        <div class="flex flex-col gap-2 mt-4">
          <.button type="submit" variant="primary" phx-disable-with="Signing in...">
            Sign in
          </.button>
          <.button type="button" variant="soft" phx-click="request_magic_link">
            Email me a magic link
          </.button>
        </div>
      </.form>

      <div class="grid grid-cols-[1fr_1fr] gap-2 text-sm">
        <.link navigate={~p"/reset"} class="text-primary hover:underline">
          Forgot password?
        </.link>
        <.link navigate={~p"/register"} class="text-primary hover:underline justify-self-end">
          Create an account
        </.link>
      </div>
    </div>
  </section>
</Layouts.app>
