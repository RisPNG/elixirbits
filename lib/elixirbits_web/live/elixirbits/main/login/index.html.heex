<Layouts.app user_timezone={@user_timezone} flash={@flash} content_class="mx-auto w-full max-w-md">
  <.card>
    <.header>
      Sign In
      <:subtitle>Use your email and password, or request a magic link.</:subtitle>
    </.header>

    <.form
      class="flex flex-col gap-4"
      for={@form}
      id="login-form"
      phx-change="validate"
      phx-submit="submit"
    >
      <.input
        field={@form[:email]}
        type="email"
        label="Email"
        required
      />
      <.input field={@form[:password]} type="password" label="Password" required />
      <.input
        field={@form[:remember_me]}
        type="checkbox"
        variant="alt"
        label="Remember me"
        tooltip="Keeps you signed in for a year."
      />

      <div class="flex flex-col gap-2">
        <.button
          type="submit"
          variant={:primary}
          phx-disable-with="Signing in..."
        >
          Sign in
        </.button>
        <.button
          type="button"
          variant={:neutral}
          phx-click="request_magic_link"
        >
          Email me a magic link
        </.button>
      </div>
    </.form>

    <div class="grid grid-cols-[1fr_1fr] gap-2 text-sm">
      <.link navigate={~p"/reset"} class="text-brand hover:underline hover:overlay-dark">
        Forgot password?
      </.link>
      <.link
        navigate={~p"/register"}
        class="text-brand hover:underline hover:overlay-dark justify-self-end"
      >
        Create an account
      </.link>
    </div>
  </.card>
</Layouts.app>
