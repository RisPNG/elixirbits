<Layouts.app user_timezone={@user_timezone} flash={@flash} content_class="mx-auto w-full max-w-md">
  <.card>
    <.header>
      Confirm Email
      <:subtitle>Click the button below to confirm your email address.</:subtitle>
    </.header>

    <.form
      class="flex flex-col gap-4"
      for={%{}}
      id="confirm-form"
      action={~p"/auth/user/confirm_new_user"}
      method="post"
    >
      <.input name="confirm" type="hidden" value={@token} />

      <div class="flex flex-col">
        <.button
          type="submit"
          variant={:primary}
          phx-disable-with="Confirming..."
        >
          Confirm my email
        </.button>
      </div>
    </.form>
  </.card>
</Layouts.app>
