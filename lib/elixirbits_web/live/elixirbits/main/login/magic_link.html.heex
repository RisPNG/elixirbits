<Layouts.app user_timezone={@user_timezone} flash={@flash} content_class="mx-auto w-full max-w-md">
  <.card>
    <.header level={1}>
      Magic Link Sign In
      <:subtitle>Click the button below to finish signing in.</:subtitle>
    </.header>

    <.form
      class="flex flex-col gap-4"
      for={%{}}
      id="magic-link-form"
      action={~p"/auth/user/magic_link"}
      method="post"
    >
      <.input name="user[token]" type="hidden" value={@token} />
      <.input name="user[remember_me]" type="checkbox" variant="alt" label="Remember me" />

      <div class="flex flex-col">
        <.button
          type="submit"
          variant={:primary}
          phx-disable-with="Signing in..."
        >
          Sign in
        </.button>
      </div>
    </.form>
  </.card>
</Layouts.app>
