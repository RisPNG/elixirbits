<Layouts.app flash={@flash} content_class="mx-auto w-full max-w-md">
  <section class="rounded-lg border border-base-300 bg-base-100 shadow-sm">
    <div class="flex flex-col p-6 gap-6">
      <.header>
        Magic Link Sign In
        <:subtitle>Click the button below to finish signing in.</:subtitle>
      </.header>

      <.form for={%{}} id="magic-link-form" action={~p"/auth/user/magic_link"} method="post">
        <.input name="user[token]" type="hidden" value={@token} />
        <.input name="user[remember_me]" type="checkbox" label="Remember me" />

        <div class="flex flex-col mt-4">
          <.button type="submit" variant="primary" phx-disable-with="Signing in...">
            Sign in
          </.button>
        </div>
      </.form>
    </div>
  </section>
</Layouts.app>
