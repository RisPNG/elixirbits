<Layouts.app
  flash={@flash}
  current_scope={@current_scope}
  content_class="mx-auto w-full max-w-[110rem] space-y-6"
>
  <section class="rounded-lg border border-primary-alt bg-primary shadow-sm">
    <div class="space-y-5 p-6">
      <.header>
        Layout Test
        <:subtitle>
          Showcases local core components and dependency-powered frontend pieces.
        </:subtitle>
      </.header>

      <div
        id="layout-test-tabs"
        role="tablist"
        aria-label="Layout test sections"
        class="flex flex-wrap items-center gap-2"
      >
        <.button
          id="layout-test-local-tab"
          type="button"
          role="tab"
          aria-selected={if(@current_tab == "local", do: "true", else: "false")}
          class={[
            "px-4 py-2 text-sm",
            if(@current_tab == "local",
              do: "bg-brand text-content-alt hover:bg-brand-alt",
              else: "bg-primary-alt text-brand hover:bg-brand hover:text-content-alt"
            )
          ]}
          phx-click="change_tab"
          phx-value-tab="local"
        >
          Local
        </.button>

        <.button
          id="layout-test-ecosystem-tab"
          type="button"
          role="tab"
          aria-selected={if(@current_tab == "ecosystem", do: "true", else: "false")}
          class={[
            "px-4 py-2 text-sm",
            if(@current_tab == "ecosystem",
              do: "bg-brand text-content-alt hover:bg-brand-alt",
              else: "bg-primary-alt text-brand hover:bg-brand hover:text-content-alt"
            )
          ]}
          phx-click="change_tab"
          phx-value-tab="ecosystem"
        >
          Ecosystem
        </.button>
      </div>
    </div>
  </section>

  <%= if @current_tab == "local" do %>
    <div id="layout-test-local-panel" role="tabpanel" class="space-y-6">
      <section class="grid grid-cols-[repeat(auto-fit,minmax(18rem,1fr))] gap-4">
        <article
          id="layout-test-header-card"
          class="flex flex-col rounded-lg border border-primary-alt bg-primary shadow-sm"
        >
          <div class="flex flex-col p-6 gap-4">
            <.header>
              Core Header
              <:subtitle>Title, subtitle, action slot, button variants.</:subtitle>
              <:actions>
                <.button
                  type="button"
                  id="layout-test-inline-action"
                  class="px-3 py-1.5 text-sm bg-primary-alt text-brand hover:bg-brand hover:text-content-alt"
                >
                  Action
                </.button>
              </:actions>
            </.header>

            <div class="flex flex-wrap items-center gap-2">
              <.button
                type="button"
                id="layout-test-soft-button"
                class="px-3 py-1.5 text-sm bg-primary-alt text-brand hover:bg-brand hover:text-content-alt"
              >
                Soft
              </.button>
              <.button
                type="button"
                id="layout-test-primary-button"
                class="px-3 py-1.5 text-sm bg-brand text-content-alt hover:bg-brand-alt"
              >
                Primary
              </.button>
              <.button
                navigate={~p"/"}
                id="layout-test-home-link"
                class="px-3 py-1.5 text-sm bg-transparent text-content hover:bg-primary-alt"
              >
                Home
              </.button>
            </div>
          </div>
        </article>

        <article
          id="layout-test-flash-card"
          class="flex flex-col rounded-lg border border-primary-alt bg-primary shadow-sm"
        >
          <div class="flex flex-col p-6 gap-4">
            <.header>
              Flashes
              <:subtitle>Triggered here, rendered by `Layouts.flash_group`.</:subtitle>
            </.header>

            <div class="flex flex-wrap items-center gap-2">
              <.button
                type="button"
                id="layout-test-flash-info"
                phx-click="show_flash"
                phx-value-kind="info"
                class="px-3 py-1.5 text-sm bg-primary-alt text-brand hover:bg-brand hover:text-content-alt"
              >
                Info Flash
              </.button>
              <.button
                type="button"
                id="layout-test-flash-error"
                phx-click="show_flash"
                phx-value-kind="error"
                class="px-3 py-1.5 text-sm bg-error text-content-alt hover:bg-error-alt"
              >
                Error Flash
              </.button>
              <.button
                type="button"
                id="layout-test-flash-warning"
                phx-click="show_flash"
                phx-value-kind="warning"
                class="px-3 py-1.5 text-sm bg-primary-alt text-brand hover:bg-brand hover:text-content-alt"
              >
                Warning Flash
              </.button>
            </div>
          </div>
        </article>

        <article
          id="layout-test-theme-card"
          class="flex flex-col rounded-lg border border-primary-alt bg-primary shadow-sm"
        >
          <div class="flex flex-col p-6 gap-4">
            <.header>
              Theme Toggle
              <:subtitle>Light, dark, system from shared site layout.</:subtitle>
            </.header>

            <div class="flex items-center justify-between gap-4 rounded-lg border border-primary-alt bg-primary-alt p-4">
              <div class="space-y-1">
                <p class="font-medium">Site Theme</p>
                <p class="text-sm text-subcontent">
                  Uses shared `Layouts.theme_toggle`.
                </p>
              </div>
              <Layouts.theme_toggle />
            </div>
          </div>
        </article>
      </section>

      <section
        id="layout-test-form-section"
        class="flex flex-col rounded-lg border border-primary-alt bg-primary shadow-sm"
      >
        <div class="flex flex-col p-6 gap-6">
          <.header>
            Core Inputs
            <:subtitle>Showcases `&lt;.input&gt;` variants from local component layer.</:subtitle>
          </.header>

          <.form for={@local_form} id="layout-test-form" class="space-y-4">
            <.input field={@local_form[:hidden_token]} type="hidden" />

            <div class="grid grid-cols-[repeat(auto-fit,minmax(16rem,1fr))] gap-4">
              <.input field={@local_form[:project_name]} type="text" label="Text" />
              <.input field={@local_form[:email]} type="email" label="Email" />
              <.input field={@local_form[:password]} type="password" label="Password" />
              <.input field={@local_form[:budget]} type="number" label="Number" />
              <.input field={@local_form[:launch_date]} type="date" label="Date" />
              <.input field={@local_form[:launch_time]} type="time" label="Time" />
              <.input field={@local_form[:launch_week]} type="week" label="Week" />
              <.input field={@local_form[:launch_month]} type="month" label="Month" />
              <.input field={@local_form[:launch_at]} type="datetime-local" label="Datetime" />
              <.input field={@local_form[:accent]} type="color" label="Color" />
              <.input field={@local_form[:search]} type="search" label="Search" />
              <.input field={@local_form[:website]} type="url" label="URL" />
              <.input field={@local_form[:phone]} type="tel" label="Telephone" />
              <.input
                id="layout-test-local-role"
                field={@local_form[:role]}
                type="select"
                label="Select"
                options={[
                  {"Administrator", "admin"},
                  {"Designer", "designer"},
                  {"Viewer", "viewer"}
                ]}
                phx-focus="live_select_change"
              />
              <.input field={@local_form[:notes]} type="textarea" label="Textarea" rows="4" />
              <.input field={@local_form[:enabled]} type="checkbox" label="Checkbox" />
              <.input field={@local_form[:switch]} type="switch" label="Switch" />
              <.input
                id="layout-test-local-tags"
                field={@local_form[:tags]}
                type="select"
                label="Tags (Quick Tag)"
                mode={:quick_tags}
                options={[
                  {"Elixir", "elixir"},
                  {"Phoenix", "phoenix"},
                  {"LiveView", "liveview"}
                ]}
                phx-focus="live_select_change"
              />
              <.input field={@local_form[:upload]} type="file" label="File" />
              <.input
                name="demo_error"
                type="text"
                label="Errored"
                value="invalid value"
                errors={["Has an error"]}
              />
              <.input
                name="demo_disabled"
                type="text"
                label="Disabled"
                value="cannot edit"
                disabled
              />
              <.input
                name="demo_disabled_select"
                type="select"
                label="Disabled Select"
                options={[{"Locked", "locked"}]}
                value="locked"
                disabled
              />
              <.input
                name="demo_disabled_tags"
                type="select"
                label="Disabled Tags"
                mode={:quick_tags}
                options={[
                  {"Elixir", "elixir"},
                  {"Phoenix", "phoenix"},
                  {"LiveView", "liveview"}
                ]}
                value={["elixir", "phoenix"]}
                disabled
              />
              <.input
                name="demo_disabled_checkbox"
                type="checkbox"
                label="Disabled Checkbox"
                checked
                disabled
              />
            </div>
          </.form>
        </div>
      </section>

      <section class="grid grid-cols-[repeat(auto-fit,minmax(22rem,1fr))] gap-4">
        <article
          id="layout-test-table-card"
          class="flex flex-col rounded-lg border border-primary-alt bg-primary shadow-sm"
        >
          <div class="flex flex-col p-6 gap-4">
            <.header>
              Core Table
              <:subtitle>Reusable table component with action slot.</:subtitle>
            </.header>

            <div class="overflow-x-auto">
              <.table
                id="layout-test-core-table"
                rows={[
                  %{section: "Header", scope: "Page framing", status: "Ready"},
                  %{section: "Inputs", scope: "Form states", status: "Ready"},
                  %{section: "Dependencies", scope: "LiveSelect + pages", status: "Ready"}
                ]}
              >
                <:col :let={row} label="Section">{row.section}</:col>
                <:col :let={row} label="Scope">{row.scope}</:col>
                <:col :let={row} label="Status">
                  <span class="inline-flex items-center px-2 py-0.5 rounded-full text-xs font-medium bg-success text-content-alt">
                    {row.status}
                  </span>
                </:col>
                <:action>
                  <.button
                    type="button"
                    class="px-2 py-1 text-xs bg-secondary text-brand hover:bg-brand hover:text-content-alt"
                  >
                    Inspect
                  </.button>
                </:action>
              </.table>
            </div>
          </div>
        </article>

        <article
          id="layout-test-list-card"
          class="flex flex-col rounded-lg border border-primary-alt bg-primary shadow-sm"
        >
          <div class="flex flex-col p-6 gap-4">
            <.header>
              Core List
              <:subtitle>Simple label/value presentation for compact detail groups.</:subtitle>
            </.header>

            <.list>
              <:item title="Surface">Local core components</:item>
              <:item title="Theme">Shared dark and light tokens</:item>
              <:item title="Flash">Global toast stack</:item>
              <:item title="Tabs">Single LiveView state</:item>
            </.list>
          </div>
        </article>
      </section>

      <section
        id="layout-test-icons-card"
        class="flex flex-col rounded-lg border border-primary-alt bg-primary shadow-sm"
      >
        <div class="flex flex-col p-6 gap-6">
          <.header>
            Core Icons
            <:subtitle>Heroicons via shared `&lt;.icon&gt;` component.</:subtitle>
          </.header>

          <div class="grid grid-cols-[repeat(auto-fit,minmax(10rem,1fr))] gap-3">
            <div
              :for={
                icon <- [
                  {"hero-sparkles", "Sparkles"},
                  {"hero-bolt", "Bolt"},
                  {"hero-cog-6-tooth", "Cog"},
                  {"hero-command-line", "CLI"},
                  {"hero-server-stack", "Server"},
                  {"hero-swatch", "Swatch"}
                ]
              }
              class="rounded-lg border border-primary-alt bg-primary-alt p-4"
            >
              <div class="flex items-center gap-3">
                <.icon name={elem(icon, 0)} class="size-5" />
                <span class="text-sm font-medium">{elem(icon, 1)}</span>
              </div>
            </div>
          </div>
        </div>
      </section>
    </div>
  <% end %>

  <%= if @current_tab == "ecosystem" do %>
    <div id="layout-test-ecosystem-panel" role="tabpanel" class="space-y-6">
      <section class="grid grid-cols-[repeat(auto-fit,minmax(14rem,1fr))] gap-4">
        <article class="flex flex-col rounded-lg border border-primary-alt bg-primary shadow-sm">
          <div class="flex flex-col p-6 gap-2">
            <p class="text-sm text-subcontent">Dependency Pages</p>
            <p class="text-3xl font-semibold">{length(@dependency_pages)}</p>
          </div>
        </article>

        <article class="flex flex-col rounded-lg border border-primary-alt bg-primary shadow-sm">
          <div class="flex flex-col p-6 gap-2">
            <p class="text-sm text-subcontent">Cinder Surfaces</p>
            <p class="text-3xl font-semibold">3</p>
          </div>
        </article>
      </section>

      <section class="grid grid-cols-[repeat(auto-fit,minmax(24rem,1fr))] gap-4">
        <article
          id="layout-test-cinder-collection-card"
          class="flex flex-col rounded-lg border border-primary-alt bg-primary shadow-sm"
        >
          <div class="flex flex-col p-6 gap-4">
            <.header>
              Cinder Collection
              <:subtitle>List layout with Ash-backed search, filters, and pagination.</:subtitle>
            </.header>

            <div
              id="layout-test-cinder-collection"
              class="rounded-lg border border-primary-alt bg-primary-alt p-4"
            >
              <Cinder.collection
                id="layout-test-cinder-collection-component"
                query={@sitenav_query}
                actor={nil}
                layout={:list}
                page_size={5}
                show_filters={true}
                search={[label: "Search sitenav", placeholder: "Code, name, description"]}
                query_opts={[authorize?: false]}
              >
                <:col :let={entry} field="code" label="Code" sort filter search>
                  {entry.code}
                </:col>
                <:col :let={entry} field="name" label="Name" sort filter search>
                  {entry.name}
                </:col>
                <:col :let={entry} field="state" label="State" filter sort>
                  {entry.state}
                </:col>
                <:item :let={entry}>
                  <div class="flex flex-wrap items-center gap-2">
                    <span class="inline-flex items-center px-2 py-0.5 rounded-full text-xs font-medium bg-primary-alt text-brand">
                      {entry.code}
                    </span>
                    <span class="inline-flex items-center px-2 py-0.5 rounded-full text-xs font-medium bg-primary-alt text-content">
                      {entry.state}
                    </span>
                  </div>
                  <div class="mt-3 space-y-1">
                    <p class="font-semibold">{entry.name}</p>
                    <p class="text-sm text-subcontent">{entry.description}</p>
                    <p class="text-xs text-subcontent">{entry.url}</p>
                  </div>
                </:item>
              </Cinder.collection>
            </div>
          </div>
        </article>

        <article
          id="layout-test-cinder-table-card"
          class="flex flex-col rounded-lg border border-primary-alt bg-primary shadow-sm"
        >
          <div class="flex flex-col p-6 gap-4">
            <.header>
              Cinder Table
              <:subtitle>
                Table wrapper over the same Ash data source for sortable rows.
              </:subtitle>
            </.header>

            <div
              id="layout-test-cinder-table"
              class="rounded-lg border border-primary-alt bg-primary-alt p-4"
            >
              <Cinder.Table.table
                id="layout-test-cinder-table-component"
                query={@sitenav_query}
                actor={nil}
                page_size={5}
                show_filters={true}
                search={[label: "Search table", placeholder: "Code, name, URL"]}
                query_opts={[authorize?: false]}
              >
                <:col :let={entry} field="code" label="Code" sort filter search>
                  {entry.code}
                </:col>
                <:col :let={entry} field="name" label="Name" sort filter search>
                  {entry.name}
                </:col>
                <:col :let={entry} field="level" label="Level" sort filter>
                  {entry.level}
                </:col>
                <:col :let={entry} field="url" label="Route" filter search>
                  <code>{entry.url}</code>
                </:col>
                <:col :let={entry} field="sequence" label="Sequence" sort>
                  {entry.sequence}
                </:col>
              </Cinder.Table.table>
            </div>
          </div>
        </article>
      </section>

      <section
        id="layout-test-cinder-grid-card"
        class="flex flex-col rounded-lg border border-primary-alt bg-primary shadow-sm"
      >
        <div class="flex flex-col p-6 gap-4">
          <.header>
            Cinder Grid
            <:subtitle>
              Grid layout over the same Ash data source, with search, filters, sorting, and pagination.
            </:subtitle>
          </.header>

          <div
            id="layout-test-cinder-grid"
            class="rounded-lg border border-primary-alt bg-primary-alt p-4"
          >
            <Cinder.collection
              id="layout-test-cinder-grid-component"
              query={@sitenav_query}
              actor={nil}
              layout={:grid}
              container_class="grid grid-cols-[1fr_1fr_1fr] gap-4"
              page_size={6}
              show_filters={true}
              search={[label: "Search grid", placeholder: "Code, name, description"]}
              query_opts={[authorize?: false]}
            >
              <:col :let={entry} field="code" label="Code" sort filter search>
                {entry.code}
              </:col>
              <:col :let={entry} field="name" label="Name" sort filter search>
                {entry.name}
              </:col>
              <:col :let={entry} field="state" label="State" filter sort>
                {entry.state}
              </:col>
              <:item :let={entry}>
                <div class="flex flex-wrap items-center gap-2">
                  <span class="inline-flex items-center px-2 py-0.5 rounded-full text-xs font-medium bg-primary-alt text-brand">
                    {entry.code}
                  </span>
                  <span class="inline-flex items-center px-2 py-0.5 rounded-full text-xs font-medium bg-primary-alt text-content">
                    {entry.state}
                  </span>
                </div>
                <div class="mt-3 space-y-1">
                  <p class="font-semibold">{entry.name}</p>
                  <p class="text-sm text-subcontent">{entry.description}</p>
                  <p class="text-xs text-subcontent">{entry.url}</p>
                </div>
              </:item>
            </Cinder.collection>
          </div>
        </div>
      </section>

      <section class="grid grid-cols-[repeat(auto-fit,minmax(20rem,1fr))] gap-4">
        <article
          id="layout-test-live-select-card"
          class="flex flex-col rounded-lg border border-primary-alt bg-primary shadow-sm"
        >
          <div class="flex flex-col p-6 gap-4">
            <.header>
              LiveSelect
              <:subtitle>Dependency component with JS hooks.</:subtitle>
            </.header>

            <.form
              for={@dependency_form}
              id="layout-test-dependency-form"
              phx-change="dependency_change"
            >
              <LiveSelect.live_select
                field={@dependency_form[:component_search]}
                id="layout-test-dependency-live-select"
                options={@dependency_options}
                placeholder="Search dependency pages"
                phx-focus="live_select_change"
                keep_options_on_select
                keep_label_on_select
                allow_clear
                text_input_class="block w-full min-h-11 px-3 py-2 rounded-md border border-primary-alt bg-primary text-content focus:outline-none focus:border-brand focus:ring-2 focus:ring-brand disabled:text-subcontent disabled:cursor-not-allowed disabled:bg-primary-alt"
                text_input_selected_class=""
                dropdown_class="absolute top-full mt-1 w-full rounded-md border border-primary-alt bg-primary shadow-lg z-50 max-h-60 overflow-y-auto"
                option_class="cursor-pointer select-none relative py-2 px-3 text-content hover:bg-primary-alt"
                selected_option_class="cursor-pointer select-none relative py-2 px-3 text-content bg-primary-alt font-semibold hover:bg-primary-alt order-first"
                active_option_class="bg-primary-alt"
                container_class="relative flex flex-col w-full"
                clear_button_extra_class="absolute right-2 top-1/2 -translate-y-1/2 flex items-center cursor-pointer text-error hover:text-error-alt"
              >
                <:clear_button>
                  <.icon name="hero-x-mark" class="size-4" />
                </:clear_button>
              </LiveSelect.live_select>
            </.form>

            <div
              id="layout-test-selected-dependency"
              class="rounded-lg border border-primary-alt bg-primary p-4"
            >
              <%= if @selected_dependency do %>
                <div class="space-y-3">
                  <div class="flex flex-wrap items-center gap-2">
                    <span class="inline-flex items-center px-2 py-0.5 rounded-full text-xs font-medium bg-primary-alt text-brand">
                      {@selected_dependency.source}
                    </span>
                    <span class="inline-flex items-center px-2 py-0.5 rounded-full text-xs font-medium bg-primary-alt text-content">
                      {@selected_dependency.availability}
                    </span>
                  </div>
                  <div class="space-y-1">
                    <p class="font-semibold">{@selected_dependency.name}</p>
                    <p class="text-sm text-subcontent">
                      {@selected_dependency.description}
                    </p>
                    <p class="text-xs text-subcontent">{@selected_dependency.path}</p>
                  </div>
                  <.button
                    href={@selected_dependency.path}
                    class="px-3 py-1.5 text-sm bg-brand text-content-alt hover:bg-brand-alt"
                  >
                    Open Selected Page
                  </.button>
                </div>
              <% else %>
                <p class="text-sm text-subcontent">
                  Pick one dependency page above to preview target route and source package.
                </p>
              <% end %>
            </div>
          </div>
        </article>

        <article
          id="layout-test-ui-kit-card"
          class="flex flex-col rounded-lg border border-primary-alt bg-primary shadow-sm"
        >
          <div class="flex flex-col p-6 gap-4">
            <.header>
              UI Kit
              <:subtitle>
                Raw Tailwind primitives for alerts, badges, progress, steps, menu.
              </:subtitle>
            </.header>

            <div class="space-y-3">
              <div class="flex items-center gap-2 p-4 rounded-md border bg-primary-alt border-info text-info">
                <.icon name="hero-information-circle" class="size-5" />
                <span>Info alert surface</span>
              </div>
              <div class="flex items-center gap-2 p-4 rounded-md border bg-success border-primary-alt text-content-alt">
                <.icon name="hero-check-circle" class="size-5" />
                <span>Success alert surface</span>
              </div>
              <div class="flex flex-wrap gap-2">
                <span class="inline-flex items-center px-2 py-0.5 rounded-full text-xs font-medium bg-brand text-content-alt">
                  Primary
                </span>
                <span class="inline-flex items-center px-2 py-0.5 rounded-full text-xs font-medium border border-subcontent text-content">
                  Outline
                </span>
                <span class="inline-flex items-center px-2 py-0.5 rounded-full text-xs font-medium bg-success text-content-alt">
                  Success
                </span>
                <span class="inline-flex items-center px-2 py-0.5 rounded-full text-xs font-medium bg-warning text-content-alt">
                  Warning
                </span>
              </div>
              <div class="w-full h-2 rounded-full bg-primary-alt overflow-hidden">
                <div class="h-full w-[72%] bg-brand"></div>
              </div>
              <ol class="flex items-center gap-2 w-full">
                <li class="flex-1 text-center text-sm pb-2 border-b-2 border-brand text-brand">
                  Tokens
                </li>
                <li class="flex-1 text-center text-sm pb-2 border-b-2 border-brand text-brand">
                  Hooks
                </li>
                <li class="flex-1 text-center text-sm pb-2 border-b-2 border-primary-alt text-subcontent">
                  Route Scan
                </li>
              </ol>
              <ul class="rounded-lg bg-primary-alt p-2 flex flex-col">
                <li>
                  <a href="/sign-in" class="block px-3 py-2 rounded-md hover:bg-primary-alt">
                    Auth Flow
                  </a>
                </li>
                <li>
                  <a
                    href="/api/json/swaggerui"
                    class="block px-3 py-2 rounded-md hover:bg-primary-alt"
                  >
                    API Browser
                  </a>
                </li>
                <li>
                  <a href="/admin" class="block px-3 py-2 rounded-md hover:bg-primary-alt">
                    Admin Surface
                  </a>
                </li>
              </ul>
            </div>
          </div>
        </article>
      </section>

      <section
        id="layout-test-dependency-pages"
        class="flex flex-col rounded-lg border border-primary-alt bg-primary shadow-sm"
      >
        <div class="flex flex-col p-6 gap-6">
          <.header>
            Dependency Pages
            <:subtitle>
              Live pages and route surfaces supplied by installed dependencies.
            </:subtitle>
          </.header>

          <div class="grid grid-cols-[repeat(auto-fit,minmax(18rem,1fr))] gap-4">
            <article
              :for={page <- @dependency_pages}
              id={"dependency-page-#{page.id}"}
              class="rounded-lg border border-primary-alt bg-primary p-4"
            >
              <div class="space-y-4">
                <div class="space-y-2">
                  <div class="flex flex-wrap items-center gap-2">
                    <span class="inline-flex items-center px-2 py-0.5 rounded-full text-xs font-medium bg-primary-alt text-brand">
                      {page.source}
                    </span>
                    <span class="inline-flex items-center px-2 py-0.5 rounded-full text-xs font-medium bg-primary-alt text-content">
                      {page.availability}
                    </span>
                  </div>
                  <div class="space-y-1">
                    <h3 class="font-semibold">{page.name}</h3>
                    <p class="text-sm text-subcontent">{page.description}</p>
                    <p class="text-xs text-subcontent">{page.path}</p>
                  </div>
                </div>

                <.button
                  href={page.path}
                  class="px-3 py-1.5 text-sm bg-primary-alt text-brand hover:bg-brand hover:text-content-alt w-full"
                >
                  Open Page
                </.button>
              </div>
            </article>
          </div>
        </div>
      </section>
    </div>
  <% end %>
</Layouts.app>
