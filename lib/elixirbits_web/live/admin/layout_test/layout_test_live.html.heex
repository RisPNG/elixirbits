<Layouts.app
  flash={@flash}
  current_scope={@current_scope}
  user_timezone={@user_timezone}
  content_class="w-full space-y-6"
>
  <.card>
    <.header>
      Layout Test
      <:subtitle>
        Showcases local core components and dependency-powered frontend pieces.
      </:subtitle>
      <:actions>
        <div id="layout-test-palette-theme-controls">
          <Layouts.theme_toggle />
        </div>
      </:actions>
    </.header>

    <section
      id="layout-test-colors"
      aria-labelledby="layout-test-colors-title"
      class="space-y-3"
    >
      <div>
        <h2 id="layout-test-colors-title" class="text-base font-semibold">System colors</h2>
        <p class="text-sm text-subcontent">
          Main and muted text use fixed colors for each theme. Outlines adapt to each background. Dark and light layer over each surface.
        </p>
      </div>
      <ul aria-label="System color tokens" class="grid grid-cols-[1fr_1fr_1fr_1fr] gap-3">
        <li
          :for={
            {token, color_class} <- [
              {"primary", "bg-primary"},
              {"secondary", "bg-secondary"},
              {"content", "bg-content"},
              {"subcontent", "bg-subcontent"},
              {"brand", "bg-brand"},
              {"info", "bg-info"},
              {"success", "bg-success"},
              {"warning", "bg-warning"},
              {"error", "bg-error"},
              {"outline", "bg-transparent"},
              {"dark", "bg-transparent overlay-dark"},
              {"light", "bg-transparent overlay-light"}
            ]
          }
          id={"layout-test-color-#{token}"}
          data-color-token={"color-#{token}"}
          class="rounded-default border border-outline bg-secondary text-content p-3"
        >
          <div
            aria-hidden="true"
            class={[
              "mx-auto grid size-11 grid-rows-[1fr_1fr] place-items-center rounded-default border border-outline",
              color_class
            ]}
          >
            <span
              :if={token not in ["outline", "dark", "light"]}
              class={[
                "text-sm font-semibold",
                case token do
                  token when token in ["content", "subcontent"] -> "text-content-inverse"
                  "brand" -> "text-content-inverse dark:text-content"
                  _ -> "text-content"
                end
              ]}
            >Aa</span>
            <span
              :if={token not in ["outline", "dark", "light"]}
              class={[
                "text-xs",
                case token do
                  token when token in ["content", "subcontent"] -> "text-subcontent-inverse"
                  "brand" -> "text-subcontent-inverse dark:text-subcontent"
                  _ -> "text-subcontent"
                end
              ]}
            >Aa</span>
          </div>
          <code class="mt-2 block text-center text-xs text-content">color-{token}</code>
        </li>
      </ul>
    </section>

    <section
      id="layout-test-background-opacity"
      aria-labelledby="layout-test-background-opacity-title"
      class="space-y-3"
    >
      <div>
        <h2 id="layout-test-background-opacity-title" class="text-base font-semibold">
          Background opacity
        </h2>
        <p class="text-sm text-subcontent">
          Set the background alpha while text and icons stay opaque. The default is 25%. Nested layers add their alpha up to 100%. In light mode, brand backgrounds at 50% alpha or less use dark text and icons.
        </p>
      </div>
      <ul aria-label="Background opacity examples" class="grid grid-cols-[1fr_1fr_1fr_1fr] gap-3">
        <li
          :for={
            {alpha, opacity_class} <- [
              {10, "overlay-opacity-[0.1]"},
              {25, "overlay-opacity"},
              {50, "overlay-opacity-[0.5]"},
              {100, "overlay-opacity-[1]"}
            ]
          }
          class="rounded-default border border-outline bg-primary p-3"
        >
          <code class="block text-xs text-content">{opacity_class}</code>
          <div
            id={"layout-test-opacity-#{alpha}"}
            class={[
              "mt-2 grid grid-cols-[1.25rem_1fr] items-center gap-2 rounded-default border border-outline bg-brand p-3",
              if(alpha <= 50,
                do: "text-content",
                else: "text-content-inverse dark:text-content"
              ),
              opacity_class
            ]}
          >
            <.icon name="hero-sparkles" class="size-5" />
            <span class="text-sm font-medium">{alpha}% background alpha</span>
          </div>
        </li>
      </ul>
      <div
        id="layout-test-opacity-stack-25"
        class="rounded-default border border-outline bg-brand overlay-opacity p-3 text-content"
      >
        <p class="text-sm font-medium">25% background alpha</p>
        <div class="mt-3">
          <div
            id="layout-test-opacity-stack-50"
            class="rounded-default border border-outline overlay-opacity p-3"
          >
            <p class="text-sm font-medium">50% background alpha</p>
            <div
              id="layout-test-opacity-stack-75"
              class="mt-3 rounded-default border border-outline overlay-opacity p-3 text-content-inverse dark:text-content"
            >
              <p class="text-sm font-medium">75% background alpha</p>
              <div
                id="layout-test-opacity-stack-100"
                class="mt-3 rounded-default border border-outline overlay-opacity p-3"
              >
                <p class="text-sm font-medium">100% background alpha</p>
              </div>
            </div>
          </div>
        </div>
      </div>
    </section>

    <section
      id="layout-test-overlay-strength"
      aria-labelledby="layout-test-overlay-strength-title"
      class="space-y-3"
    >
      <div>
        <h2 id="layout-test-overlay-strength-title" class="text-base font-semibold">
          Overlay strength
        </h2>
        <p class="text-sm text-subcontent">
          Dark and light overlays default to 25% strength. Nested overlays of the same kind add their strength up to 100%. Light overlays on brand at 50% strength or more use dark text and icons in both modes.
        </p>
      </div>
      <div class="grid grid-cols-[1fr_1fr] gap-3">
        <div
          :for={
            {kind, title, default_class, content_class, strengths} <- [
              {"dark", "Dark overlay", "overlay-dark", "text-content-inverse dark:text-content",
               [
                 {10, "overlay-dark-[0.1]"},
                 {25, "overlay-dark"},
                 {50, "overlay-dark-[0.5]"},
                 {100, "overlay-dark-[1]"}
               ]},
              {"light", "Light overlay", "overlay-light",
               "text-content-inverse dark:text-content",
               [
                 {10, "overlay-light-[0.1]"},
                 {25, "overlay-light"},
                 {50, "overlay-light-[0.5]"},
                 {100, "overlay-light-[1]"}
               ]}
            ]
          }
          class="space-y-3 rounded-default border border-outline bg-primary p-3"
        >
          <h3 class="text-base font-semibold text-content">{title}</h3>
          <ul
            aria-label={"#{title} strength examples"}
            class="grid grid-cols-[1fr_1fr_1fr_1fr] gap-3"
          >
            <li :for={{strength, overlay_class} <- strengths}>
              <code class="block min-h-8 text-xs text-content">{overlay_class}</code>
              <div
                id={"layout-test-overlay-#{kind}-#{strength}"}
                class={[
                  "mt-2 grid grid-cols-[1.25rem_1fr] items-center gap-2 rounded-default border border-outline bg-brand p-3",
                  if(kind == "light" and strength >= 50,
                    do: "text-content dark:text-content-inverse",
                    else: content_class
                  ),
                  overlay_class
                ]}
              >
                <.icon name="hero-sparkles" class="size-5" />
                <span class="text-sm font-medium">{strength}% strength</span>
              </div>
            </li>
          </ul>
          <div
            id={"layout-test-overlay-#{kind}-stack-25"}
            class={[
              "rounded-default border border-outline bg-brand p-3",
              content_class,
              default_class
            ]}
          >
            <p class="text-sm font-medium">25% combined strength</p>
            <div class="mt-3">
              <div
                id={"layout-test-overlay-#{kind}-stack-50"}
                class={[
                  "rounded-default border border-outline p-3",
                  default_class,
                  kind == "light" && "text-content dark:text-content-inverse"
                ]}
              >
                <p class="text-sm font-medium">50% combined strength</p>
                <div
                  id={"layout-test-overlay-#{kind}-stack-75"}
                  class={[
                    "mt-3 rounded-default border border-outline p-3",
                    default_class
                  ]}
                >
                  <p class="text-sm font-medium">75% combined strength</p>
                  <div
                    id={"layout-test-overlay-#{kind}-stack-100"}
                    class={[
                      "mt-3 rounded-default border border-outline p-3",
                      default_class
                    ]}
                  >
                    <p class="text-sm font-medium">100% combined strength</p>
                  </div>
                </div>
              </div>
            </div>
          </div>
        </div>
      </div>
    </section>

    <div
      id="layout-test-tabs"
      role="tablist"
      aria-label="Layout test sections"
      class="grid grid-cols-[max-content_max-content] items-center gap-2"
    >
      <.button
        id="layout-test-local-tab"
        type="button"
        role="tab"
        aria-selected={if(@current_tab == "local", do: "true", else: "false")}
        variant={if @current_tab == "local", do: :primary, else: :neutral}
        phx-click="change_tab"
        phx-value-tab="local"
      >
        Local
      </.button>

      <.button
        id="layout-test-ecosystem-tab"
        type="button"
        role="tab"
        aria-selected={if(@current_tab == "ecosystem", do: "true", else: "false")}
        variant={if @current_tab == "ecosystem", do: :primary, else: :neutral}
        phx-click="change_tab"
        phx-value-tab="ecosystem"
      >
        Ecosystem
      </.button>
    </div>
  </.card>

  <div
    id="layout-test-local-panel"
    role="tabpanel"
    aria-hidden={to_string(@current_tab != "local")}
    class={["space-y-6", @current_tab != "local" && "hidden"]}
  >
    <section class="grid grid-cols-[1fr_1fr] gap-4">
      <.card id="layout-test-header-card">
        <.header>
          Core Header and Button<:subtitle>
            Choose a button style and combine the header options.
          </:subtitle>
        </.header>
        <div class="space-y-3">
          <details phx-mounted={JS.ignore_attributes("open")}>
            <summary class="hover:overlay-dark min-h-11 content-center cursor-pointer rounded-default border border-outline bg-secondary px-3 py-2 text-sm font-medium text-content">
              Button style: {@showcase["header"]["variant"]}
            </summary>
            <div class="mt-2 grid grid-cols-[1fr_1fr_1fr_1fr] gap-2">
              <.button
                :for={variant <- ~w(unstyled neutral primary danger)}
                type="button"
                variant={
                  if @showcase["header"]["variant"] == variant, do: :primary, else: :neutral
                }
                aria-pressed={to_string(@showcase["header"]["variant"] == variant)}
                phx-click="set_showcase_option"
                phx-value-section="header"
                phx-value-option="variant"
                phx-value-choice={variant}
              >{Phoenix.Naming.humanize(variant)}</.button>
            </div>
          </details>
          <div class="grid grid-cols-[1fr_1fr_1fr] gap-2">
            <.button
              :for={
                {option, label} <- [
                  {"subtitle", "Subtitle"},
                  {"actions", "Action slot"},
                  {"disabled", "Disabled"},
                  {"tooltip", "Tooltip"},
                  {"navigation", "Navigation link"}
                ]
              }
              type="button"
              variant={if @showcase["header"][option], do: :primary, else: :neutral}
              aria-pressed={to_string(@showcase["header"][option])}
              phx-click="toggle_showcase_option"
              phx-value-section="header"
              phx-value-option={option}
            >{label}</.button>
          </div>
          <.card_inset id="layout-test-header-preview">
            <.header>
              Example title
              <:subtitle :if={@showcase["header"]["subtitle"]}>
                An example subtitle below the title.
              </:subtitle>
              <:actions :if={@showcase["header"]["actions"]}>
                <.button
                  id="layout-test-inline-action"
                  type="button"
                  variant={
                    if @showcase["header"]["variant"] == "unstyled",
                      do: nil,
                      else: String.to_existing_atom(@showcase["header"]["variant"])
                  }
                  disabled={@showcase["header"]["disabled"]}
                  tooltip={if @showcase["header"]["tooltip"], do: "Try this example action"}
                  navigate={if @showcase["header"]["navigation"], do: ~p"/"}
                  phx-click={if not @showcase["header"]["navigation"], do: "show_flash"}
                  phx-value-kind="info"
                >{if @showcase["header"]["navigation"], do: "Home", else: "Action"}</.button>
              </:actions>
            </.header>
          </.card_inset>
        </div>
      </.card>

      <.card id="layout-test-flash-card">
        <.header>
          Flashes<:subtitle>
            Configure one flash, then trigger it in the shared toast area.
          </:subtitle>
        </.header>
        <div class="space-y-3">
          <div class="grid grid-cols-[1fr_1fr_1fr] gap-2">
            <.button
              :for={kind <- ~w(info error warning)}
              id={"layout-test-flash-kind-#{kind}"}
              type="button"
              variant={if @showcase["flash"]["kind"] == kind, do: :primary, else: :neutral}
              aria-pressed={to_string(@showcase["flash"]["kind"] == kind)}
              phx-click="set_showcase_option"
              phx-value-section="flash"
              phx-value-option="kind"
              phx-value-choice={kind}
            >{Phoenix.Naming.humanize(kind)}</.button>
          </div>
          <div class="grid grid-cols-[1fr_1fr_1fr] gap-2">
            <.button
              :for={
                {option, label} <- [
                  {"title", "Custom title"},
                  {"icon", "Custom icon"},
                  {"spinner", "Spinner"}
                ]
              }
              type="button"
              variant={if @showcase["flash"][option], do: :primary, else: :neutral}
              aria-pressed={to_string(@showcase["flash"][option])}
              phx-click="toggle_showcase_option"
              phx-value-section="flash"
              phx-value-option={option}
            >{label}</.button>
          </div>
          <details phx-mounted={JS.ignore_attributes("open")}>
            <summary class="hover:overlay-dark min-h-11 content-center cursor-pointer rounded-default border border-outline bg-secondary px-3 py-2 text-sm font-medium text-content">
              Duration: {@showcase["flash"]["duration"]}{if @showcase["flash"]["duration"] !=
                                                              "default",
                                                            do: "ms"}
            </summary>
            <div class="mt-2 grid grid-cols-[1fr_1fr_1fr_1fr] gap-2">
              <.button
                :for={duration <- ~w(default 1000 5000 8000)}
                type="button"
                variant={
                  if @showcase["flash"]["duration"] == duration, do: :primary, else: :neutral
                }
                aria-pressed={to_string(@showcase["flash"]["duration"] == duration)}
                phx-click="set_showcase_option"
                phx-value-section="flash"
                phx-value-option="duration"
                phx-value-choice={duration}
              >{duration}</.button>
            </div>
          </details>
          <.button
            id="layout-test-flash-show"
            type="button"
            variant={:primary}
            phx-click="preview_flash"
          >Show {Phoenix.Naming.humanize(@showcase["flash"]["kind"])} Flash</.button>
        </div>
      </.card>
    </section>

    <.card id="layout-test-theme-card">
      <.header>
        Theme Toggle<:subtitle>
          Switch the shared site theme and watch the same preview change.
        </:subtitle>
      </.header>
      <div class="grid grid-cols-[max-content_max-content] items-center gap-3 mb-4">
        <Layouts.theme_toggle />
        <.button
          type="button"
          variant={if @showcase["theme"]["inset"], do: :primary, else: :neutral}
          aria-pressed={to_string(@showcase["theme"]["inset"])}
          phx-click="toggle_showcase_option"
          phx-value-section="theme"
          phx-value-option="inset"
        >Inset card</.button>
      </div>
      <div
        id="layout-test-theme-preview"
        class={[
          "rounded-default p-4 text-content",
          @showcase["theme"]["inset"] && "border border-outline bg-secondary"
        ]}
      >
        <p class="font-medium">Shared theme preview</p>
        <p class="text-sm text-subcontent">
          The page, controls, and cards use the same light and dark theme.
        </p>
      </div>
    </.card>

    <.card id="layout-test-form-section">
      <% checked_state =
        case Enum.map([:enabled, :switch], fn field ->
               Phoenix.HTML.Form.normalize_value("checkbox", @local_form[field].value)
             end) do
          [true, true] -> "true"
          [false, false] -> "false"
          _ -> "mixed"
        end %>
      <.header>
        Core Inputs
        <:subtitle>
          One example of each input type. Use the controls to combine display modes, variants, and input attributes.
        </:subtitle>
      </.header>

      <div id="layout-test-input-controls" class="space-y-3">
        <details phx-mounted={JS.ignore_attributes("open")}>
          <summary class="hover:overlay-dark min-h-11 content-center cursor-pointer rounded-default border border-outline bg-secondary px-3 py-2 text-sm font-medium text-content">
            Input options: {@input_config["render_as"]} display, {@input_config["variant"]} controls, {@input_config[
              "select_mode"
            ]} select, and {case checked_state do
              "true" -> "checked"
              "false" -> "unchecked"
              "mixed" -> "mixed checked states"
            end}
          </summary>
          <fieldset class="mt-2 space-y-2">
            <legend class="text-sm font-medium text-content">Display mode</legend>
            <div class="grid grid-cols-[1fr_1fr_1fr_1fr_1fr] gap-2">
              <.button
                :for={mode <- @input_render_modes}
                id={"layout-test-input-render-#{mode}"}
                type="button"
                variant={if @input_config["render_as"] == mode, do: :primary, else: :neutral}
                aria-pressed={to_string(@input_config["render_as"] == mode)}
                phx-click="set_input_config"
                phx-value-option="render_as"
                phx-value-choice={mode}
              >{mode}</.button>
            </div>
          </fieldset>
          <div class="mt-3 grid grid-cols-[1fr_1fr_2fr] subgap-4">
            <fieldset class="space-y-2">
              <legend class="text-sm font-medium text-content">
                Checkbox and switch variant
              </legend>
              <div class="grid grid-cols-[1fr_1fr] gap-2">
                <.button
                  :for={variant <- ~w(default alt)}
                  id={"layout-test-input-variant-#{variant}"}
                  type="button"
                  variant={if @input_config["variant"] == variant, do: :primary, else: :neutral}
                  aria-pressed={to_string(@input_config["variant"] == variant)}
                  phx-click="set_input_config"
                  phx-value-option="variant"
                  phx-value-choice={variant}
                >{variant}</.button>
              </div>
            </fieldset>
            <fieldset class="space-y-2">
              <legend class="text-sm font-medium text-content">Checked state</legend>
              <div class="grid grid-cols-[1fr_1fr] gap-2">
                <.button
                  :for={{value, label} <- [{"false", "Unchecked"}, {"true", "Checked"}]}
                  id={"layout-test-input-checked-#{value}"}
                  type="button"
                  variant={if checked_state == value, do: :primary, else: :neutral}
                  aria-pressed={to_string(checked_state == value)}
                  phx-click="set_input_config"
                  phx-value-option="checked"
                  phx-value-choice={value}
                >{label}</.button>
              </div>
            </fieldset>
            <fieldset class="space-y-2">
              <legend class="text-sm font-medium text-content">Select mode</legend>
              <div class="grid grid-cols-[1fr_1fr_1fr] gap-2">
                <.button
                  :for={mode <- ~w(single tags quick_tags)}
                  id={"layout-test-input-select-mode-#{mode}"}
                  type="button"
                  variant={if @input_config["select_mode"] == mode, do: :primary, else: :neutral}
                  aria-pressed={to_string(@input_config["select_mode"] == mode)}
                  phx-click="set_input_config"
                  phx-value-option="select_mode"
                  phx-value-choice={mode}
                >{mode}</.button>
              </div>
            </fieldset>
          </div>
        </details>
        <div
          id="layout-test-input-states"
          class="grid grid-cols-[1fr_1fr_1fr_1fr_1fr_1fr] gap-2 border-y border-outline py-3"
        >
          <.button
            :for={
              {state, label} <- [
                {"empty", "Empty values"},
                {"unlabeled", "No labels"},
                {"placeholder", "Placeholders"},
                {"required", "Required"},
                {"errors", "Errors"},
                {"disabled", "Disabled"}
              ]
            }
            id={"layout-test-input-state-#{state}"}
            type="button"
            variant={if @input_states[state], do: :primary, else: :neutral}
            aria-pressed={to_string(@input_states[state])}
            phx-click="toggle_input_state"
            phx-value-state={state}
          >{label}</.button>
        </div>
        <details phx-mounted={JS.ignore_attributes("open")}>
          <summary class="hover:overlay-dark min-h-11 content-center cursor-pointer rounded-default border border-outline bg-secondary px-3 py-2 text-sm font-medium text-content">
            Input attributes
          </summary>
          <div class="mt-2 grid grid-cols-[1fr_1fr_1fr_1fr_1fr] gap-2">
            <.button
              :for={
                {state, label} <- [
                  {"readonly", "Read-only"},
                  {"tooltip", "Tooltips"},
                  {"constraints", "Constraints"},
                  {"datalist", "Datalist"},
                  {"multiple", "Multiple files"},
                  {"capture", "Camera capture"},
                  {"custom_class", "Custom class"},
                  {"custom_error_class", "Custom error class"},
                  {"prompt", "Select prompt"},
                  {"textarea_size", "Textarea size"}
                ]
              }
              id={"layout-test-input-state-#{state}"}
              type="button"
              variant={if @input_states[state], do: :primary, else: :neutral}
              aria-pressed={to_string(@input_states[state])}
              phx-click="toggle_input_state"
              phx-value-state={state}
            >{label}</.button>
          </div>
        </details>
      </div>

      <.form
        for={@local_form}
        id="layout-test-form"
        phx-change="local_change"
        phx-submit="local_save"
        class="space-y-4"
      >
        <div id="layout-test-input-examples" class="grid grid-cols-[1fr_1fr_1fr_1fr] subgap-4">
          <div
            :for={
              {field_name, type, label} <- [
                {:project_name, "text", "Text"},
                {:email, "email", "Email"},
                {:password, "password", "Password"},
                {:budget, "number", "Number"},
                {:launch_date, "date", "Date"},
                {:launch_time, "time", "Time"},
                {:launch_week, "week", "Week"},
                {:launch_month, "month", "Month"},
                {:launch_at, "datetime-local", "Datetime"},
                {:accent, "color", "Color"},
                {:search, "search", "Search"},
                {:website, "url", "URL"},
                {:phone, "tel", "Telephone"},
                {:role, "select", "Select"},
                {:notes, "textarea", "Textarea"},
                {:enabled, "checkbox", "Checkbox"},
                {:switch, "switch", "Switch"},
                {:upload, "file", "File"},
                {:contact_method, "radio", "Radio"},
                {:hidden_token, "hidden", "Hidden"}
              ]
            }
            id={"layout-test-input-example-#{type}"}
            data-input-type={type}
            data-input-mode={@input_config["render_as"]}
            data-input-variant={@input_config["variant"]}
            data-select-mode={@input_config["select_mode"]}
            class="space-y-2"
          >
            <% field = @local_form[field_name] %>
            <p
              :if={
                @input_states["unlabeled"] or type == "hidden" or
                  @input_config["render_as"] in ~w(hidden hidden-enabled hidden-disabled)
              }
              class="text-xs font-medium text-subcontent"
            >
              {label}
            </p>
            <.input
              field={
                if @input_states["errors"] do
                  %{
                    field
                    | errors: [{"Example validation error", []}],
                      form: %{
                        field.form
                        | params: Map.delete(field.form.params, "_unused_#{field.field}")
                      }
                  }
                else
                  field
                end
              }
              id={if type == "select", do: "layout-test-local-role", else: field.id}
              type={type}
              label={
                if @input_states["unlabeled"] or (type == "select" and @input_states["prompt"]),
                  do: nil,
                  else: label
              }
              value={field.value}
              mode={
                if type == "select",
                  do: String.to_existing_atom(@input_config["select_mode"]),
                  else: :single
              }
              options={
                case type do
                  "select" ->
                    [{"Administrator", "admin"}, {"Designer", "designer"}, {"Viewer", "viewer"}]

                  "radio" ->
                    [{"Email", "email"}, {"Telephone", "phone"}]

                  _ ->
                    []
                end
              }
              variant={@input_config["variant"]}
              render_as={@input_config["render_as"]}
              timezone={@user_timezone}
              placeholder={if @input_states["placeholder"], do: "Example #{label}"}
              prompt={if type == "select" and @input_states["prompt"], do: "Choose a role"}
              tooltip={
                if @input_states["tooltip"],
                  do: "#{label} input in #{@input_config["render_as"]} mode"
              }
              required={@input_states["required"]}
              disabled={@input_states["disabled"]}
              readonly={
                @input_states["readonly"] and
                  type in ~w(text email password number search url tel textarea)
              }
              min={if type == "number" and @input_states["constraints"], do: 0}
              max={if type == "number" and @input_states["constraints"], do: 100_000}
              step={if type == "number" and @input_states["constraints"], do: 5}
              minlength={
                if type in ~w(text email password search url tel textarea) and
                     @input_states["constraints"],
                   do: 3
              }
              maxlength={
                if type in ~w(text email password search url tel textarea) and
                     @input_states["constraints"],
                   do: 200
              }
              pattern={if type == "text" and @input_states["constraints"], do: "[^<>]+"}
              size={if type == "text" and @input_states["constraints"], do: 12}
              list={
                if type == "text" and @input_states["datalist"], do: "layout-test-input-cities"
              }
              multiple={type == "file" and @input_states["multiple"]}
              capture={if type == "file" and @input_states["capture"], do: "environment"}
              accept={
                cond do
                  type == "file" and @input_states["capture"] ->
                    "image/*"

                  type == "file" and (@input_states["multiple"] or @input_states["constraints"]) ->
                    "image/*,.pdf"

                  true ->
                    nil
                end
              }
              rows={if type == "textarea", do: if(@input_states["textarea_size"], do: 6, else: 4)}
              cols={if type == "textarea" and @input_states["textarea_size"], do: 60}
              class={
                if @input_states["custom_class"] and type not in ~w(checkbox switch radio hidden) do
                  [
                    "input-floating-control block w-full min-h-11 rounded-default border border-brand bg-transparent px-3 text-content disabled:overlay-dark disabled:text-subcontent disabled:cursor-not-allowed",
                    (@input_states["disabled"] or
                       @input_config["render_as"] in ~w(disabled like-disabled)) and
                      "overlay-dark text-subcontent cursor-not-allowed",
                    type == "textarea" and "input-floating-textarea",
                    type == "password" and "pr-12"
                  ]
                end
              }
              error_class={
                if @input_states["custom_error_class"], do: "border-error bg-transparent"
              }
              aria-label={"#{label}, #{@input_config["render_as"]}"}
            />
            <p
              :if={
                type == "hidden" or
                  @input_config["render_as"] in ~w(hidden hidden-enabled hidden-disabled)
              }
              class="text-xs text-subcontent"
            >
              <%= cond do %>
                <% @input_config["render_as"] == "hidden-disabled" -> %>
                  The control and its value are omitted.
                <% @input_config["render_as"] in ~w(hidden hidden-enabled) or (type == "hidden" and @input_config["render_as"] in ~w(enabled text text-enabled)) -> %>
                  The control is hidden and its value submits unless disabled.
                <% true -> %>
                  This hidden input is shown using the selected display mode.
              <% end %>
            </p>
          </div>
        </div>
        <datalist :if={@input_states["datalist"]} id="layout-test-input-cities">
          <option value="Ipoh" />
          <option value="Kuala Lumpur" />
          <option value="George Town" />
        </datalist>
        <.action_button action={:save} type="submit" />
      </.form>

      <p :if={@submitted_at} class="text-sm text-content">
        Last submitted datetime:
        <time id="submitted-at" datetime={DateTime.to_iso8601(@submitted_at)}>
          {Calendar.strftime(
            DateTime.shift_zone!(@submitted_at, @user_timezone),
            "%-d %b %Y, %H:%M %Z"
          )}
        </time>
        <span id="submitted-at-utc" class="block text-subcontent">Submitted UTC: {DateTime.to_iso8601(
          @submitted_at
        )}</span>
      </p>
    </.card>

    <.card id="layout-test-uploads">
      <.header>
        Live uploads
        <:subtitle>
          Choose one file, add files one at a time, or select up to three files together. Each file can be up to 1MB.
        </:subtitle>
      </.header>
      <div id="layout-test-upload-controls" class="space-y-3">
        <div class="grid grid-cols-[1fr_1fr] items-start subgap-3">
          <div>
            <details phx-mounted={JS.ignore_attributes("open")} id="upload-render-modes">
              <summary class="hover:overlay-dark min-h-11 content-center cursor-pointer rounded-default border border-outline bg-secondary px-3 py-2 text-sm font-medium text-content">
                Render as: {@upload_mode}
              </summary>
              <div class="mt-2 grid grid-cols-[1fr_1fr] gap-2">
                <.button
                  :for={mode <- @input_render_modes}
                  id={"upload-mode-#{mode}"}
                  type="button"
                  variant={if @upload_mode == mode, do: :primary, else: :neutral}
                  aria-pressed={to_string(@upload_mode == mode)}
                  phx-click="set_showcase_option"
                  phx-value-section="uploads"
                  phx-value-option="render_as"
                  phx-value-choice={mode}
                >
                  {mode}
                </.button>
              </div>
            </details>
          </div>
          <div>
            <details phx-mounted={JS.ignore_attributes("open")} id="upload-preview-styles">
              <summary class="hover:overlay-dark min-h-11 content-center cursor-pointer rounded-default border border-outline bg-secondary px-3 py-2 text-sm font-medium text-content">
                Preview layout: {@showcase["uploads"]["preview_as"]}
              </summary>
              <div class="mt-2 grid grid-cols-[1fr_1fr] gap-2">
                <.button
                  :for={style <- ["tag", "thumbnail"]}
                  id={"upload-preview-#{style}"}
                  type="button"
                  variant={
                    if @showcase["uploads"]["preview_as"] == style, do: :primary, else: :neutral
                  }
                  aria-pressed={to_string(@showcase["uploads"]["preview_as"] == style)}
                  disabled={!@showcase["uploads"]["preview"]}
                  phx-click="set_showcase_option"
                  phx-value-section="uploads"
                  phx-value-option="preview_as"
                  phx-value-choice={style}
                >
                  {Phoenix.Naming.humanize(style)}
                </.button>
              </div>
            </details>
          </div>
        </div>
        <div class="grid grid-cols-[1fr_1fr] items-start subgap-3">
          <section id="layout-test-upload-selection-controls" class="flex flex-col gap-3">
            <h3 class="font-medium text-content">File selection</h3>
            <div class="grid grid-cols-[1fr_1fr_2fr] gap-2">
              <.button
                :for={
                  {choice, label} <- [
                    {"single", "Single file"},
                    {"singles", "Singles"},
                    {"multiple", "Multiple files"}
                  ]
                }
                id={"upload-selection-#{choice}"}
                type="button"
                variant={
                  if @showcase["uploads"]["selection"] == choice, do: :primary, else: :neutral
                }
                aria-pressed={to_string(@showcase["uploads"]["selection"] == choice)}
                disabled={@uploads.demo_files.entries != []}
                phx-click="set_showcase_option"
                phx-value-section="uploads"
                phx-value-option="selection"
                phx-value-choice={choice}
              >{label}</.button>
            </div>
            <p class="text-sm text-subcontent">
              Save or cancel selected files before changing selection mode.
            </p>
          </section>
          <section id="layout-test-upload-editor-controls" class="flex flex-col gap-3">
            <h3 class="font-medium text-content">Image editor</h3>
            <div class="grid grid-cols-[1fr_1fr] gap-2">
              <.button
                :for={
                  {choice, label} <- [
                    {"false", "Editor off"},
                    {"true", "Free crop"},
                    {"exact", "512 × 512 pixels"},
                    {"ratio", "16:9 crop"}
                  ]
                }
                id={"upload-editor-#{choice}"}
                type="button"
                variant={
                  if @showcase["uploads"]["editor"] == choice, do: :primary, else: :neutral
                }
                aria-pressed={to_string(@showcase["uploads"]["editor"] == choice)}
                disabled={
                  @showcase["uploads"]["selection"] == "multiple" or
                    !@showcase["uploads"]["preview"]
                }
                phx-click="set_showcase_option"
                phx-value-section="uploads"
                phx-value-option="editor"
                phx-value-choice={choice}
              >{label}</.button>
            </div>
            <p class="text-sm text-subcontent">
              Editing requires Preview in Single file or Singles mode. Hover over an image to edit it again. PDFs use the browser's document viewer.
            </p>
          </section>
        </div>
        <div class="grid grid-cols-[repeat(7,max-content)] gap-2">
          <.button
            :for={
              {option, label} <- [
                {"labels", "Labels"},
                {"disabled", "Native disabled"},
                {"required", "Required"},
                {"tooltip", "Tooltips"},
                {"stored", "Stored files"},
                {"preview", "Preview"},
                {"errors", "Errors"}
              ]
            }
            id={"showcase-uploads-#{option}"}
            type="button"
            variant={if @showcase["uploads"][option], do: :primary, else: :neutral}
            aria-pressed={to_string(@showcase["uploads"][option])}
            phx-click="toggle_showcase_option"
            phx-value-section="uploads"
            phx-value-option={option}
          >
            {label}
          </.button>
        </div>
      </div>
      <div class={[
        "grid items-start",
        if(@showcase["uploads"]["selection"] == "multiple",
          do: "grid-cols-[1fr]",
          else: "grid-cols-[1fr_1fr] subgap-4"
        )
      ]}>
        <.form
          for={@upload_form}
          id="layout-test-upload-form"
          phx-change="upload_change"
          phx-submit="upload_save"
          class="flex flex-col gap-4"
        >
          <div id="layout-test-upload-input">
            <.input
              type="file"
              name="files"
              label={if @showcase["uploads"]["labels"], do: "Files"}
              upload={@uploads.demo_files}
              selection={@showcase["uploads"]["selection"]}
              preview_id={
                if @showcase["uploads"]["selection"] != "multiple",
                  do: "layout-test-upload-preview"
              }
              thumbnail_class={
                if @showcase["uploads"]["selection"] != "multiple",
                  do: "h-full w-full",
                  else: "h-36 w-full"
              }
              stored={
                cond do
                  !@showcase["uploads"]["stored"] -> []
                  @showcase["uploads"]["selection"] == "single" -> Enum.take(@stored_files, 1)
                  true -> @stored_files
                end
              }
              preview={@showcase["uploads"]["preview"]}
              editor={
                case @showcase["uploads"]["editor"] do
                  "true" -> true
                  "exact" -> %{width: 512, height: 512}
                  "ratio" -> %{ratio: 16 / 9}
                  _ -> false
                end
              }
              preview_as={
                if @showcase["uploads"]["preview"],
                  do: @showcase["uploads"]["preview_as"],
                  else: "tag"
              }
              render_as={@upload_mode}
              disabled={@showcase["uploads"]["disabled"]}
              required={@showcase["uploads"]["required"]}
              tooltip={
                if @showcase["uploads"]["tooltip"],
                  do: "Choose PNG, JPEG, GIF, WebP, PDF, or text files"
              }
              errors={
                if @showcase["uploads"]["errors"], do: ["Choose a supported file."], else: []
              }
              aria-label="Upload files"
            >
              <:preview_caption :let={url}>
                <span class="truncate">
                  {Map.get(@preview_names, url, Path.basename(url))}
                </span>
              </:preview_caption>
              <:pending_caption :let={entry}>
                <span class="truncate">{entry.client_name}</span>
              </:pending_caption>
            </.input>
          </div>
          <.button
            :if={@upload_mode == "enabled"}
            type="submit"
            variant={:primary}
            disabled={@showcase["uploads"]["disabled"]}
          >Save files</.button>
        </.form>
        <div :if={@showcase["uploads"]["selection"] != "multiple"}>
          <.file_preview
            id="layout-test-upload-preview"
            class={
              if @showcase["uploads"]["preview_as"] == "thumbnail",
                do: "h-44 w-full",
                else: "w-full"
            }
          />
        </div>
      </div>
      <p :if={@uploaded_names != []} id="uploaded-names" class="text-sm text-content">
        {Enum.join(@uploaded_names, ", ")}
      </p>
    </.card>

    <.card id="layout-test-actions">
      <.header>
        Record actions
        <:subtitle>
          Add, edit, save, send, archive, and delete sample entries for this session.
        </:subtitle>
      </.header>
      <div id="layout-test-action-controls" class="space-y-3">
        <div class="grid grid-cols-[1fr_1fr_1fr_1fr] items-start subgap-3">
          <div :for={
            {option, label, value, choices} <- [
              {"selected", "Action", @showcase["actions"]["selected"],
               Enum.map(~w(create read update save send archive delete back), fn action ->
                 {Phoenix.Naming.humanize(action), action}
               end)},
              {"render_as", "Render as", @record_mode,
               Enum.map(@input_render_modes, fn mode -> {mode, mode} end)},
              {"columns", "Columns", to_string(@record_columns), [{"One", "1"}, {"Two", "2"}]},
              {"count", "Entries", @showcase["actions"]["count"],
               [{"One", "1"}, {"Two", "2"}, {"Four", "4"}]}
            ]
          }>
            <details phx-mounted={JS.ignore_attributes("open")} id={"record-options-#{option}"}>
              <summary class="hover:overlay-dark min-h-11 content-center cursor-pointer rounded-default border border-outline bg-secondary px-3 py-2 text-sm font-medium text-content">
                {label}: {value}
              </summary>
              <div class="mt-2 grid grid-cols-[1fr_1fr] gap-2">
                <.button
                  :for={{choice_label, choice} <- choices}
                  id={"record-option-#{option}-#{choice}"}
                  type="button"
                  variant={if value == choice, do: :primary, else: :neutral}
                  aria-pressed={to_string(value == choice)}
                  phx-click="set_showcase_option"
                  phx-value-section="actions"
                  phx-value-option={option}
                  phx-value-choice={choice}
                >
                  {choice_label}
                </.button>
              </div>
            </details>
          </div>
        </div>
        <div class="grid grid-cols-[1fr_max-content_max-content_max-content] items-start gap-2">
          <details phx-mounted={JS.ignore_attributes("open")} id="record-selected-entry">
            <summary class="hover:overlay-dark min-h-11 content-center cursor-pointer rounded-default border border-outline bg-secondary px-3 py-2 text-sm font-medium text-content">
              Selected entry: {if @record_selected, do: "##{@record_selected}", else: "None"}
            </summary>
            <div class="mt-2 grid grid-cols-[1fr_1fr] gap-2">
              <.button
                :for={entry <- @record_entries}
                id={"record-select-#{entry["id"]}"}
                type="button"
                variant={if @record_selected == entry["id"], do: :primary, else: :neutral}
                aria-pressed={to_string(@record_selected == entry["id"])}
                phx-click="record_action"
                phx-value-action="read"
                phx-value-id={entry["id"]}
              >
                #{entry["id"]}: {entry["name"]}
              </.button>
            </div>
          </details>
          <.button
            :for={
              {option, label} <- [
                {"disabled", "Disabled"},
                {"custom_icon", "Custom icon"},
                {"tooltip", "Tooltip"}
              ]
            }
            id={"showcase-actions-#{option}"}
            type="button"
            variant={if @showcase["actions"][option], do: :primary, else: :neutral}
            aria-pressed={to_string(@showcase["actions"][option])}
            phx-click="toggle_showcase_option"
            phx-value-section="actions"
            phx-value-option={option}
          >
            {label}
          </.button>
        </div>
      </div>
      <div class="grid grid-cols-[2.75rem_1fr] items-center gap-3">
        <.action_button
          id={"record-action-#{@showcase["actions"]["selected"]}"}
          action={String.to_existing_atom(@showcase["actions"]["selected"])}
          icon={if @showcase["actions"]["custom_icon"], do: "tabler-calendar-plus"}
          tooltip={if @showcase["actions"]["tooltip"], do: nil, else: ""}
          aria-label={Phoenix.Naming.humanize(@showcase["actions"]["selected"])}
          phx-click="record_action"
          phx-value-action={@showcase["actions"]["selected"]}
          disabled={
            @showcase["actions"]["disabled"] or
              (@showcase["actions"]["selected"] in ~w(read update send archive delete) and
                 is_nil(@record_selected))
          }
        />
        <p id="record-action-status" role="status" class="text-sm text-content">
          {@record_message}
        </p>
      </div>
      <% record_count = String.to_integer(@showcase["actions"]["count"]) %>
      <% visible_entries = Enum.take(@record_entries, record_count) %>
      <% selected_entry =
        Enum.find(@record_entries, fn entry -> entry["id"] == @record_selected end) %>
      <% visible_entries =
        if selected_entry &&
             not Enum.any?(visible_entries, fn entry -> entry["id"] == @record_selected end) do
          Enum.take(visible_entries, record_count - 1) ++ [selected_entry]
        else
          visible_entries
        end %>
      <.form
        for={@record_form}
        id="layout-test-record-form"
        phx-change="record_change"
        phx-submit="record_action"
      >
        <.input type="hidden" name="action" value="save" />
        <div
          id="record-entry-panels"
          class={[
            @record_columns == 2 && "grid grid-cols-[1fr_1fr] gap-y-4",
            @record_columns == 1 && "flex flex-col gap-4"
          ]}
        >
          <.entry_panel
            :for={{entry, index} <- Enum.with_index(visible_entries)}
            label="Sample entry"
            index={index}
            columns={@record_columns}
          >
            <:actions>
              <.action_button
                id={"record-delete-#{entry["id"]}"}
                action={:delete}
                tooltip={"Delete #{entry["name"]}"}
                phx-click="record_action"
                phx-value-action="delete"
                phx-value-id={entry["id"]}
              />
            </:actions>
            <div
              id={"record-entry-#{entry["id"]}"}
              data-status={entry["status"]}
              class="space-y-4"
            >
              <div class="grid grid-cols-[1fr_2fr_1fr] subgap-4">
                <.input
                  id={"record-code-#{entry["id"]}"}
                  name={"records[#{entry["id"]}][code]"}
                  label="Code"
                  value={entry["code"]}
                  render_as={@record_mode}
                />
                <.input
                  id={"record-name-#{entry["id"]}"}
                  name={"records[#{entry["id"]}][name]"}
                  label="Name"
                  value={entry["name"]}
                  render_as={@record_mode}
                />
                <.input
                  id={"record-quantity-#{entry["id"]}"}
                  name={"records[#{entry["id"]}][quantity]"}
                  type="number"
                  label="Quantity"
                  value={entry["quantity"]}
                  render_as={@record_mode}
                  min="1"
                />
              </div>
              <.input
                id={"record-notes-#{entry["id"]}"}
                name={"records[#{entry["id"]}][notes]"}
                type="textarea"
                label="Notes"
                value={entry["notes"]}
                render_as={@record_mode}
                rows="2"
              />
              <div class="grid grid-cols-[1fr_max-content] items-center gap-3">
                <span class="text-sm text-subcontent">{entry["status"]}{if entry["id"] ==
                                                                             @record_selected,
                                                                           do: " · Selected"}</span>
                <.action_button
                  id={"record-read-#{entry["id"]}"}
                  action={:read}
                  tooltip={"View #{entry["name"]}"}
                  phx-click="record_action"
                  phx-value-action="read"
                  phx-value-id={entry["id"]}
                />
              </div>
            </div>
          </.entry_panel>
        </div>
        <p :if={@record_entries == []} id="record-empty" class="text-sm text-subcontent">
          No entries. Use Add new to create one, or Back to restore the saved entries.
        </p>
      </.form>
    </.card>

    <.card id="layout-test-calendar">
      <.header>
        Calendar and timers<:subtitle>
          Change the calendar view with its own toolbar, then compare event styles and timer modes.
        </:subtitle>
      </.header>
      <div class="space-y-3 mb-4">
        <div class="grid grid-cols-[max-content_max-content_max-content] items-start gap-2">
          <.button
            type="button"
            variant={if @showcase["calendar"]["events"], do: :primary, else: :neutral}
            aria-pressed={to_string(@showcase["calendar"]["events"])}
            phx-click="toggle_showcase_option"
            phx-value-section="calendar"
            phx-value-option="events"
          >Events</.button>
          <details phx-mounted={JS.ignore_attributes("open")}>
            <summary class="hover:overlay-dark min-h-11 content-center cursor-pointer rounded-default border border-outline bg-secondary px-3 py-2 text-sm font-medium text-content">
              Event style: {@showcase["calendar"]["variant"]}
            </summary>
            <div class="mt-2 grid grid-cols-[1fr_1fr] gap-2">
              <.button
                :for={variant <- ~w(solid outline)}
                type="button"
                variant={
                  if @showcase["calendar"]["variant"] == variant, do: :primary, else: :neutral
                }
                aria-pressed={to_string(@showcase["calendar"]["variant"] == variant)}
                phx-click="set_showcase_option"
                phx-value-section="calendar"
                phx-value-option="variant"
                phx-value-choice={variant}
              >{Phoenix.Naming.humanize(variant)}</.button>
            </div>
          </details>
          <details phx-mounted={JS.ignore_attributes("open")}>
            <summary class="hover:overlay-dark min-h-11 content-center cursor-pointer rounded-default border border-outline bg-secondary px-3 py-2 text-sm font-medium text-content">
              Event color: {@showcase["calendar"]["color"]}
            </summary>
            <div class="mt-2 grid grid-cols-[1fr_1fr_1fr] gap-2">
              <.button
                :for={color <- ~w(brand info success warning error neutral)}
                type="button"
                variant={if @showcase["calendar"]["color"] == color, do: :primary, else: :neutral}
                aria-pressed={to_string(@showcase["calendar"]["color"] == color)}
                phx-click="set_showcase_option"
                phx-value-section="calendar"
                phx-value-option="color"
                phx-value-choice={color}
              >{Phoenix.Naming.humanize(color)}</.button>
            </div>
          </details>
        </div>
        <div class="grid grid-cols-[max-content_max-content_max-content_1fr] items-center gap-2">
          <.button
            :for={mode <- ~w(elapsed countdown)}
            id={"timer-mode-#{mode}"}
            type="button"
            variant={if @showcase["calendar"]["timer"] == mode, do: :primary, else: :neutral}
            aria-pressed={to_string(@showcase["calendar"]["timer"] == mode)}
            phx-click="set_showcase_option"
            phx-value-section="calendar"
            phx-value-option="timer"
            phx-value-choice={mode}
          >{Phoenix.Naming.humanize(mode)}</.button>
          <.button id="timer-reset" type="button" variant={:neutral} phx-click="reset_timer">Restart timer</.button>
          <p class="text-sm text-content">
            {Phoenix.Naming.humanize(@showcase["calendar"]["timer"])}:
            <span
              id={"demo-#{@showcase["calendar"]["timer"]}-timer"}
              phx-hook="LiveTimer"
              data-mode={@showcase["calendar"]["timer"]}
              data-target={
                DateTime.to_iso8601(
                  if @showcase["calendar"]["timer"] == "elapsed",
                    do: @timer_start,
                    else: @timer_finish
                )
              }
            >{if @showcase["calendar"]["timer"] == "elapsed", do: "0:00", else: "in 1:00"}</span>
          </p>
        </div>
      </div>
      <ElixirbitsWeb.CalendarComponents.calendar
        id="calendar-showcase"
        events={
          if @showcase["calendar"]["events"],
            do:
              Enum.map(@calendar_events, fn event ->
                Map.merge(event, %{
                  variant: String.to_existing_atom(@showcase["calendar"]["variant"]),
                  color: String.to_existing_atom(@showcase["calendar"]["color"])
                })
              end),
            else: []
        }
        resources={@calendar_resources}
        timezone={@user_timezone}
        view={@calendar_view}
        cursor={@calendar_cursor}
        active_event={@calendar_selected}
      />
      <p :if={@calendar_selected} id="calendar-selection" class="text-sm text-content">
        Selected event: {@calendar_selected}
      </p>
    </.card>

    <section class="grid grid-cols-[1fr_1fr] gap-4">
      <section id="layout-test-table-card" class="space-y-4 pt-6">
        <.header>
          Core Table<:subtitle>Compare row interaction, action slots, and empty data.</:subtitle>
        </.header>
        <div class="grid grid-cols-[1fr_1fr] gap-2">
          <.button
            :for={
              {option, label} <- [
                {"empty", "Empty rows"},
                {"actions", "Action slot"},
                {"clickable", "Clickable rows"},
                {"status", "Status column"}
              ]
            }
            id={"table-option-#{option}"}
            type="button"
            variant={if @showcase["table"][option], do: :primary, else: :neutral}
            aria-pressed={to_string(@showcase["table"][option])}
            phx-click="toggle_showcase_option"
            phx-value-section="table"
            phx-value-option={option}
          >{label}</.button>
        </div>
        <.table
          id="layout-test-core-table"
          rows={
            if @showcase["table"]["empty"],
              do: [],
              else: [
                %{section: "Header", scope: "Page framing", status: "Ready"},
                %{section: "Inputs", scope: "Form states", status: "Ready"},
                %{section: "Dependencies", scope: "LiveSelect + pages", status: "Ready"}
              ]
          }
          row_click={
            if @showcase["table"]["clickable"],
              do: fn row -> JS.push("inspect_table_row", value: %{section: row.section}) end
          }
        >
          <:col :let={row} label="Section">{row.section}</:col>
          <:col :let={row} label="Scope">{row.scope}</:col>
          <:col :let={row} :if={@showcase["table"]["status"]} label="Status">
            <span class="status-pill bg-success text-content">{row.status}</span>
          </:col>
          <:action :let={row} :if={@showcase["table"]["actions"]}>
            <.button
              type="button"
              variant={:neutral}
              phx-click="inspect_table_row"
              phx-value-section={row.section}
            >Inspect</.button>
          </:action>
        </.table>
        <p :if={@table_selection} id="table-selection" role="status" class="text-sm text-content">
          Selected row: {@table_selection}
        </p>
      </section>
      <.card id="layout-test-list-card">
        <.header>
          Core List<:subtitle>
            Change the number of details and their title presentation.
          </:subtitle>
        </.header>
        <div class="grid grid-cols-[max-content_max-content] items-start gap-2 mb-4">
          <.button
            id="list-option-titles"
            type="button"
            variant={if @showcase["list"]["titles"], do: :primary, else: :neutral}
            aria-pressed={to_string(@showcase["list"]["titles"])}
            phx-click="toggle_showcase_option"
            phx-value-section="list"
            phx-value-option="titles"
          >Titles</.button>
          <details phx-mounted={JS.ignore_attributes("open")}>
            <summary class="hover:overlay-dark min-h-11 content-center cursor-pointer rounded-default border border-outline bg-secondary px-3 py-2 text-sm font-medium text-content">
              Items: {@showcase["list"]["count"]}
            </summary>
            <div class="mt-2 grid grid-cols-[1fr_1fr_1fr] gap-2">
              <.button
                :for={count <- ~w(1 2 4)}
                id={"list-count-#{count}"}
                type="button"
                variant={if @showcase["list"]["count"] == count, do: :primary, else: :neutral}
                aria-pressed={to_string(@showcase["list"]["count"] == count)}
                phx-click="set_showcase_option"
                phx-value-section="list"
                phx-value-option="count"
                phx-value-choice={count}
              >{count}</.button>
            </div>
          </details>
        </div>
        <div id="layout-test-list-preview">
          <.list>
            <:item
              :for={
                {title, value} <-
                  Enum.take(
                    [
                      {"Surface", "Local core components"},
                      {"Theme", "Shared dark and light tokens"},
                      {"Flash", "Global toast stack"},
                      {"Tabs", "Single LiveView state"}
                    ],
                    String.to_integer(@showcase["list"]["count"])
                  )
              }
              title={if @showcase["list"]["titles"], do: title, else: ""}
            >
              {value}
            </:item>
          </.list>
        </div>
      </.card>
    </section>

    <.card id="layout-test-icons-card">
      <.header>
        Core Icons<:subtitle>Choose an icon, its size, and a shared theme color.</:subtitle>
      </.header>
      <div class="grid grid-cols-[max-content_max-content_max-content_max-content] items-start gap-3 mb-4">
        <details phx-mounted={JS.ignore_attributes("open")}>
          <summary class="hover:overlay-dark min-h-11 content-center cursor-pointer rounded-default border border-outline bg-secondary px-3 py-2 text-sm font-medium text-content">
            Icon: {@showcase["icons"]["name"]}
          </summary>
          <div class="mt-2 grid grid-cols-[1fr_1fr] gap-2">
            <.button
              :for={
                name <-
                  ~w(hero-sparkles hero-bolt hero-cog-6-tooth hero-command-line hero-server-stack tabler-device-floppy)
              }
              id={"icon-name-#{name}"}
              type="button"
              variant={if @showcase["icons"]["name"] == name, do: :primary, else: :neutral}
              aria-pressed={to_string(@showcase["icons"]["name"] == name)}
              phx-click="set_showcase_option"
              phx-value-section="icons"
              phx-value-option="name"
              phx-value-choice={name}
            >{name}</.button>
          </div>
        </details>
        <details phx-mounted={JS.ignore_attributes("open")}>
          <summary class="hover:overlay-dark min-h-11 content-center cursor-pointer rounded-default border border-outline bg-secondary px-3 py-2 text-sm font-medium text-content">
            Size: {@showcase["icons"]["size"]}
          </summary>
          <div class="mt-2 grid grid-cols-[1fr_1fr_1fr_1fr] gap-2">
            <.button
              :for={size <- ~w(4 5 8 12)}
              id={"icon-size-#{size}"}
              type="button"
              variant={if @showcase["icons"]["size"] == size, do: :primary, else: :neutral}
              aria-pressed={to_string(@showcase["icons"]["size"] == size)}
              phx-click="set_showcase_option"
              phx-value-section="icons"
              phx-value-option="size"
              phx-value-choice={size}
            >{size}</.button>
          </div>
        </details>
        <details phx-mounted={JS.ignore_attributes("open")}>
          <summary class="hover:overlay-dark min-h-11 content-center cursor-pointer rounded-default border border-outline bg-secondary px-3 py-2 text-sm font-medium text-content">
            Color: {@showcase["icons"]["color"]}
          </summary>
          <div class="mt-2 grid grid-cols-[1fr_1fr_1fr] gap-2">
            <.button
              :for={color <- ~w(content brand info success warning error)}
              id={"icon-color-#{color}"}
              type="button"
              variant={if @showcase["icons"]["color"] == color, do: :primary, else: :neutral}
              aria-pressed={to_string(@showcase["icons"]["color"] == color)}
              phx-click="set_showcase_option"
              phx-value-section="icons"
              phx-value-option="color"
              phx-value-choice={color}
            >{Phoenix.Naming.humanize(color)}</.button>
          </div>
        </details>
        <.button
          id="icon-option-label"
          type="button"
          variant={if @showcase["icons"]["label"], do: :primary, else: :neutral}
          aria-pressed={to_string(@showcase["icons"]["label"])}
          phx-click="toggle_showcase_option"
          phx-value-section="icons"
          phx-value-option="label"
        >Label</.button>
      </div>
      <.card_inset id="layout-test-icon-preview">
        <div class="grid grid-cols-[max-content_1fr] items-center gap-3">
          <.icon
            name={@showcase["icons"]["name"]}
            class={[
              case @showcase["icons"]["size"] do
                "4" -> "size-4"
                "5" -> "size-5"
                "8" -> "size-8"
                "12" -> "size-12"
              end,
              case @showcase["icons"]["color"] do
                "content" -> "text-content"
                "brand" -> "text-brand"
                "info" -> "text-info"
                "success" -> "text-success"
                "warning" -> "text-warning"
                "error" -> "text-error"
              end
            ]}
          />
          <span :if={@showcase["icons"]["label"]} class="text-sm font-medium">{@showcase["icons"][
            "name"
          ]}</span>
        </div>
      </.card_inset>
    </.card>

    <.card id="layout-test-dialog-card">
      <.header>
        Dialog<:subtitle>
          Configure the title and action slots before opening the preview.
        </:subtitle>
      </.header>
      <div class="grid grid-cols-[max-content_max-content_max-content] gap-2">
        <.button
          :for={{option, label} <- [{"title", "Title"}, {"actions", "Actions"}]}
          id={"dialog-option-#{option}"}
          type="button"
          variant={if @showcase["dialog"][option], do: :primary, else: :neutral}
          aria-pressed={to_string(@showcase["dialog"][option])}
          phx-click="toggle_showcase_option"
          phx-value-section="dialog"
          phx-value-option={option}
        >{label}</.button>
        <.button
          id="layout-test-dialog-open"
          type="button"
          variant={:primary}
          phx-click="show_modal"
        >Open dialog</.button>
      </div>
    </.card>
  </div>

  <div
    id="layout-test-ecosystem-panel"
    role="tabpanel"
    aria-hidden={to_string(@current_tab != "ecosystem")}
    class={["space-y-6", @current_tab != "ecosystem" && "hidden"]}
  >
    <section id="layout-test-cinder-collection-card" class="space-y-4">
      <.header>
        Cinder collection
        <:subtitle>
          120 sample records. Choose a layout and adjust the collection controls.
        </:subtitle>
      </.header>
      <div id="layout-test-cinder-controls" class="space-y-3">
        <div class="grid grid-cols-[1fr_1fr_1fr] items-start subgap-4">
          <details
            phx-mounted={JS.ignore_attributes("open")}
            id="cinder-layout-choices"
          >
            <summary class="hover:overlay-dark min-h-11 content-center cursor-pointer rounded-default border border-outline bg-secondary px-3 py-2 text-sm font-medium text-content">
              Layout: {String.capitalize(@showcase["cinder"]["layout"])}
            </summary>
            <div class="mt-2 grid grid-cols-[1fr_1fr_1fr] gap-2">
              <.button
                :for={layout <- ~w(table list grid)}
                id={"cinder-layout-#{layout}"}
                type="button"
                variant={if @showcase["cinder"]["layout"] == layout, do: :primary, else: :neutral}
                aria-pressed={to_string(@showcase["cinder"]["layout"] == layout)}
                phx-click="set_showcase_option"
                phx-value-section="cinder"
                phx-value-option="layout"
                phx-value-choice={layout}
              >{String.capitalize(layout)}</.button>
            </div>
          </details>
          <details
            phx-mounted={JS.ignore_attributes("open")}
            id="cinder-page-size-choices"
          >
            <summary class="hover:overlay-dark min-h-11 content-center cursor-pointer rounded-default border border-outline bg-secondary px-3 py-2 text-sm font-medium text-content">
              Records per page: {@showcase["cinder"]["page_size"]}
            </summary>
            <div class="mt-2 grid grid-cols-[1fr_1fr_1fr] gap-2">
              <.button
                :for={size <- ~w(6 12 24)}
                id={"cinder-page-size-#{size}"}
                type="button"
                variant={
                  if @showcase["cinder"]["page_size"] == size, do: :primary, else: :neutral
                }
                aria-pressed={to_string(@showcase["cinder"]["page_size"] == size)}
                phx-click="set_showcase_option"
                phx-value-section="cinder"
                phx-value-option="page_size"
                phx-value-choice={size}
              >{size}</.button>
            </div>
          </details>
          <details
            phx-mounted={JS.ignore_attributes("open")}
            id="cinder-column-choices"
          >
            <summary class="hover:overlay-dark min-h-11 content-center cursor-pointer rounded-default border border-outline bg-secondary px-3 py-2 text-sm font-medium text-content">
              Grid columns: {@showcase["cinder"]["columns"]}
            </summary>
            <div class="mt-2 grid grid-cols-[1fr_1fr_1fr] gap-2">
              <.button
                :for={columns <- ~w(2 3 4)}
                id={"cinder-columns-#{columns}"}
                type="button"
                variant={
                  if @showcase["cinder"]["columns"] == columns, do: :primary, else: :neutral
                }
                aria-pressed={to_string(@showcase["cinder"]["columns"] == columns)}
                phx-click="set_showcase_option"
                phx-value-section="cinder"
                phx-value-option="columns"
                phx-value-choice={columns}
                disabled={@showcase["cinder"]["layout"] != "grid"}
              >{columns}</.button>
            </div>
          </details>
        </div>
        <div class="grid grid-cols-[1fr_1fr_1fr_1fr] gap-2">
          <.button
            :for={
              {option, label} <- [
                {"filters", "Column filters"},
                {"search", "Search"},
                {"sort", "Sorting"},
                {"pagination", "Pagination"}
              ]
            }
            id={"cinder-option-#{option}"}
            type="button"
            variant={if @showcase["cinder"][option], do: :primary, else: :neutral}
            aria-pressed={to_string(@showcase["cinder"][option])}
            phx-click="toggle_showcase_option"
            phx-value-section="cinder"
            phx-value-option={option}
          >{label}</.button>
        </div>
      </div>
      <div id="layout-test-cinder-collection" data-layout={@showcase["cinder"]["layout"]}>
        <Cinder.Collection.collection
          id={"layout-test-cinder-component-#{@showcase["cinder"]["layout"]}-#{@showcase["cinder"]["page_size"]}"}
          query={@showcase_query}
          actor={nil}
          url_state={%{filters: @cinder_preview_state}}
          on_state_change={:cinder_preview_state_change}
          layout={@showcase["cinder"]["layout"]}
          page_size={String.to_integer(@showcase["cinder"]["page_size"])}
          show_filters={@showcase["cinder"]["filters"] or @showcase["cinder"]["search"]}
          show_sort={@showcase["cinder"]["sort"]}
          show_pagination={@showcase["cinder"]["pagination"]}
          search={
            if @showcase["cinder"]["search"],
              do: [label: "Search examples", placeholder: "Code or name"],
              else: false
          }
          container_class={
            if @showcase["cinder"]["layout"] == "grid" do
              case @showcase["cinder"]["columns"] do
                "2" -> "grid grid-cols-[1fr_1fr] gap-4"
                "3" -> "grid grid-cols-[1fr_1fr_1fr] gap-4"
                "4" -> "grid grid-cols-[1fr_1fr_1fr_1fr] gap-4"
              end
            end
          }
          query_opts={[authorize?: false]}
        >
          <:col
            :let={entry}
            field="code"
            label="Code"
            sort={@showcase["cinder"]["sort"]}
            filter={@showcase["cinder"]["filters"]}
            search
          >
            {entry.code}
          </:col>
          <:col
            :let={entry}
            field="name"
            label="Name"
            sort={@showcase["cinder"]["sort"]}
            filter={@showcase["cinder"]["filters"]}
            search
          >
            {entry.name}
          </:col>
          <:col
            :let={entry}
            field="state"
            label="State"
            sort={@showcase["cinder"]["sort"]}
            filter={@showcase["cinder"]["filters"]}
          >
            {entry.state}
          </:col>
          <:col :let={entry} field="sequence" label="#" sort={@showcase["cinder"]["sort"]}>
            {entry.sequence}
          </:col>
          <:item :let={entry}>
            <div class="grid grid-cols-[max-content_max-content] items-center gap-2">
              <span class="status-pill bg-primary overlay-dark text-brand">{entry.code}</span>
              <span class="status-pill bg-primary overlay-dark text-content">{entry.state}</span>
            </div>
            <div class="mt-3 space-y-1">
              <p class="font-semibold">{entry.name}</p>
              <p class="text-sm text-subcontent">{entry.description}</p>
              <p class="text-xs text-subcontent">{entry.url}</p>
            </div>
          </:item>
        </Cinder.Collection.collection>
      </div>
    </section>

    <section class="grid grid-cols-[1fr_1fr] gap-4">
      <.card id="layout-test-live-select-card">
        <.header>
          LiveSelect
          <:subtitle>
            Choose a select mode and display state, then pick dependency pages.
          </:subtitle>
        </.header>
        <div id="layout-test-live-select-controls" class="space-y-3">
          <details
            phx-mounted={JS.ignore_attributes("open")}
            id="dependency-select-mode-choices"
          >
            <summary class="hover:overlay-dark min-h-11 content-center cursor-pointer rounded-default border border-outline bg-secondary px-3 py-2 text-sm font-medium text-content">
              Selection mode: {@showcase["live_select"]["mode"]}
            </summary>
            <div class="mt-2 grid grid-cols-[1fr_1fr_1fr] gap-2">
              <.button
                :for={
                  {mode, label} <- [
                    {"single", "Single"},
                    {"tags", "Tags"},
                    {"quick_tags", "Quick tags"}
                  ]
                }
                id={"dependency-select-mode-#{mode}"}
                type="button"
                variant={
                  if @showcase["live_select"]["mode"] == mode, do: :primary, else: :neutral
                }
                aria-pressed={to_string(@showcase["live_select"]["mode"] == mode)}
                phx-click="set_showcase_option"
                phx-value-section="live_select"
                phx-value-option="mode"
                phx-value-choice={mode}
              >{label}</.button>
            </div>
          </details>
          <details
            phx-mounted={JS.ignore_attributes("open")}
            id="dependency-select-render-choices"
          >
            <summary class="hover:overlay-dark min-h-11 content-center cursor-pointer rounded-default border border-outline bg-secondary px-3 py-2 text-sm font-medium text-content">
              Display mode: {@showcase["live_select"]["render_as"]}
            </summary>
            <div class="mt-2 grid grid-cols-[1fr_1fr] gap-2">
              <.button
                :for={render_as <- @input_render_modes}
                id={"dependency-select-render-#{render_as}"}
                type="button"
                variant={
                  if @showcase["live_select"]["render_as"] == render_as,
                    do: :primary,
                    else: :neutral
                }
                aria-pressed={to_string(@showcase["live_select"]["render_as"] == render_as)}
                phx-click="set_showcase_option"
                phx-value-section="live_select"
                phx-value-option="render_as"
                phx-value-choice={render_as}
              >{render_as}</.button>
            </div>
          </details>
          <div class="grid grid-cols-[1fr_1fr_1fr] gap-2">
            <.button
              :for={
                {option, label} <- [
                  {"prompt", "Prompt"},
                  {"keep_options", "Keep options"},
                  {"disabled", "Disabled"}
                ]
              }
              id={"dependency-select-option-#{option}"}
              type="button"
              variant={if @showcase["live_select"][option], do: :primary, else: :neutral}
              aria-pressed={to_string(@showcase["live_select"][option])}
              disabled={
                option == "keep_options" and @showcase["live_select"]["mode"] == "quick_tags"
              }
              phx-click="toggle_showcase_option"
              phx-value-section="live_select"
              phx-value-option={option}
            >{label}</.button>
          </div>
          <p
            :if={@showcase["live_select"]["mode"] == "quick_tags"}
            class="text-sm text-subcontent"
          >
            Quick tags always keeps selected options available.
          </p>
        </div>
        <.form
          for={@dependency_form}
          id="layout-test-dependency-form"
          phx-change="dependency_change"
        >
          <.input
            type="select"
            field={@dependency_form[:component_search]}
            id="layout-test-dependency-live-select"
            options={@dependency_options}
            mode={String.to_existing_atom(@showcase["live_select"]["mode"])}
            render_as={@showcase["live_select"]["render_as"]}
            prompt={if @showcase["live_select"]["prompt"], do: "Search dependency pages"}
            keep_options_on_select={@showcase["live_select"]["keep_options"]}
            disabled={@showcase["live_select"]["disabled"]}
          />
        </.form>
        <.card_inset id="layout-test-selected-dependency">
          <%= if @selected_dependencies == [] do %>
            <p class="text-sm text-subcontent">
              Pick a dependency page to inspect its route and source package.
            </p>
          <% else %>
            <div class="space-y-4">
              <div
                :for={page <- @selected_dependencies}
                id={"selected-dependency-#{page.id}"}
                class="space-y-2"
              >
                <div class="grid grid-cols-[1fr_max-content] items-center gap-2">
                  <p class="font-semibold">{page.name}</p>
                  <span class="status-pill bg-primary overlay-dark text-content">{page.availability}</span>
                </div>
                <p class="text-sm text-subcontent">{page.description}</p>
                <p class="text-xs text-subcontent">{page.source} · {page.path}</p>
                <.button href={page.path} variant={:neutral}>Open {page.name}</.button>
              </div>
            </div>
          <% end %>
        </.card_inset>
      </.card>

      <.card id="layout-test-ui-kit-card">
        <.header>
          UI kit
          <:subtitle>Adjust each primitive and compare its preview below.</:subtitle>
        </.header>
        <div id="layout-test-ui-kit-controls" class="space-y-3">
          <details
            phx-mounted={JS.ignore_attributes("open")}
            id="ui-kit-alert-choices"
          >
            <summary class="hover:overlay-dark min-h-11 content-center cursor-pointer rounded-default border border-outline bg-secondary px-3 py-2 text-sm font-medium text-content">
              Alert kind: {String.capitalize(@showcase["ui_kit"]["alert"])}
            </summary>
            <div class="mt-2 grid grid-cols-[1fr_1fr_1fr_1fr] gap-2">
              <.button
                :for={kind <- ~w(info success warning error)}
                id={"ui-kit-alert-#{kind}"}
                type="button"
                variant={if @showcase["ui_kit"]["alert"] == kind, do: :primary, else: :neutral}
                aria-pressed={to_string(@showcase["ui_kit"]["alert"] == kind)}
                phx-click="set_showcase_option"
                phx-value-section="ui_kit"
                phx-value-option="alert"
                phx-value-choice={kind}
              >{String.capitalize(kind)}</.button>
            </div>
          </details>
          <details
            phx-mounted={JS.ignore_attributes("open")}
            id="ui-kit-badge-choices"
          >
            <summary class="hover:overlay-dark min-h-11 content-center cursor-pointer rounded-default border border-outline bg-secondary px-3 py-2 text-sm font-medium text-content">
              Badge style: {String.capitalize(@showcase["ui_kit"]["badge"])}
            </summary>
            <div class="mt-2 grid grid-cols-[1fr_1fr_1fr_1fr] gap-2">
              <.button
                :for={
                  {style, label} <- [
                    {"brand", "Brand"},
                    {"outline", "Outline"},
                    {"success", "Success"},
                    {"warning", "Warning"}
                  ]
                }
                id={"ui-kit-badge-#{style}"}
                type="button"
                variant={if @showcase["ui_kit"]["badge"] == style, do: :primary, else: :neutral}
                aria-pressed={to_string(@showcase["ui_kit"]["badge"] == style)}
                phx-click="set_showcase_option"
                phx-value-section="ui_kit"
                phx-value-option="badge"
                phx-value-choice={style}
              >{label}</.button>
            </div>
          </details>
          <div class="grid grid-cols-[1fr_1fr] items-start subgap-4">
            <details
              phx-mounted={JS.ignore_attributes("open")}
              id="ui-kit-step-choices"
            >
              <summary class="hover:overlay-dark min-h-11 content-center cursor-pointer rounded-default border border-outline bg-secondary px-3 py-2 text-sm font-medium text-content">
                Current step: {@showcase["ui_kit"]["step"]}
              </summary>
              <div class="mt-2 grid grid-cols-[1fr_1fr_1fr] gap-2">
                <.button
                  :for={step <- ~w(1 2 3)}
                  id={"ui-kit-step-#{step}"}
                  type="button"
                  variant={if @showcase["ui_kit"]["step"] == step, do: :primary, else: :neutral}
                  aria-pressed={to_string(@showcase["ui_kit"]["step"] == step)}
                  phx-click="set_showcase_option"
                  phx-value-section="ui_kit"
                  phx-value-option="step"
                  phx-value-choice={step}
                >{step}</.button>
              </div>
            </details>
            <.form
              for={to_form(@showcase["ui_kit"], as: :showcase)}
              id="ui-kit-progress-form"
              phx-change="showcase_change"
              phx-value-section="ui_kit"
            >
              <.input
                id="ui-kit-progress-control"
                name="showcase[progress]"
                type="number"
                label="Progress (%)"
                value={@showcase["ui_kit"]["progress"]}
                min="0"
                max="100"
                step="1"
              />
            </.form>
          </div>
          <.button
            id="ui-kit-option-menu"
            type="button"
            variant={if @showcase["ui_kit"]["menu"], do: :primary, else: :neutral}
            aria-pressed={to_string(@showcase["ui_kit"]["menu"])}
            phx-click="toggle_showcase_option"
            phx-value-section="ui_kit"
            phx-value-option="menu"
          >Show menu</.button>
        </div>
        <div id="layout-test-ui-kit-preview" class="space-y-3">
          <div
            id="ui-kit-alert-preview"
            role="status"
            data-kind={@showcase["ui_kit"]["alert"]}
            class={[
              "grid grid-cols-[1.25rem_1fr] items-center gap-2 p-4 rounded-default border bg-primary overlay-dark",
              case @showcase["ui_kit"]["alert"] do
                "info" -> "border-info text-info"
                "success" -> "border-success text-success"
                "warning" -> "border-warning text-warning"
                "error" -> "border-error text-error"
              end
            ]}
          >
            <.icon
              name={
                case @showcase["ui_kit"]["alert"] do
                  "info" -> "hero-information-circle"
                  "success" -> "hero-check-circle"
                  "warning" -> "hero-exclamation-triangle"
                  "error" -> "hero-x-circle"
                end
              }
              class="size-5"
            />
            <span>{String.capitalize(@showcase["ui_kit"]["alert"])} alert surface</span>
          </div>
          <span
            id="ui-kit-badge-preview"
            data-style={@showcase["ui_kit"]["badge"]}
            class={[
              "status-pill",
              case @showcase["ui_kit"]["badge"] do
                "brand" -> "bg-brand text-content-inverse dark:text-content"
                "outline" -> "border border-outline text-content"
                "success" -> "bg-success text-content"
                "warning" -> "bg-warning text-content"
              end
            ]}
          >{String.capitalize(@showcase["ui_kit"]["badge"])}</span>
          <div
            id="ui-kit-progress-preview"
            role="progressbar"
            aria-label="Example progress"
            aria-valuemin="0"
            aria-valuemax="100"
            aria-valuenow={@showcase["ui_kit"]["progress"]}
            class="w-full h-2 rounded-full bg-primary overlay-dark overflow-hidden"
          >
            <div class="h-full bg-brand" style={"width: #{@showcase["ui_kit"]["progress"]}%"}>
            </div>
          </div>
          <ol id="ui-kit-steps-preview" class="grid grid-cols-[1fr_1fr_1fr] items-center gap-2">
            <li
              :for={{label, index} <- Enum.with_index(["Tokens", "Hooks", "Routes"], 1)}
              aria-current={
                if index == String.to_integer(@showcase["ui_kit"]["step"]), do: "step"
              }
              class={[
                "text-center text-sm pb-2 border-b-2",
                if(index <= String.to_integer(@showcase["ui_kit"]["step"]),
                  do: "border-brand text-brand",
                  else: "border-outline text-subcontent"
                )
              ]}
            >
              {label}
            </li>
          </ol>
          <ul
            :if={@showcase["ui_kit"]["menu"]}
            id="ui-kit-menu-preview"
            class="rounded-default bg-primary overlay-dark p-2 flex flex-col"
          >
            <li>
              <.link href="/sign-in" class="block px-3 py-2 rounded-default hover:overlay-dark">Auth flow</.link>
            </li>
            <li>
              <.link
                href="/api/json/scalar"
                class="block px-3 py-2 rounded-default hover:overlay-dark"
              >API browser</.link>
            </li>
            <li>
              <.link href="/admin" class="block px-3 py-2 rounded-default hover:overlay-dark">Admin surface</.link>
            </li>
          </ul>
        </div>
      </.card>
    </section>

    <.card id="layout-test-dependency-pages">
      <.header>
        Dependency pages
        <:subtitle>Choose a route to inspect its availability and source package.</:subtitle>
      </.header>
      <details
        phx-mounted={JS.ignore_attributes("open")}
        id="dependency-page-controls"
      >
        <summary class="hover:overlay-dark min-h-11 content-center cursor-pointer rounded-default border border-outline bg-secondary px-3 py-2 text-sm font-medium text-content">
          Page: {Enum.find(@dependency_pages, &(&1.id == @showcase["pages"]["selected"])).name}
        </summary>
        <div class="mt-2 grid grid-cols-[1fr_1fr_1fr_1fr] gap-2">
          <.button
            :for={page <- @dependency_pages}
            id={"dependency-page-choice-#{page.id}"}
            type="button"
            variant={if @showcase["pages"]["selected"] == page.id, do: :primary, else: :neutral}
            aria-pressed={to_string(@showcase["pages"]["selected"] == page.id)}
            phx-click="set_showcase_option"
            phx-value-section="pages"
            phx-value-option="selected"
            phx-value-choice={page.id}
          >{page.name}</.button>
        </div>
      </details>
      <.card_inset
        :for={page <- @dependency_pages}
        :if={page.id == @showcase["pages"]["selected"]}
        id={"dependency-page-#{page.id}"}
      >
        <div class="space-y-3">
          <div class="grid grid-cols-[1fr_max-content] items-center gap-2">
            <h3 class="font-semibold">{page.name}</h3>
            <span class="status-pill bg-primary overlay-dark text-content">{page.availability}</span>
          </div>
          <p class="text-sm text-subcontent">{page.description}</p>
          <p class="text-xs text-subcontent">{page.source} · {page.path}</p>
          <.button href={page.path} variant={:neutral}>Open page</.button>
        </div>
      </.card_inset>
    </.card>
  </div>
  <.modal :if={@show_modal} id="layout-test-modal" on_cancel={JS.push("hide_modal")}>
    <:title :if={@showcase["dialog"]["title"]}>Example dialog</:title>
    <p class="text-sm text-content">
      Focus stays in this dialog. Escape closes it and returns focus to the opening control.
    </p>
    <div :if={@showcase["dialog"]["actions"]} class="mt-4 grid grid-cols-[1fr_1fr] gap-2">
      <.button id="dialog-cancel" type="button" variant={:neutral} phx-click="hide_modal">Cancel</.button>
      <.button id="dialog-confirm" type="button" variant={:primary} phx-click="hide_modal">Confirm</.button>
    </div>
  </.modal>
</Layouts.app>
