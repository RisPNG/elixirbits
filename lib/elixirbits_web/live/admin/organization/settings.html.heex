<Layouts.app user_timezone={@user_timezone} flash={@flash} nav={@nav}>
  <.form
    for={@form}
    id="organization-form"
    phx-change="validate"
    phx-submit="save"
    class="space-y-6"
  >
    <.page>
      <:title>Organization settings</:title>

      <:actions :if={@editable?}>
        <.action_button action={:save} type="submit" tooltip="Save settings" />
      </:actions>

      <.card>
        <div class="grid grid-cols-[2fr_1fr_1fr] subgap-2">
          <.input
            field={@form[:name]}
            type="text"
            label="Name"
            render_as={if @editable?, do: "enabled", else: "disabled"}
          />
          <.input
            field={@form[:registration_no]}
            type="text"
            label="Registration number"
            render_as={if @editable?, do: "enabled", else: "disabled"}
          />
          <.input
            field={@form[:tax_identification_no]}
            type="text"
            label="Tax identification number"
            render_as={if @editable?, do: "enabled", else: "disabled"}
          />
        </div>

        <div class="grid grid-cols-[1fr_1fr_2fr] subgap-2">
          <.input
            field={@form[:base_currency]}
            type="text"
            label="Base currency"
            render_as={if @editable?, do: "enabled", else: "disabled"}
          />
          <.input
            field={@form[:locale]}
            type="text"
            label="Locale"
            render_as={if @editable?, do: "enabled", else: "disabled"}
          />
          <.input
            field={@form[:timezone]}
            type="text"
            label="Timezone"
            render_as={if @editable?, do: "enabled", else: "disabled"}
          />
        </div>

        <div class="grid grid-cols-[2fr_2fr] subgap-2">
          <.input
            field={@form[:email]}
            type="email"
            label="Email"
            render_as={if @editable?, do: "enabled", else: "disabled"}
          />
          <.input
            field={@form[:phone]}
            type="tel"
            label="Phone"
            render_as={if @editable?, do: "enabled", else: "disabled"}
          />
        </div>
      </.card>

      <.card>
        <.header>
          Addresses
          <:actions>
            <.action_button
              :if={@editable? and can?(@permissions, @current_path, :create)}
              action={:create}
              type="button"
              phx-click="add_form"
              tooltip="Add"
            />
          </:actions>
        </.header>

        <div class="grid grid-cols-[1fr_1fr] gap-y-4">
          <.inputs_for :let={af} field={@form[:addresses]}>
            <.entry_panel label="Address" index={af.index} columns={2}>
              <:actions>
                <.action_button
                  :if={
                    @editable? and
                      (af.source.type == :create or can?(@permissions, @current_path, :delete))
                  }
                  action={:delete}
                  type="button"
                  phx-click="remove_form"
                  phx-value-path={af.name}
                  tooltip="Remove address"
                />
              </:actions>

              <div class="grid grid-cols-[1fr_3fr] subgap-2">
                <.input
                  id={"#{af.id}_label_select"}
                  field={af[:label]}
                  type="combobox"
                  label="Label"
                  options={@label_options}
                  prompt="None"
                  render_as={if @editable?, do: "enabled", else: "disabled"}
                />
                <.input
                  field={af[:other_label]}
                  type="text"
                  label="Nickname"
                  render_as={if @editable?, do: "enabled", else: "disabled"}
                />
              </div>

              <div class="grid grid-cols-[2fr_2fr] subgap-2">
                <.input
                  field={af[:contact_name]}
                  type="text"
                  label="Contact name"
                  render_as={if @editable?, do: "enabled", else: "disabled"}
                />
                <.input
                  field={af[:contact_tel_no]}
                  type="tel"
                  label="Contact phone"
                  render_as={if @editable?, do: "enabled", else: "disabled"}
                />
              </div>

              <div class="grid grid-cols-[4fr] subgap-2">
                <.input
                  field={af[:line_1]}
                  type="text"
                  label="Line 1"
                  render_as={if @editable?, do: "enabled", else: "disabled"}
                />
              </div>

              <div class="grid grid-cols-[4fr] subgap-2">
                <.input
                  field={af[:line_2]}
                  type="text"
                  label="Line 2"
                  render_as={if @editable?, do: "enabled", else: "disabled"}
                />
              </div>

              <div class="grid grid-cols-[4fr] subgap-2">
                <.input
                  field={af[:line_3]}
                  type="text"
                  label="Line 3"
                  render_as={if @editable?, do: "enabled", else: "disabled"}
                />
              </div>

              <div class="grid grid-cols-[1fr_3fr] subgap-2">
                <.input
                  field={af[:postal_code]}
                  type="text"
                  label="Postal code"
                  render_as={if @editable?, do: "enabled", else: "disabled"}
                />
                <.input
                  field={af[:city]}
                  type="text"
                  label="City"
                  render_as={if @editable?, do: "enabled", else: "disabled"}
                />
              </div>

              <div class="grid grid-cols-[2fr_2fr] subgap-2">
                <.input
                  field={af[:state]}
                  type="text"
                  label="State"
                  render_as={if @editable?, do: "enabled", else: "disabled"}
                />
                <.input
                  field={af[:country]}
                  type="text"
                  label="Country"
                  render_as={if @editable?, do: "enabled", else: "disabled"}
                />
              </div>
            </.entry_panel>
          </.inputs_for>
        </div>
      </.card>
    </.page>
  </.form>
</Layouts.app>
