<Layouts.app flash={@flash} nav={@nav} user_timezone={@user_timezone}>
  <.form
    for={@form}
    id="user-form"
    phx-change="validate"
    phx-submit="save"
    class="space-y-6"
  >
    <.page>
      <:title>{@page_title}</:title>

      <:actions>
        <div class="grid grid-cols-[auto_auto] items-center gap-2">
          <.action_button action={:back} navigate={~p"/admin/users"} />
          <.action_button
            :if={can?(@permissions, @current_path, @live_action)}
            action={:save}
            type="submit"
          />
        </div>
      </:actions>

      <fieldset disabled={!can?(@permissions, @current_path, @live_action)} class="space-y-6">
        <.card>
          <.header>
            Account
          </.header>

          <div class="group/profile-picture grid grid-cols-[8rem_minmax(0,1fr)] items-center gap-6 border-b border-outline pb-6">
            <div class="relative size-32">
              <span
                :if={@existing_display_pic == nil && @uploads.display_pic.entries == []}
                role="img"
                aria-label="No profile picture"
                class="absolute inset-0 grid place-items-center rounded-full bg-secondary text-4xl font-medium text-brand"
              >
                {String.upcase(
                  String.slice(@form[:display_name].value || to_string(@form[:email].value), 0, 1)
                )}
              </span>
              <.file_preview
                id="user-profile-picture-preview"
                class="relative size-32 overflow-hidden rounded-full"
              />
            </div>

            <div class="space-y-3">
              <div class="grid grid-cols-[max-content_1.5rem] items-center gap-1">
                <label for={@uploads.display_pic.ref} class="text-sm font-medium text-content">
                  Profile Picture
                </label>
                <button
                  type="button"
                  aria-label="Supported profile picture formats"
                  data-tooltip="Supports .jpg, .jpeg, .png, .gif, and .webp (up to 8 MB). Cropped to 128x128 pixels. GIF and animated WebP retain their animation."
                  class="grid size-6 place-items-center rounded-full text-subcontent hover:text-content focus-visible:outline-2 focus-visible:outline-brand"
                >
                  <.icon name="hero-information-circle-mini" class="size-4" />
                </button>
              </div>

              <p class="text-sm text-subcontent">Shown in the topbar and your account menu.</p>

              <div class="grid grid-cols-[max-content_max-content] items-center justify-start gap-3">
                <label
                  id="user-profile-picture-picker"
                  for={@uploads.display_pic.ref}
                  class={[
                    "button-base button-neutral grid min-h-11 place-items-center rounded-default px-4 py-2 text-sm group-has-[input:focus-visible]/profile-picture:outline-2 group-has-[input:focus-visible]/profile-picture:outline-brand",
                    if(can?(@permissions, @current_path, @live_action),
                      do: "cursor-pointer",
                      else: "cursor-not-allowed text-subcontent"
                    )
                  ]}
                >
                  {if @existing_display_pic || @uploads.display_pic.entries != [],
                    do: "Change picture",
                    else: "Upload picture"}
                </label>
                <.button
                  :for={entry <- @uploads.display_pic.entries}
                  id="user-profile-picture-cancel"
                  type="button"
                  variant={:text}
                  phx-click="cancel_upload"
                  phx-value-ref={entry.ref}
                >
                  Cancel
                </.button>
                <.button
                  :if={@uploads.display_pic.entries == []}
                  id="user-profile-picture-remove"
                  type="button"
                  variant={:text}
                  phx-click="remove_upload"
                  disabled={@existing_display_pic == nil}
                >
                  Remove
                </.button>
              </div>

              <p class="text-sm text-subcontent">128x128 pixels. Maximum 8 MB.</p>
              <.input
                type="file"
                name="display_pic"
                aria-label="Profile Picture"
                class="sr-only"
                upload={@uploads.display_pic}
                stored={List.wrap(@existing_display_pic)}
                preview={true}
                preview_id="user-profile-picture-preview"
                editor={%{width: 128, height: 128}}
                preview_as="thumbnail"
                thumbnail_class="h-full w-full"
                disabled={!can?(@permissions, @current_path, @live_action)}
              >
                <:stored_preview :let={url}>
                  <img src={url} alt="Profile picture" class="size-full object-cover" />
                </:stored_preview>

                <:pending_preview :let={entry}>
                  <.live_img_preview
                    entry={entry}
                    alt="Selected profile picture"
                    class="size-full object-cover"
                  />
                </:pending_preview>
              </.input>
            </div>
          </div>

          <div class="grid grid-cols-[2fr_1fr_1fr] subgap-2 pt-2">
            <.input
              field={@form[:email]}
              type="email"
              label="Email"
              disabled={@live_action == :update}
            />
            <.input field={@form[:username]} type="text" label="Username" />
            <.input field={@form[:display_name]} type="text" label="Display Name" />
          </div>

          <div :if={@live_action == :create} class="grid grid-cols-[2fr_2fr] subgap-2">
            <.input
              field={@form[:password]}
              type="password"
              label="Password"
              autocomplete="new-password"
            />
            <.input
              field={@form[:password_confirmation]}
              type="password"
              label="Confirm Password"
              autocomplete="new-password"
            />
          </div>
        </.card>

        <.card>
          <.header>
            Personal Details
          </.header>

          <div class="grid grid-cols-[1fr_1fr_2fr] subgap-2">
            <.input field={@form[:first_name]} type="text" label="First Name" />
            <.input field={@form[:middle_name]} type="text" label="Middle Name" />
            <.input field={@form[:last_name]} type="text" label="Last Name" />
          </div>

          <div class="grid grid-cols-[2fr_1fr_1fr] subgap-2">
            <.input field={@form[:tel_no]} type="text" label="Phone" />
            <.input
              field={@form[:sex]}
              type="combobox"
              label="Sex"
              options={@sex_options}
              prompt="None"
            /> <.input field={@form[:dob]} type="date" label="Date of Birth" />
          </div>

          <div class="grid grid-cols-[1fr_3fr] subgap-2">
            <.input field={@form[:locale]} type="text" label="Locale" />
            <.input
              field={@form[:timezone]}
              type="text"
              label="Timezone"
              placeholder="Automatic (browser)"
              tooltip="Leave blank to use your browser's timezone."
            />
          </div>
        </.card>

        <.card>
          <.header>
            Addresses
            <:actions>
              <.action_button
                :if={
                  can?(@permissions, @current_path, @live_action) and
                    can?(@permissions, @current_path, :create)
                }
                type="button"
                phx-click="add_form"
                phx-value-field="addresses"
                action={:create}
                tooltip="Add"
              />
            </:actions>
          </.header>

          <div class="grid grid-cols-[1fr_1fr] gap-y-4">
            <.inputs_for :let={af} field={@form[:addresses]}>
              <.entry_panel label="Address" index={af.index} columns={2}>
                <:actions>
                  <.action_button
                    :if={
                      can?(@permissions, @current_path, @live_action) and
                        (af.source.type == :create or can?(@permissions, @current_path, :delete))
                    }
                    type="button"
                    phx-click="remove_form"
                    phx-value-path={af.name}
                    action={:delete}
                  />
                </:actions>

                <div class="grid grid-cols-[1fr_3fr] subgap-2">
                  <.input
                    id={"#{af.id}_label_select"}
                    field={af[:label]}
                    type="combobox"
                    label="Label"
                    options={@label_options}
                    prompt="None"
                  /> <.input field={af[:other_label]} type="text" label="Nickname" />
                </div>

                <div class="grid grid-cols-[2fr_2fr] subgap-2">
                  <.input field={af[:contact_name]} type="text" label="Contact Name" />
                  <.input field={af[:contact_tel_no]} type="text" label="Contact" />
                </div>

                <div class="grid grid-cols-[4fr] subgap-2">
                  <.input field={af[:line_1]} type="text" label="Line 1" />
                </div>

                <div class="grid grid-cols-[4fr] subgap-2">
                  <.input field={af[:line_2]} type="text" label="Line 2" />
                </div>

                <div class="grid grid-cols-[4fr] subgap-2">
                  <.input field={af[:line_3]} type="text" label="Line 3" />
                </div>

                <div class="grid grid-cols-[1fr_3fr] subgap-2">
                  <.input field={af[:postal_code]} type="text" label="Postal Code" />
                  <.input field={af[:city]} type="text" label="City" />
                </div>

                <div class="grid grid-cols-[2fr_2fr] subgap-2">
                  <.input field={af[:state]} type="text" label="State" />
                  <.input field={af[:country]} type="text" label="Country" />
                </div>
              </.entry_panel>
            </.inputs_for>
          </div>
        </.card>
      </fieldset>
      <.card :if={@can_assign_roles?} id="user-roles">
        <.header>
          Roles
        </.header>

        <div class="grid grid-cols-[1fr] subgap-2">
          <.input
            field={@form[:roles]}
            type="combobox"
            multiple
            label="Roles"
            options={@role_options}
          />
        </div>
      </.card>
    </.page>
  </.form>
</Layouts.app>
