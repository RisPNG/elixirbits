<div class="grid grid-cols-[max-content_2.75rem_2.75rem_1fr_max-content] items-center gap-2">
  <.button
    type="button"
    phx-click="calendar_change"
    phx-value-view={@view}
    phx-value-date={Date.to_iso8601(@today)}
    variant={:neutral}
  >
    Today
  </.button>
  <.button
    type="button"
    phx-click="calendar_change"
    phx-value-view={@view}
    phx-value-date={Date.to_iso8601(Cal.shift(@view, @cursor, -1))}
    aria-label="Previous calendar period"
    variant={:neutral}
    class="size-11 p-0!"
  >
    <.icon name="hero-chevron-left" class="size-4" />
  </.button>
  <.button
    type="button"
    phx-click="calendar_change"
    phx-value-view={@view}
    phx-value-date={Date.to_iso8601(Cal.shift(@view, @cursor, 1))}
    aria-label="Next calendar period"
    variant={:neutral}
    class="size-11 p-0!"
  >
    <.icon name="hero-chevron-right" class="size-4" />
  </.button>
  <h2 class="text-lg font-semibold text-content">{@period_title}</h2>
  <div class="grid grid-cols-[repeat(6,max-content)] gap-2">
    <.button
      :for={{value, label} <- Cal.views()}
      type="button"
      phx-click="calendar_change"
      phx-value-view={value}
      phx-value-date={Date.to_iso8601(@cursor)}
      aria-pressed={if @view == value, do: "true", else: "false"}
    >
      {label}
    </.button>
  </div>
</div>
