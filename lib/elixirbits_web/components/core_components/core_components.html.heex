<%= case @component do %>
  <% :icon -> %>
    <%!-- Shared foundations --%>
    <span class={[@name, @class]} />
  <% :page -> %>
    <%!-- Page structure --%>
    <section class={@class} {@rest}>
      <.header level={1}>
        {render_slot(@title)}
        <:actions :if={@actions != []}>{render_slot(@actions, :top)}</:actions>
      </.header>
      {render_slot(@inner_block)}
      <footer
        :if={@actions != []}
        class="grid grid-cols-[max-content] justify-end border-t border-outline pt-6"
      >
        {render_slot(@actions, :bottom)}
      </footer>
    </section>
  <% :header -> %>
    <header class={[
      "grid items-start gap-6",
      if(@actions == [],
        do: "grid-cols-[1fr]",
        else: "grid-cols-[minmax(0,1fr)_max-content]"
      )
    ]}>
      <.dynamic_tag
        tag_name={"h#{@level}"}
        class={[
          "min-w-0 font-medium text-content",
          @level == 1 && "text-3xl leading-10 tracking-tight",
          @level == 2 && "text-lg leading-7",
          @level == 3 && "text-base leading-6"
        ]}
      >
        {render_slot(@inner_block)}
      </.dynamic_tag>

      <div :if={@actions != []}>{render_slot(@actions)}</div>
    </header>
  <% :card -> %>
    <section
      id={@id}
      class={[
        "flex flex-col rounded-default panel-surface shadow-card",
        @class
      ]}
      {@rest}
    >
      <div class="flex flex-col gap-5 p-6">
        {render_slot(@inner_block)}
      </div>
    </section>
  <% :card_inset -> %>
    <div
      id={@id}
      class={["rounded-default inset-surface text-content p-4", @class]}
      {@rest}
    >
      {render_slot(@inner_block)}
    </div>
  <% :collapse -> %>
    <details
      id={@id}
      open={@open}
      class={[
        "rounded-default inset-surface text-content",
        @class
      ]}
      phx-mounted={JS.ignore_attributes("open")}
      {@rest}
    >
      <summary class="grid min-h-11 cursor-pointer list-none grid-cols-[minmax(0,1fr)_2.75rem] items-center gap-2 rounded-default ps-3 pe-1 text-sm focus-visible:outline-2 focus-visible:outline-brand [&::-webkit-details-marker]:hidden">
        <div class="min-w-0 py-2 font-medium">{render_slot(@summary)}</div>

        <span
          aria-hidden="true"
          class="grid size-9 place-items-center justify-self-center rounded-full hover:overlay-dark"
        >
          <.icon
            name="hero-chevron-down-micro"
            class="size-4 [[open]>summary_&]:rotate-180"
          />
        </span>
      </summary>

      <div class="px-3 pb-3 pt-2">{render_slot(@inner_block)}</div>
    </details>
  <% :entry_panel -> %>
    <div class={[
      "flex flex-col gap-4 border-b border-outline pb-4",
      @columns == 2 && ((rem(@index, 2) == 1 && "border-l pl-6") || "pr-6"),
      @class
    ]}>
      <div class="grid grid-cols-[1fr_2.75rem] items-center gap-2 border-b border-outline pb-2">
        <p :if={@sequence == []} class="text-sm font-semibold text-content">
          {"#{@label} ##{@index + 1}"}
        </p>

        <div
          :if={@sequence != []}
          class="grid grid-cols-[max-content_4rem] items-center text-sm font-semibold text-content"
        >
          <span>{@label} #</span> {render_slot(@sequence)}
        </div>
        {render_slot(@actions)}
      </div>
      {render_slot(@inner_block)}
    </div>
  <% :button_link -> %>
    <%!-- Actions and dialogs --%>
    <.link class={@class} data-tooltip={@tooltip} {@rest}>
      {render_slot(@inner_block)}
    </.link>
  <% :button -> %>
    <button class={@class} data-tooltip={@tooltip} {@rest}>
      {render_slot(@inner_block)}
    </button>
  <% :action_button -> %>
    <.button
      variant={@variant}
      class={["size-11 p-0!", @class]}
      tooltip={@tooltip}
      {@rest}
    >
      <.icon name={@icon} class="size-6" />
    </.button>
  <% :modal -> %>
    <div
      :if={@show}
      id={@id}
      class="fixed inset-0 z-50 grid place-items-center p-4"
      phx-mounted={JS.push_focus() |> JS.focus_first(to: "##{@id}-content")}
      phx-remove={JS.pop_focus()}
      phx-window-keydown={JS.exec("data-cancel", to: "##{@id}")}
      phx-key="Escape"
      data-cancel={@on_cancel}
    >
      <div
        class="absolute inset-0 bg-dark"
        phx-click={JS.exec("data-cancel", to: "##{@id}")}
        aria-hidden="true"
      />
      <.focus_wrap
        id={"#{@id}-content"}
        role="dialog"
        aria-modal="true"
        aria-labelledby={@title != [] && "#{@id}-title"}
        aria-label={@title == [] && @label}
        class="relative z-10 w-full max-w-lg rounded-default border border-outline bg-primary p-6 shadow-lg"
      >
        <h2 :if={@title != []} id={"#{@id}-title"} class="mb-4 text-lg font-semibold text-content">
          {render_slot(@title)}
        </h2>
        {render_slot(@inner_block)}
      </.focus_wrap>
    </div>
  <% :delete_confirmation -> %>
    <.modal
      :if={!@remove_assignments?}
      id="confirm-delete"
      on_cancel={JS.push("cancel_delete")}
    >
      <:title>Delete {@label}</:title>

      <p class="text-sm text-content">Delete {@name}?</p>

      <div class="mt-4 grid grid-cols-[1fr_1fr] gap-2">
        <.button type="button" variant={:neutral} phx-click="cancel_delete">Cancel</.button>
        <.button type="button" variant={:danger} phx-click="confirm_delete">Delete</.button>
      </div>
    </.modal>

    <.modal
      :if={@remove_assignments?}
      id="confirm-role-removal"
      on_cancel={JS.push("cancel_delete")}
    >
      <:title>Remove role from users?</:title>

      <p class="text-sm text-content">
        Deleting {@name} will also remove this role from every user who has it. Continue?
      </p>

      <div class="mt-4 grid grid-cols-[1fr_1fr] gap-2">
        <.button type="button" variant={:neutral} phx-click="cancel_delete">Cancel</.button>
        <.button
          type="button"
          variant={:danger}
          phx-click="confirm_delete"
          phx-value-remove-assignments="true"
        >
          Delete role
        </.button>
      </div>
    </.modal>
  <% :flash -> %>
    <%!-- Feedback --%>
    <div
      :if={msg = render_slot(@inner_block) || @msg}
      id={@id}
      phx-click={
        if @msg,
          do: JS.push("lv:clear-flash", value: %{key: @kind}) |> hide("##{@id}"),
          else: hide("##{@id}")
      }
      phx-hook={if @duration || @msg, do: "FlashAutoDismiss"}
      data-flash-notice
      data-flash-kind={@kind}
      data-flash-key={if @msg, do: @kind}
      data-duration={@duration}
      role="alert"
      class="flash-surface fixed top-4 right-4 z-50 flex flex-col gap-2 rounded-default"
      {@rest}
    >
      <div class="flex items-start gap-3 p-4 rounded-default border border-outline w-80 max-w-80 text-wrap shadow-sm text-content">
        <.icon :if={@icon} name={@icon} class="size-5 shrink-0" />
        <div>
          <p :if={@title} class="font-semibold">{@title}</p>

          <p>
            {msg}
            <.icon
              :if={@show_spinner}
              name="hero-arrow-path"
              class="ml-1 size-3 motion-safe:animate-spin"
            />
          </p>
        </div>
        <div class="flex-1" />
        <button
          type="button"
          class="self-start rounded-default cursor-pointer hover:overlay-dark"
          aria-label={gettext("close")}
        >
          <.icon name="hero-x-mark" class="size-5" />
        </button>
      </div>
    </div>
  <% :flash_group -> %>
    <div id={@flash_ids.group} aria-live="polite">
      <.flash kind={:info} flash={@flash} title={gettext("Success!")} duration={5000} />
      <.flash kind={:error} flash={@flash} title={gettext("Error!")} duration={8000} />
      <.flash kind={:warning} flash={@flash} title={gettext("Warning")} duration={8000} />
      <.flash
        id={@flash_ids.client_error}
        kind={:error}
        title={gettext("We can't find the internet")}
        show_spinner
        data-show={
          JS.hide(to: "[data-flash-notice]:not(##{@flash_ids.client_error})", time: 0)
          |> JS.show(to: "##{@flash_ids.client_error}", time: 0)
          |> JS.remove_attribute("hidden", to: "##{@flash_ids.client_error}")
        }
        phx-disconnected={
          JS.exec("data-show", to: ".phx-client-error ##{@flash_ids.client_error}")
        }
        phx-connected={hide("##{@flash_ids.client_error}") |> JS.set_attribute({"hidden", ""})}
        hidden
      >
        {gettext("Attempting to reconnect")}
      </.flash>

      <.flash
        id={@flash_ids.server_error}
        kind={:error}
        title={gettext("Something went wrong!")}
        show_spinner
        data-show={
          JS.hide(to: "[data-flash-notice]:not(##{@flash_ids.server_error})", time: 0)
          |> JS.show(to: "##{@flash_ids.server_error}", time: 0)
          |> JS.remove_attribute("hidden", to: "##{@flash_ids.server_error}")
        }
        phx-disconnected={
          JS.exec("data-show", to: ".phx-server-error ##{@flash_ids.server_error}")
        }
        phx-connected={hide("##{@flash_ids.server_error}") |> JS.set_attribute({"hidden", ""})}
        hidden
      >
        {gettext("Attempting to reconnect")}
      </.flash>
    </div>
  <% :table -> %>
    <%!-- Listings --%>
    <div class="listing-surface overflow-x-auto">
      <table class="listing-table">
        <thead>
          <tr>
            <th :for={col <- @col} class="listing-heading">{col[:label]}</th>

            <th :if={@action != []} class="listing-heading">
              <span class="sr-only">{gettext("Actions")}</span>
            </th>
          </tr>
        </thead>

        <tbody id={@id} phx-update={is_struct(@rows, Phoenix.LiveView.LiveStream) && "stream"}>
          <tr :for={row <- @rows} id={@row_id && @row_id.(row)}>
            <td
              :for={col <- @col}
              phx-click={@row_click && @row_click.(row)}
              class={["listing-cell", @row_click && "hover:cursor-pointer"]}
            >
              {render_slot(col, @row_item.(row))}
            </td>

            <td :if={@action != []} class={["listing-cell", "w-0"]}>
              <div
                class="grid grid-cols-[repeat(var(--action-count),max-content)] items-center gap-4"
                style={"--action-count: #{length(@action)}"}
              >
                <%= for action <- @action do %>
                  {render_slot(action, @row_item.(row))}
                <% end %>
              </div>
            </td>
          </tr>
        </tbody>
      </table>
    </div>
  <% :list -> %>
    <ul class="flex flex-col divide-y divide-outline">
      <li :for={item <- @item} class="flex gap-4 p-3 items-center">
        <div class="flex-1">
          <div class="font-bold">{item.title}</div>

          <div>{render_slot(item)}</div>
        </div>
      </li>
    </ul>
  <% :input_tooltip -> %>
    <%!-- Forms and inputs --%>
    <%!-- Shared input states --%>
    <div
      data-tooltip={@tooltip}
      class={
        @type in ["checkbox", "switch"] and
          (@variant == "alt" or @render_as in ["text", "text-enabled", "text-disabled"]) and
          "w-fit"
      }
    >
      {input(assign(assigns, :tooltip, nil))}
    </div>
  <% :input_hidden_wrapper -> %>
    <div class="hidden">{input(assigns)}</div>
  <% :input_hidden -> %>
    <input type="hidden" id={@id} name={@name} value={@value} {@rest} />
  <% :input_display -> %>
    <div data-core-input>
      <div :if={@text_look} class="flex flex-col gap-1">
        <span
          :if={@label}
          class={["text-sm font-medium", (@errors != [] && "text-error") || "text-subcontent"]}
        >
          {@label}<span
            :if={
              @rest[:required] && @rest[:disabled] in [nil, false] &&
                @rest[:readonly] in [nil, false] &&
                @render_as == "like-enabled" && @label not in [nil, ""]
            }
            aria-hidden="true"
            class="input-required ml-1 text-error"
          >*</span>
        </span>
        <span
          id={if !@include_hidden_input, do: @id}
          class={@class || @span_class}
          {@span_rest}
          phx-no-format
        >{@display}</span>
      </div>

      <div :if={!@text_look} class="relative block">
        <span
          id={if !@include_hidden_input, do: @id}
          class={@class || @span_class}
          {@span_rest}
          phx-no-format
        >{@display}</span>
        <span
          :if={@label}
          class={[
            "input-floating-label",
            @errors != [] && "input-floating-label-error"
          ]}
        >
          {@label}<span
            :if={
              @rest[:required] && @rest[:disabled] in [nil, false] &&
                @rest[:readonly] in [nil, false] &&
                @render_as == "like-enabled" && @label not in [nil, ""]
            }
            aria-hidden="true"
            class="input-required ml-1 text-error"
          >*</span>
        </span>
      </div>

      <.error :for={msg <- @errors}>{msg}</.error>

      <div :if={@include_hidden_input} class="hidden">
        {input(assign(assigns, render_as: "enabled", label: nil))}
      </div>
    </div>
  <% :input_labeled -> %>
    <%!-- Text controls --%>
    <div data-core-input>
      <div
        id={@type == "password" && @id not in [nil, ""] && "#{@id}-password-wrapper"}
        phx-hook={@type == "password" && @id not in [nil, ""] && "PasswordVisibility"}
        class="relative block"
      >
        <label for={@id} class="block">
          <input
            type={@type}
            name={@name}
            id={@id}
            value={Phoenix.HTML.Form.normalize_value(@type, @value)}
            placeholder={@placeholder}
            class={[
              @class ||
                [
                  "input-floating-control block w-full min-h-11 px-3 rounded-default border bg-transparent text-content focus:outline-none focus:border-brand focus:ring-2 focus:ring-brand disabled:overlay-dark disabled:text-subcontent disabled:cursor-not-allowed",
                  (@errors == [] || @error_class) && "border-outline",
                  @type == "password" && "pr-12"
                ],
              @errors != [] &&
                (@error_class || "border-error focus:border-error focus:ring-error")
            ]}
            {@rest}
          />
          <span class={[
            "input-floating-label",
            @errors != [] && "input-floating-label-error"
          ]}>
            {@label}<span
              :if={
                @rest[:required] && @rest[:disabled] in [nil, false] &&
                  @rest[:readonly] in [nil, false] && @label not in [nil, ""]
              }
              aria-hidden="true"
              class="input-required ml-1 text-error"
            >*</span>
          </span>
        </label>

        <.password_visibility_toggle
          :if={@type == "password" && @id not in [nil, ""]}
          id={@id}
          disabled={@rest[:disabled]}
        />
      </div>

      <.error :for={msg <- @errors}>{msg}</.error>
    </div>
  <% :input_text_control -> %>
    <div data-core-input>
      <div
        id={@type == "password" && @id not in [nil, ""] && "#{@id}-password-wrapper"}
        phx-hook={@type == "password" && @id not in [nil, ""] && "PasswordVisibility"}
        class="relative block"
      >
        <label for={@id} class="block">
          <span :if={@label} class="block text-sm font-medium text-content mb-1">{@label}<span
            :if={
              @rest[:required] && @rest[:disabled] in [nil, false] &&
                @rest[:readonly] in [nil, false] &&
                @label not in [nil, ""]
            }
            aria-hidden="true"
            class="input-required ml-1 text-error"
          >*</span></span>
          <input
            type={@type}
            name={@name}
            id={@id}
            value={Phoenix.HTML.Form.normalize_value(@type, @value)}
            class={[
              @class ||
                [
                  "block w-full min-h-11 px-3 py-2 rounded-default border bg-transparent text-content focus:outline-none focus:border-brand focus:ring-2 focus:ring-brand disabled:overlay-dark disabled:text-subcontent disabled:cursor-not-allowed",
                  (@errors == [] || @error_class) && "border-outline",
                  @type == "password" && "pr-12"
                ],
              @errors != [] &&
                (@error_class || "border-error focus:border-error focus:ring-error")
            ]}
            {@rest}
          />
        </label>

        <.password_visibility_toggle
          :if={@type == "password" && @id not in [nil, ""]}
          id={@id}
          disabled={@rest[:disabled]}
        />
      </div>

      <.error :for={msg <- @errors}>{msg}</.error>
    </div>
  <% :input_text -> %>
    <div data-core-input>
      <label for={@id} class="flex flex-col gap-1">
        <span
          :if={@label}
          class={["text-sm font-medium", (@errors != [] && "text-error") || "text-subcontent"]}
        >
          {@label}<span
            :if={
              @rest[:required] && @rest[:disabled] in [nil, false] &&
                @rest[:readonly] in [nil, false] &&
                @label not in [nil, ""]
            }
            aria-hidden="true"
            class="input-required ml-1 text-error"
          >*</span>
        </span>

        <input
          type={if @type == "password", do: "text", else: @type}
          name={@name}
          id={@id}
          value={Phoenix.HTML.Form.normalize_value(@type, @value)}
          class={@text_input_class}
          {@rest}
        />
      </label>

      <.error :for={msg <- @errors}>{msg}</.error>
    </div>
  <% :input_textarea_labeled -> %>
    <div data-core-input>
      <label for={@id} class="relative block">
        <textarea
          id={@id}
          name={@name}
          placeholder={@placeholder}
          class={[
            @class ||
              [
                "input-floating-control input-floating-textarea block w-full px-3 rounded-default border bg-transparent text-content focus:outline-none focus:border-brand focus:ring-2 focus:ring-brand disabled:overlay-dark disabled:text-subcontent disabled:cursor-not-allowed",
                (@errors == [] || @error_class) && "border-outline"
              ],
            @errors != [] && (@error_class || "border-error focus:border-error focus:ring-error")
          ]}
          {@rest}
        >{Phoenix.HTML.Form.normalize_value("textarea", @value)}</textarea>
        <span class={[
          "input-floating-label",
          @errors != [] && "input-floating-label-error"
        ]}>
          {@label}<span
            :if={
              @rest[:required] && @rest[:disabled] in [nil, false] &&
                @rest[:readonly] in [nil, false] &&
                @label not in [nil, ""]
            }
            aria-hidden="true"
            class="input-required ml-1 text-error"
          >*</span>
        </span>
      </label>

      <.error :for={msg <- @errors}>{msg}</.error>
    </div>
  <% :input_textarea -> %>
    <div data-core-input>
      <label for={@id} class="block">
        <textarea
          id={@id}
          name={@name}
          class={[
            @class ||
              [
                "block w-full px-3 py-2 rounded-default border bg-transparent text-content focus:outline-none focus:border-brand focus:ring-2 focus:ring-brand disabled:overlay-dark disabled:text-subcontent disabled:cursor-not-allowed",
                (@errors == [] || @error_class) && "border-outline"
              ],
            @errors != [] && (@error_class || "border-error focus:border-error focus:ring-error")
          ]}
          {@rest}
        >{Phoenix.HTML.Form.normalize_value("textarea", @value)}</textarea>
      </label>

      <.error :for={msg <- @errors}>{msg}</.error>
    </div>
  <% :input_textarea_text -> %>
    <div data-core-input>
      <label for={@id} class="flex flex-col gap-1">
        <span
          :if={@label}
          class={["text-sm font-medium", (@errors != [] && "text-error") || "text-subcontent"]}
        >
          {@label}<span
            :if={
              @rest[:required] && @rest[:disabled] in [nil, false] &&
                @rest[:readonly] in [nil, false] &&
                @label not in [nil, ""]
            }
            aria-hidden="true"
            class="input-required ml-1 text-error"
          >*</span>
        </span>
        <textarea id={@id} name={@name} class={@text_input_class} {@rest}>{Phoenix.HTML.Form.normalize_value("textarea", @value)}</textarea>
      </label>

      <.error :for={msg <- @errors}>{msg}</.error>
    </div>
  <% :password_visibility_toggle -> %>
    <button
      id={"#{@id}-password-toggle"}
      type="button"
      disabled={@disabled}
      aria-label="Show password"
      aria-pressed="false"
      aria-controls={@id}
      data-password-toggle
      class="absolute right-2 top-1/2 grid h-9 w-9 -translate-y-1/2 place-items-center rounded-default text-subcontent hover:overlay-dark focus:outline-none focus:ring-2 focus:ring-brand disabled:cursor-not-allowed disabled:text-subcontent"
    >
      <span id={"#{@id}-password-eye"} data-password-show-icon>
        <.icon name="hero-eye" class="h-5 w-5" />
      </span>

      <span id={"#{@id}-password-eye-slash"} data-password-hide-icon hidden>
        <.icon name="hero-eye-slash" class="h-5 w-5" />
      </span>
    </button>
  <% :input_number_text -> %>
    <%!-- Numeric controls --%>
    <div data-core-input>
      <div
        id={@number_id}
        phx-hook="NumberInput"
        class={["relative", @text_look && "flex flex-col gap-1"]}
      >
        <label
          :if={@text_look && @label}
          for={@id}
          class={["text-sm font-medium", (@errors != [] && "text-error") || "text-subcontent"]}
        >
          {@label}<span
            :if={
              @rest[:required] && @rest[:disabled] in [nil, false] &&
                @rest[:readonly] in [nil, false]
            }
            aria-hidden="true"
            class="input-required ml-1 text-error"
          >*</span>
        </label>

        <div class={[
          "number-input-control group/number grid grid-cols-[minmax(0,1fr)_1.75rem] items-center",
          !@text_look &&
            [
              "input-floating-wrapper min-h-11 ps-3 rounded-default border bg-transparent text-content focus-within:border-brand focus-within:ring-2 focus-within:ring-brand",
              (@errors == [] || @error_class) && "border-outline",
              @errors != [] &&
                (@error_class || "border-error focus-within:border-error focus-within:ring-error")
            ],
          @text_look && if(@label, do: "min-h-7", else: "min-h-11"),
          @rest[:disabled] && "overlay-dark cursor-not-allowed text-subcontent"
        ]}>
          <input
            type="number"
            id={@id}
            name={@name}
            value={Phoenix.HTML.Form.normalize_value("number", @value)}
            placeholder={@placeholder}
            class={[
              "[appearance:textfield]! [&::-webkit-inner-spin-button]:appearance-none [&::-webkit-inner-spin-button]:m-0 [&::-webkit-outer-spin-button]:appearance-none [&::-webkit-outer-spin-button]:m-0",
              @class ||
                [
                  "min-w-0 w-full border-0 bg-transparent p-0 text-sm text-content focus:outline-none focus:ring-0 disabled:text-subcontent disabled:cursor-not-allowed",
                  if(@text_look,
                    do: [
                      "py-1 focus-visible:underline",
                      !@label && "text-center",
                      @errors != [] && (@error_class || "text-error")
                    ],
                    else: "input-floating-control"
                  )
                ]
            ]}
            {@rest}
          />
          <div class={[
            "grid grid-cols-[1fr] grid-rows-[1fr_1fr] self-stretch border-l border-outline",
            @text_look &&
              "opacity-0 pointer-events-none group-hover/number:opacity-100 group-hover/number:pointer-events-auto has-[:focus-visible]:opacity-100 has-[:focus-visible]:pointer-events-auto"
          ]}>
            <button
              type="button"
              data-number-step="1"
              aria-label="Increase value"
              aria-controls={@id}
              disabled={@number_steps_disabled}
              class={[
                "button-base",
                "grid min-h-3.5 place-items-center rounded-none text-subcontent cursor-pointer hover:text-content focus-visible:outline-2 focus-visible:outline-brand disabled:cursor-not-allowed",
                !@text_look && "rounded-tr-default hover:overlay-dark"
              ]}
            >
              <.icon name="hero-chevron-up-micro" class="size-3" />
            </button>

            <button
              type="button"
              data-number-step="-1"
              aria-label="Decrease value"
              aria-controls={@id}
              disabled={@number_steps_disabled}
              class={[
                "button-base",
                "grid min-h-3.5 place-items-center rounded-none border-t border-outline text-subcontent cursor-pointer hover:text-content focus-visible:outline-2 focus-visible:outline-brand disabled:cursor-not-allowed",
                !@text_look && "rounded-br-default hover:overlay-dark"
              ]}
            >
              <.icon name="hero-chevron-down-micro" class="size-3" />
            </button>
          </div>
        </div>

        <label
          :if={!@text_look && @label}
          for={@id}
          class={[
            "input-floating-label",
            @errors != [] && "input-floating-label-error"
          ]}
        >
          {@label}<span
            :if={
              @rest[:required] && @rest[:disabled] in [nil, false] &&
                @rest[:readonly] in [nil, false]
            }
            aria-hidden="true"
            class="input-required ml-1 text-error"
          >*</span>
        </label>
      </div>

      <.error :for={msg <- @errors}>{msg}</.error>
    </div>
  <% :input_checkbox -> %>
    <%!-- Boolean controls --%>
    <div data-core-input>
      <label
        for={@id}
        class={[
          "group cursor-pointer grid grid-cols-[1fr_1.25rem] items-center gap-2 w-full min-h-11 px-3 rounded-default border bg-transparent text-content focus-within:border-brand focus-within:ring-2 focus-within:ring-brand",
          (@errors == [] || @error_class) && "border-outline",
          "has-[:disabled]:overlay-dark has-[:disabled]:cursor-not-allowed has-[:disabled]:text-subcontent",
          @errors != [] &&
            (@error_class || "border-error focus-within:border-error focus-within:ring-error")
        ]}
      >
        <span class="text-sm font-medium text-content group-has-[:disabled]:text-subcontent">
          {@label}<span
            :if={
              @rest[:required] && @rest[:disabled] in [nil, false] &&
                @rest[:readonly] in [nil, false] &&
                @label not in [nil, ""]
            }
            aria-hidden="true"
            class="input-required ml-1 text-error"
          >*</span>
        </span>

        <div class="flex items-center gap-2">
          <input
            type="hidden"
            name={@name}
            value="false"
            disabled={@rest[:disabled]}
            form={@rest[:form]}
          />
          <input
            type="checkbox"
            id={@id}
            name={@name}
            value="true"
            checked={@checked}
            class={
              @class ||
                "appearance-none h-5 w-5 shrink-0 rounded-default border border-outline bg-transparent text-content checked:bg-brand checked:border-brand checked:text-content-inverse dark:checked:text-content focus:ring-0 focus:outline-none disabled:cursor-not-allowed disabled:border-outline disabled:checked:bg-secondary disabled:checked:border-secondary disabled:checked:text-content checked:bg-control-check bg-center bg-no-repeat bg-[length:100%_100%]"
            }
            {@rest}
          />
        </div>
      </label>

      <.error :for={msg <- @errors}>{msg}</.error>
    </div>
  <% :input_checkbox_alt -> %>
    <div data-core-input>
      <label
        for={@id}
        class={[
          "grid w-fit grid-cols-[1.25rem_1fr] items-center gap-2 text-sm font-medium text-content",
          "has-[:disabled]:cursor-not-allowed has-[:disabled]:text-subcontent",
          @errors != [] && (@error_class || "text-error")
        ]}
      >
        <input
          type="hidden"
          name={@name}
          value="false"
          disabled={@rest[:disabled]}
          form={@rest[:form]}
        />
        <input
          type="checkbox"
          id={@id}
          name={@name}
          value="true"
          checked={@checked}
          class={
            @class ||
              "appearance-none h-5 w-5 shrink-0 cursor-pointer rounded-default border border-outline bg-transparent text-content checked:bg-brand checked:border-brand checked:text-content-inverse dark:checked:text-content focus:outline-none focus:ring-2 focus:ring-brand disabled:overlay-dark disabled:cursor-not-allowed disabled:border-outline disabled:checked:bg-secondary disabled:checked:border-secondary disabled:checked:text-content checked:bg-control-check bg-center bg-no-repeat bg-[length:100%_100%]"
          }
          {@rest}
        />
        <span>{@label}<span
          :if={
            @rest[:required] && @rest[:disabled] in [nil, false] &&
              @rest[:readonly] in [nil, false] &&
              @label not in [nil, ""]
          }
          aria-hidden="true"
          class="input-required ml-1 text-error"
        >*</span></span>
      </label>

      <.error :for={msg <- @errors}>{msg}</.error>
    </div>
  <% :input_switch -> %>
    <div data-core-input>
      <label
        for={@id}
        class={[
          "group cursor-pointer grid grid-cols-[1fr_2.75rem] items-center gap-2 w-full min-h-11 px-3 rounded-default border bg-transparent text-content focus-within:border-brand focus-within:ring-2 focus-within:ring-brand",
          (@errors == [] || @error_class) && "border-outline",
          "has-[:disabled]:overlay-dark has-[:disabled]:cursor-not-allowed has-[:disabled]:text-subcontent",
          @errors != [] &&
            (@error_class || "border-error focus-within:border-error focus-within:ring-error")
        ]}
      >
        <span class="text-sm font-medium text-content group-has-[:disabled]:text-subcontent">
          {@label}<span
            :if={
              @rest[:required] && @rest[:disabled] in [nil, false] &&
                @rest[:readonly] in [nil, false] &&
                @label not in [nil, ""]
            }
            aria-hidden="true"
            class="input-required ml-1 text-error"
          >*</span>
        </span>

        <div class="flex items-center gap-2">
          <input
            type="hidden"
            name={@name}
            value="false"
            disabled={@rest[:disabled]}
            form={@rest[:form]}
          />
          <input
            type="checkbox"
            id={@id}
            name={@name}
            value="true"
            checked={@checked}
            class={
              @class ||
                "peer appearance-none shrink-0 w-11 h-6 rounded-full border border-outline bg-transparent text-content checked:bg-brand checked:border-brand checked:text-content-inverse dark:checked:text-content focus:outline-none focus:ring-0 disabled:cursor-not-allowed disabled:checked:bg-secondary disabled:checked:border-secondary disabled:checked:text-content transition-colors duration-200 ease-in-out relative before:absolute before:top-[1px] before:left-[1px] before:h-5 before:w-5 before:rounded-full before:bg-subcontent checked:before:translate-x-5 checked:before:bg-content-inverse dark:checked:before:bg-content disabled:checked:before:bg-subcontent before:transition-transform before:duration-200 before:ease-in-out"
            }
            {@rest}
          />
        </div>
      </label>

      <.error :for={msg <- @errors}>{msg}</.error>
    </div>
  <% :input_switch_alt -> %>
    <div data-core-input>
      <label
        for={@id}
        class={
          [
            "grid grid-cols-[2.75rem_1fr] items-center gap-2 text-sm font-medium text-content",
            "has-[:disabled]:cursor-not-allowed has-[:disabled]:text-subcontent",
            # Unlabeled means it sits in a row under its column heading, so it centers on the column and takes the field height.
            (@label in [nil, ""] && "min-h-11 w-full justify-center") || "w-fit",
            @errors != [] && (@error_class || "text-error")
          ]
        }
      >
        <input
          type="hidden"
          name={@name}
          value="false"
          disabled={@rest[:disabled]}
          form={@rest[:form]}
        />
        <input
          type="checkbox"
          id={@id}
          name={@name}
          value="true"
          checked={@checked}
          class={
            @class ||
              "peer appearance-none shrink-0 cursor-pointer w-11 h-6 rounded-full border border-outline bg-transparent text-content checked:bg-brand checked:border-brand checked:text-content-inverse dark:checked:text-content focus:outline-none focus:ring-2 focus:ring-brand disabled:overlay-dark disabled:cursor-not-allowed disabled:checked:bg-secondary disabled:checked:border-secondary disabled:checked:text-content transition-colors duration-200 ease-in-out relative before:absolute before:top-[1px] before:left-[1px] before:h-5 before:w-5 before:rounded-full before:bg-subcontent checked:before:translate-x-5 checked:before:bg-content-inverse dark:checked:before:bg-content disabled:checked:before:bg-subcontent before:transition-transform before:duration-200 before:ease-in-out"
          }
          {@rest}
        />
        <span :if={@label not in [nil, ""]}>{@label}<span
          :if={
            @rest[:required] && @rest[:disabled] in [nil, false] &&
              @rest[:readonly] in [nil, false] &&
              @label not in [nil, ""]
          }
          aria-hidden="true"
          class="input-required ml-1 text-error"
        >*</span></span>
      </label>

      <.error :for={msg <- @errors}>{msg}</.error>
    </div>
  <% :input_radio_text -> %>
    <%!-- Checkbox and switch text and display --%>
    <div data-core-input>
      <.dynamic_tag
        tag_name={if @text_editable, do: "label", else: "span"}
        data-boolean-text
        class={[
          "group/boolean",
          @class ||
            [
              "block text-sm bg-transparent",
              if(@label in [nil, ""],
                do: "w-full min-h-11 content-center text-center",
                else: "w-fit min-h-6 py-1"
              ),
              if(@rest[:disabled],
                do: "text-subcontent cursor-not-allowed",
                else: "text-content"
              ),
              @text_editable && @rest[:disabled] in [false, nil] && "cursor-pointer",
              @text_editable && "has-[input:focus-visible]:underline",
              @errors != [] && (@error_class || "text-error")
            ]
        ]}
        {@text_rest}
      >
        <input
          :if={@text_editable}
          type="hidden"
          name={@name}
          value="false"
          disabled={@rest[:disabled]}
          form={@rest[:form]}
        />
        <input
          :if={@text_editable}
          type="checkbox"
          id={@id}
          name={@name}
          value="true"
          checked={@checked}
          class="sr-only"
          {@rest}
        /> {@label}{if @label not in [nil, ""], do: " is "}<span
          :if={@text_editable}
          data-boolean-state="checked"
          class="hidden group-has-[input:checked]/boolean:inline"
        >{@checked_text}</span><span
          :if={@text_editable}
          data-boolean-state="unchecked"
          class="group-has-[input:checked]/boolean:hidden"
        >{@unchecked_text}</span><span
          :if={!@text_editable}
          data-boolean-state={if @checked, do: "checked", else: "unchecked"}
        >{if @checked, do: @checked_text, else: @unchecked_text}</span><span
          :if={
            @rest[:required] && @rest[:disabled] in [nil, false] &&
              @rest[:readonly] in [nil, false] &&
              @text_editable && @label not in [nil, ""]
          }
          aria-hidden="true"
          class="input-required ml-1 text-error"
        >*</span>
      </.dynamic_tag>

      <.error :for={msg <- @errors}>{msg}</.error>

      <div :if={!@text_editable} class="hidden">
        {input(assign(assigns, render_as: "enabled", label: nil))}
      </div>
    </div>
  <% :input_boolean_display -> %>
    <div data-core-input>
      <div
        id={if @render_as != "like-disabled", do: @id}
        class={[
          if(@display_alt,
            do: [
              "inline-grid items-center gap-2 text-sm font-medium",
              (@type == "switch" && "grid-cols-[2.75rem_1fr]") || "grid-cols-[1.25rem_1fr]",
              @type == "switch" && @label in [nil, ""] && "min-h-11 w-full justify-center"
            ],
            else: [
              "grid items-center gap-2 w-full min-h-11 px-3 rounded-default border bg-transparent",
              (@errors == [] || @error_class) && "border-outline",
              (@type == "switch" && "grid-cols-[1fr_2.75rem]") || "grid-cols-[1fr_1.25rem]",
              @disabled_look && "overlay-dark"
            ]
          ),
          @disabled_look && "cursor-not-allowed",
          @errors != [] &&
            (@error_class || if(@display_alt, do: "text-error", else: "border-error"))
        ]}
        {@span_rest}
      >
        <span :if={@display_alt} class={@class || @box_class} />
        <span
          :if={!@display_alt || @label not in [nil, ""]}
          class={[
            "text-sm font-medium",
            (@disabled_look && "text-subcontent") || "text-content"
          ]}
        >
          {@label}<span
            :if={
              @rest[:required] && @rest[:disabled] in [nil, false] &&
                @rest[:readonly] in [nil, false] &&
                @render_as == "like-enabled" && @label not in [nil, ""]
            }
            aria-hidden="true"
            class="input-required ml-1 text-error"
          >*</span>
        </span>
        <span :if={!@display_alt} class={@class || @box_class} />
      </div>

      <.error :for={msg <- @errors}>{msg}</.error>

      <div :if={@render_as == "like-disabled"} class="hidden">
        {input(assign(assigns, render_as: "enabled", label: nil))}
      </div>
    </div>
  <% :input_radio -> %>
    <%!-- Radio choices --%>
    <fieldset
      data-core-input
      id={@id}
      class="group"
      disabled={@rest[:disabled]}
      {@radio_group_rest}
    >
      <legend
        :if={@label}
        class={[
          "mb-1 text-sm font-medium",
          if(@rest[:disabled], do: "text-subcontent", else: "text-content")
        ]}
      >
        {@label}<span
          :if={
            @rest[:required] && @rest[:disabled] in [nil, false] &&
              @rest[:readonly] in [nil, false] &&
              @label not in [nil, ""]
          }
          aria-hidden="true"
          class="input-required ml-1 text-error"
        >*</span>
      </legend>

      <div
        class={
          if @variant == "card",
            do: "grid grid-cols-[repeat(var(--radio-options),max-content)] gap-4",
            else: "flex flex-col gap-3"
        }
        style={@variant == "card" && "--radio-options: #{length(@radio_options)}"}
      >
        <label
          :for={option <- @radio_options}
          class={[
            if(@variant == "card",
              do: [
                "relative grid grid-cols-[minmax(0,1fr)] cursor-pointer rounded-default border bg-transparent px-4 py-2 text-center text-sm text-content has-[:checked]:bg-secondary has-[:focus-visible]:ring-2 has-[:disabled]:cursor-not-allowed has-[:disabled]:opacity-50",
                @errors == [] &&
                  "border-outline has-[:checked]:border-brand has-[:focus-visible]:ring-brand",
                @errors != [] &&
                  (@error_class ||
                     "border-error has-[:checked]:border-error has-[:focus-visible]:ring-error")
              ],
              else: [
                "grid grid-cols-[1.25rem_1fr] items-center gap-2 text-sm text-content",
                "has-[:disabled]:cursor-not-allowed has-[:disabled]:text-subcontent",
                @errors != [] && (@error_class || "text-error")
              ]
            )
          ]}
        >
          <input
            type="radio"
            name={@name}
            value={to_string(option.value)}
            checked={to_string(@value) == to_string(option.value)}
            class={
              if @variant == "card",
                do: ["sr-only", @class],
                else:
                  @class ||
                    "appearance-none h-5 w-5 shrink-0 cursor-pointer rounded-full border border-outline bg-transparent text-content checked:border-brand checked:bg-brand checked:text-content-inverse dark:checked:text-content focus:outline-none focus:ring-2 focus:ring-brand disabled:overlay-dark disabled:cursor-not-allowed disabled:checked:bg-secondary disabled:checked:border-secondary disabled:checked:text-content checked:bg-control-radio"
            }
            disabled={@rest[:disabled] || option.disabled}
            {@radio_rest}
          />
          <span class="grid grid-cols-[minmax(0,1fr)]">
            <span class={@variant == "card" && "font-semibold"}>{option.label}</span>
            <span :if={option.description} class="text-xs text-subcontent">
              {option.description}
            </span>
          </span>
        </label>
      </div>

      <.error :for={msg <- @errors}>{msg}</.error>
    </fieldset>
  <% :input_select -> %>
    <%!-- Selections --%>
    <div data-core-input>
      <label for={@id} class={if @text_look, do: "flex flex-col gap-1", else: "relative block"}>
        <span :if={@text_look && @label} class="text-sm font-medium text-subcontent">
          {@label}<span
            :if={
              @rest[:required] && @rest[:disabled] in [nil, false] &&
                @rest[:readonly] in [nil, false]
            }
            aria-hidden="true"
            class="input-required ml-1 text-error"
          >*</span>
        </span>

        <select
          id={@id}
          name={@name}
          class={[
            "input-native-select",
            @errors != [] && !@error_class && "input-native-select-error",
            @class ||
              if(@text_look,
                do: [
                  "block w-full appearance-none border-0 bg-transparent text-sm text-content focus:outline-none focus:ring-0 focus-visible:underline disabled:text-subcontent disabled:cursor-not-allowed",
                  if(@label, do: "min-h-6 py-1", else: "min-h-11 text-center")
                ],
                else: [
                  "block w-full min-h-11 px-3 py-2 rounded-default border bg-transparent text-sm text-content focus:outline-none focus:border-brand focus:ring-2 focus:ring-brand disabled:overlay-dark disabled:text-subcontent disabled:cursor-not-allowed",
                  (@errors == [] || @error_class) && "border-outline",
                  "input-floating-control"
                ]
              ),
            @errors != [] && (@error_class || "border-error focus:border-error focus:ring-error")
          ]}
          {@rest}
        >
          <option :if={@prompt} value="">{@select_prompt}</option>
          {Phoenix.HTML.Form.options_for_select(@options, @value)}
        </select>

        <span
          :if={!@text_look && @label}
          class={["input-floating-label", @errors != [] && "input-floating-label-error"]}
        >
          {@label}<span
            :if={
              @rest[:required] && @rest[:disabled] in [nil, false] &&
                @rest[:readonly] in [nil, false]
            }
            aria-hidden="true"
            class="input-required ml-1 text-error"
          >*</span>
        </span>
      </label>

      <.error :for={msg <- @errors}>{msg}</.error>
    </div>
  <% :input_combobox -> %>
    <div data-core-input {@picker_rest}>
      <div class={if @text_look, do: "flex flex-col gap-1", else: "relative block"}>
        <label
          :if={@text_look && @label}
          for={"#{@picker_id}-input"}
          class={["text-sm font-medium", (@errors != [] && "text-error") || "text-subcontent"]}
        >
          {@label}<span
            :if={
              @rest[:required] && @rest[:disabled] in [nil, false] &&
                @rest[:readonly] in [nil, false]
            }
            aria-hidden="true"
            class="input-required ml-1 text-error"
          >*</span>
        </label>

        <input
          :if={@rest[:multiple]}
          type="hidden"
          name={String.trim_trailing(@name, "[]") <> "[]"}
          value=""
          disabled={@rest[:disabled] || @rest[:readonly]}
          form={@rest[:form]}
        />
        <PetalComponents.ComboBox.combo_box
          id={@picker_id}
          name={@name}
          value={@value}
          options={@options}
          multiple={@rest[:multiple] not in [nil, false]}
          clearable={@clearable}
          max_items={@max_items}
          label={@label || @rest[:"aria-label"]}
          placeholder={@placeholder}
          required={@rest[:required] not in [nil, false]}
          disabled={@rest[:disabled] not in [nil, false] || @rest[:readonly] not in [nil, false]}
          form_id={@rest[:form]}
          class={[
            @class,
            if(@text_look,
              do: "input-text-wrapper",
              else: "input-select-wrapper input-floating-wrapper"
            ),
            @text_look && @label && "input-text-label",
            @rest[:multiple] && "input-floating-wrapper-tags",
            @errors != [] && (@error_class || "input-combobox-error")
          ]}
        />
        <label
          :if={!@text_look && @label}
          for={"#{@picker_id}-input"}
          class={[
            "input-floating-label",
            @errors != [] && "input-floating-label-error"
          ]}
        >
          {@label}<span
            :if={
              @rest[:required] && @rest[:disabled] in [nil, false] &&
                @rest[:readonly] in [nil, false]
            }
            aria-hidden="true"
            class="input-required ml-1 text-error"
          >*</span>
        </label>
      </div>

      <.error :for={msg <- @errors}>{msg}</.error>
    </div>
  <% :input_combobox_disabled -> %>
    <div {@div_attrs}>
      <.input
        id={@id}
        name={@name}
        type="text"
        label={assigns[:label]}
        render_as={@render_as}
        value={@display}
        disabled
        required={@rest[:required]}
        class={@class}
        error_class={@error_class}
        errors={@errors}
      /> <input :for={v <- @hidden_values} type="hidden" name={@hidden_name} value={v} />
    </div>
  <% :input_color -> %>
    <%!-- Color controls --%>
    <div data-core-input>
      <div
        id={@color_id}
        phx-hook="ColorInput"
        data-color-editable={to_string(@color_editable)}
        data-color-server-invalid={to_string(@errors != [])}
        data-color-space-name={@color_format_field.name}
        data-color-space-id={@color_format_id}
        data-color-state={Jason.encode!(@color_state)}
        class={["relative", @text_look && "flex flex-col gap-1"]}
      >
        <label
          :if={@text_look && @label}
          for={if @color_editable, do: @id}
          class={["text-sm font-medium", (@errors != [] && "text-error") || "text-subcontent"]}
        >
          {@label}<span
            :if={
              @rest[:required] && @rest[:disabled] in [nil, false] &&
                @rest[:readonly] in [nil, false] &&
                (@color_editable || @render_as == "like-enabled") && @label not in [nil, ""]
            }
            aria-hidden="true"
            class="input-required ml-1 text-error"
          >*</span>
        </label>

        <div class={[
          "color-input-control grid grid-cols-[1.5rem_minmax(0,1fr)_6rem] items-center gap-2",
          !@text_look &&
            [
              "input-floating-wrapper min-h-11 ps-3 rounded-default border bg-transparent text-content focus-within:border-brand focus-within:ring-2 focus-within:ring-brand",
              !@color_editable && "pe-3",
              (@errors == [] || @error_class) && "border-outline",
              @errors != [] &&
                (@error_class || "border-error focus-within:border-error focus-within:ring-error")
            ],
          @text_look && if(@label, do: "min-h-6", else: "min-h-11"),
          (@disabled_look || @rest[:disabled]) &&
            "overlay-dark cursor-not-allowed text-subcontent"
        ]}>
          <button
            :if={@color_editable}
            type="button"
            aria-label="Choose color"
            aria-haspopup="dialog"
            popovertarget={@color_popover_id}
            data-color-trigger
            disabled={@rest[:disabled] || @rest[:readonly]}
            class="button-base size-6 rounded-none cursor-pointer disabled:cursor-not-allowed"
          >
            <span
              data-color-swatch
              aria-hidden="true"
              class="color-input-swatch block size-full border border-outline"
              style={if @color_swatch, do: "--input-color: #{@color_swatch}"}
            />
          </button>

          <span
            :if={!@color_editable}
            data-color-swatch
            aria-hidden="true"
            class="color-input-swatch block size-6 border border-outline"
            style={if @color_swatch, do: "--input-color: #{@color_swatch}"}
          />
          <input
            :if={@color_editable}
            type="text"
            id={@id}
            name={@name}
            value={@value}
            data-color-value
            placeholder={@placeholder}
            spellcheck="false"
            aria-invalid={if @errors != [], do: "true"}
            class={
              @class ||
                [
                  "min-w-0 w-full appearance-none bg-transparent border-0 p-0 text-sm text-content focus:outline-none focus:ring-0 disabled:text-subcontent disabled:cursor-not-allowed",
                  !@text_look && "input-floating-control",
                  @text_look && "py-1 focus-visible:underline"
                ]
            }
            {@rest}
          />
          <span
            :if={!@color_editable}
            id={if !@include_hidden_input, do: @id}
            data-color-value
            class={@class || "min-w-0 overflow-hidden text-ellipsis whitespace-nowrap text-sm"}
          >{if @value == "" && @render_as == "like-enabled" && @label in [nil, ""],
            do: @placeholder,
            else: @value}</span>
          <span
            :if={!@color_editable}
            data-color-format
            class="min-w-0 truncate text-sm text-content"
            aria-live="polite"
          >
            {@color_format}
          </span>

          <div
            :if={@color_editable}
            id={"#{@color_format_id}_dropdown"}
            data-color-space-select
            class={[
              "min-w-0 self-stretch",
              !@text_look && "border-l border-outline"
            ]}
          >
            <label for={"#{@color_format_id}-input"} class="sr-only">Color space</label>
            <PetalComponents.ComboBox.combo_box
              field={@color_format_field}
              id={@color_format_id}
              options={@color_format_options}
              value={@color_format_field.value}
              label="Color space"
              disabled={
                @rest[:disabled] not in [false, nil] || @rest[:readonly] not in [false, nil]
              }
              clearable={false}
              form_id={@rest[:form]}
              class={[
                ~S"[--combobox-min-width:18rem] [&>.pc-combo-box\_\_control]:grid-cols-[minmax(0,1fr)_0.75rem]! [&>.pc-combo-box\_\_control]:gap-0!",
                ~S"[&>.pc-combo-box\_\_control]:rounded-l-none! [&>.pc-combo-box\_\_control]:border-0! [&>.pc-combo-box\_\_control]:min-h-10.5! [&>.pc-combo-box\_\_control]:pr-1!",
                ~S"[&_.pc-combo-box\_\_input]:px-2! [&>.pc-combo-box\_\_control>.pc-combo-box\_\_chevron]:size-3!",
                ~S"[&_.pc-combo-box\_\_panel]:[position-area:block-end_span-inline-start]! [&_.pc-combo-box\_\_panel[data-flip]]:[position-area:block-start_span-inline-start]!",
                @text_look && "input-text-wrapper",
                @text_look && @label && "input-text-label"
              ]}
            />
          </div>
        </div>

        <label
          :if={!@text_look && @label}
          for={if @color_editable, do: @id}
          class={[
            "input-floating-label color-input-label",
            @errors != [] && "input-floating-label-error",
            !@color_editable && (@value != "" || @render_as != "like-enabled") &&
              "color-input-label-filled"
          ]}
        >
          {@label}<span
            :if={
              @rest[:required] && @rest[:disabled] in [nil, false] &&
                @rest[:readonly] in [nil, false] &&
                (@color_editable || @render_as == "like-enabled") && @label not in [nil, ""]
            }
            aria-hidden="true"
            class="input-required ml-1 text-error"
          >*</span>
        </label>

        <div
          :if={@color_editable}
          id={@color_popover_id}
          popover="auto"
          role="dialog"
          aria-label="Choose color"
          data-color-popover
          class="color-input-popover w-60 max-h-[calc(100%_-_0.5rem)] overflow-y-auto rounded-default border border-outline bg-surface p-3 text-content"
        >
          <rgba-color-picker
            id={@color_picker_id}
            data-color-picker
            phx-update="ignore"
            class="h-52 w-full"
          />
        </div>

        <p
          id={@color_error_id}
          data-color-error
          hidden
          aria-live="polite"
          class="mt-2 text-sm text-error"
        />
        <input
          :if={@include_hidden_input}
          type="hidden"
          id={@id}
          name={@name}
          value={@value}
          {@rest}
        />
      </div>

      <.error :for={msg <- @errors}>{msg}</.error>
    </div>
  <% :input_calendar_labeled -> %>
    <%!-- Date and time controls --%>
    <div data-core-input>
      <div class={if @text_look, do: "flex flex-col gap-1", else: "relative block"}>
        <label
          :if={@text_look}
          for={@id}
          class={["text-sm font-medium", (@errors != [] && "text-error") || "text-subcontent"]}
        >
          {@label}<span
            :if={
              @rest[:required] && @rest[:disabled] in [nil, false] &&
                @rest[:readonly] in [nil, false] &&
                @label not in [nil, ""]
            }
            aria-hidden="true"
            class="input-required ml-1 text-error"
          >*</span>
        </label>

        <input
          type="text"
          name={@name}
          id={@id}
          value={@value}
          placeholder={@placeholder}
          data-vc-mode={@type}
          data-vc-value={@value || ""}
          data-vc-timezone={@timezone}
          data-vc-today={@today}
          aria-haspopup="dialog"
          aria-expanded="false"
          aria-controls={"#{@id}-calendar"}
          phx-hook="VCalendar"
          phx-mounted={JS.ignore_attributes(["value", "aria-haspopup", "aria-expanded"])}
          readonly
          class={[
            @class ||
              if @text_look do
                "block w-full min-h-6 py-1 appearance-none bg-transparent border-0 text-sm text-content overflow-hidden text-ellipsis whitespace-nowrap cursor-pointer focus:outline-none focus:ring-0 focus-visible:underline disabled:overlay-dark disabled:text-subcontent disabled:cursor-not-allowed"
              else
                [
                  "input-floating-control block w-full min-h-11 px-3 rounded-default border bg-transparent text-content focus:outline-none focus:border-brand focus:ring-2 focus:ring-brand disabled:overlay-dark disabled:text-subcontent disabled:cursor-not-allowed",
                  (@errors == [] || @error_class) && "border-outline"
                ]
              end,
            @errors != [] &&
              (@error_class ||
                 if(@text_look,
                   do: "text-error",
                   else: "border-error focus:border-error focus:ring-error"
                 ))
          ]}
          {@rest}
        />
        <span
          :if={not @text_look}
          class={[
            "input-floating-label",
            @errors != [] && "input-floating-label-error"
          ]}
        >
          {@label}<span
            :if={
              @rest[:required] && @rest[:disabled] in [nil, false] &&
                @rest[:readonly] in [nil, false] &&
                @label not in [nil, ""]
            }
            aria-hidden="true"
            class="input-required ml-1 text-error"
          >*</span>
        </span>
      </div>

      <div
        id={"#{@id}-calendar"}
        popover="auto"
        data-calendar-popover
        data-vc="calendar"
        data-vc-theme="elixirbits"
        data-vc-mode={@type}
        aria-label={@label || "Calendar"}
        phx-update="ignore"
      />
      <.error :for={msg <- @errors}>{msg}</.error>
    </div>
  <% :input_calendar -> %>
    <div data-core-input>
      <input
        type="text"
        name={@name}
        id={@id}
        value={@value}
        data-vc-mode={@type}
        data-vc-value={@value || ""}
        data-vc-timezone={@timezone}
        data-vc-today={@today}
        aria-haspopup="dialog"
        aria-expanded="false"
        aria-controls={"#{@id}-calendar"}
        phx-hook="VCalendar"
        phx-mounted={JS.ignore_attributes(["value", "aria-haspopup", "aria-expanded"])}
        readonly
        class={[
          @class ||
            if @text_look do
              "block w-full min-h-11 text-center appearance-none bg-transparent border-0 text-sm text-content overflow-hidden text-ellipsis whitespace-nowrap cursor-pointer focus:outline-none focus:ring-0 focus-visible:underline disabled:overlay-dark disabled:text-subcontent disabled:cursor-not-allowed"
            else
              [
                "block w-full min-h-11 px-3 py-2 rounded-default border bg-transparent text-content focus:outline-none focus:border-brand focus:ring-2 focus:ring-brand disabled:overlay-dark disabled:text-subcontent disabled:cursor-not-allowed",
                (@errors == [] || @error_class) && "border-outline"
              ]
            end,
          @errors != [] &&
            (@error_class ||
               if(@text_look,
                 do: "text-error",
                 else: "border-error focus:border-error focus:ring-error"
               ))
        ]}
        {@rest}
      />
      <div
        id={"#{@id}-calendar"}
        popover="auto"
        data-calendar-popover
        data-vc="calendar"
        data-vc-theme="elixirbits"
        data-vc-mode={@type}
        aria-label="Calendar"
        phx-update="ignore"
      />
      <.error :for={msg <- @errors}>{msg}</.error>
    </div>
  <% :input_tel -> %>
    <%!-- Telephone controls --%>
    <div data-core-input>
      <div
        id={@wrapper_id}
        phx-hook="TelInput"
        data-countries={@countries_json}
        data-country-name={@country_name}
        class={[
          "relative",
          @text_look && "flex flex-col gap-1",
          !@text_look &&
            [
              "[&>.input-floating-label]:!left-[5.25rem]",
              "[&:focus-within>.input-floating-label]:!left-3",
              "[&:has([data-tel-number]:disabled)>.input-floating-label]:!left-3",
              "[&:has(.input-floating-control:not(:placeholder-shown))>.input-floating-label]:!left-3"
            ]
        ]}
      >
        <label
          :if={@text_look && @label}
          for={@id}
          class={["text-sm font-medium", (@errors != [] && "text-error") || "text-subcontent"]}
        >
          {@label}<span
            :if={
              @rest[:required] && @rest[:disabled] in [nil, false] &&
                @rest[:readonly] in [nil, false] &&
                @label not in [nil, ""]
            }
            aria-hidden="true"
            class="input-required ml-1 text-error"
          >*</span>
        </label>

        <input
          type="hidden"
          name={@name}
          value={@composite_value}
          disabled={@rest[:disabled]}
          form={@rest[:form]}
          data-tel-composite
        />
        <div class={
          if @text_look,
            do: "grid grid-cols-[4.5rem_1fr] gap-0",
            else: "input-floating-wrapper grid grid-cols-[4.5rem_auto] gap-0"
        }>
          <div id={"#{@country_id}_country_dropdown"}>
            <PetalComponents.ComboBox.combo_box
              field={@country_field}
              id={"#{@country_id}_country_select"}
              variant="trigger"
              options={@country_options}
              value={@country_field.value}
              label="Country calling code"
              search_placeholder="Search countries"
              placeholder={@country_placeholder}
              disabled={
                @rest[:disabled] not in [false, nil] || @rest[:readonly] not in [false, nil]
              }
              clearable={false}
              form_id={@rest[:form]}
              class={[
                ~S"[--combobox-min-width:18rem] [&>.pc-combo-box\_\_trigger]:grid-cols-[minmax(0,1fr)_0.75rem]! [&>.pc-combo-box\_\_trigger]:gap-0!",
                ~S"[&>.pc-combo-box\_\_trigger>.pc-combo-box\_\_chevron]:size-3!",
                !@text_look &&
                  [
                    ~S"[&>.pc-combo-box\_\_trigger]:rounded-r-none! [&>.pc-combo-box\_\_trigger]:border-r-0!",
                    ~S"[&>.pc-combo-box\_\_trigger]:ps-3! [&>.pc-combo-box\_\_trigger]:pe-1! [&>.pc-combo-box\_\_trigger]:py-2!"
                  ],
                @text_look && "input-text-wrapper",
                @text_look && @label && "input-text-label"
              ]}
            >
              <:selected :let={selected}>
                <span :for={option <- selected}>{option.meta.dial_code}</span>
              </:selected>
            </PetalComponents.ComboBox.combo_box>
          </div>

          <input
            type="tel"
            id={@id}
            value={@number_value}
            placeholder={@placeholder}
            data-tel-number
            class={[
              @class ||
                if(@text_look,
                  do: [
                    "block w-full appearance-none border-0 bg-transparent text-sm text-content overflow-hidden text-ellipsis whitespace-nowrap focus:outline-none focus:ring-0 focus-visible:underline disabled:overlay-dark disabled:cursor-not-allowed disabled:text-subcontent",
                    if(@label, do: "min-h-6 py-1", else: "min-h-11"),
                    @errors != [] && (@error_class || "text-error")
                  ],
                  else: [
                    "input-floating-control block w-full min-h-11 px-3 rounded-r-default border bg-transparent text-content focus:outline-none focus:border-brand focus:ring-2 focus:ring-brand disabled:overlay-dark disabled:text-subcontent disabled:cursor-not-allowed",
                    (@errors == [] || @error_class) && "border-outline"
                  ]
                ),
              !@text_look && @errors != [] &&
                (@error_class || "border-error focus:border-error focus:ring-error")
            ]}
            {@rest}
          />
        </div>

        <label
          :if={!@text_look}
          for={@id}
          class={[
            "input-floating-label",
            @errors != [] && "input-floating-label-error"
          ]}
        >
          {@label}<span
            :if={
              @rest[:required] && @rest[:disabled] in [nil, false] &&
                @rest[:readonly] in [nil, false] &&
                @label not in [nil, ""]
            }
            aria-hidden="true"
            class="input-required ml-1 text-error"
          >*</span>
        </label>
      </div>

      <.error :for={msg <- @errors}>{msg}</.error>
    </div>
  <% :error -> %>
    <%!-- Validation --%>
    <p class="mt-1.5 flex gap-2 items-center text-sm text-error">
      <.icon name="hero-exclamation-circle" class="size-5" /> {render_slot(@inner_block)}
    </p>
  <% :input_file -> %>
    <%!-- File uploads and previews --%>
    <div
      data-core-input
      id={"#{@file_id}-file-input"}
      phx-hook="FileInput"
      data-file-preview={to_string(@preview)}
      data-file-preview-as={@preview_as}
      data-file-editor={@file_editor}
      data-file-selection={@selection}
      data-file-upload-name={@upload && @upload.name}
      data-file-entry-refs={@file_entry_refs}
      data-file-max-entries={@upload && @upload.max_entries}
      data-file-max-size={@upload && @upload.max_file_size}
      data-file-mode={@render_as}
      data-file-has-value={to_string(@file_has_value)}
      data-file-has-placeholder={to_string(@file_has_placeholder)}
      data-file-editable-like={to_string(@file_editable_like)}
      class={[
        "relative",
        @render_as in ["hidden", "hidden-enabled", "hidden-disabled"] && "hidden",
        @text_look && "group/upload"
      ]}
    >
      <div
        data-file-control
        class={[
          "relative group/file-control",
          !@file_editable && !@file_inline && "hidden",
          @file_inline &&
            [
              "grid items-center",
              cond do
                @file_steps -> "grid-cols-[minmax(0,1fr)_auto_1.75rem_1.75rem]"
                @preview && @upload -> "grid-cols-[minmax(0,1fr)]"
                true -> "grid-cols-[minmax(0,1fr)_1.75rem]"
              end,
              !@text_look &&
                [
                  "input-floating-wrapper min-h-11 rounded-default border bg-transparent text-content focus-within:border-brand focus-within:ring-2 focus-within:ring-brand",
                  (@errors == [] || @error_class) && "border-outline",
                  @errors != [] &&
                    (@error_class ||
                       "border-error focus-within:border-error focus-within:ring-error")
                ],
              @text_look && if(@label, do: "min-h-7", else: "min-h-11"),
              (@rest[:disabled] || @render_as in ["disabled", "like-disabled"]) &&
                "overlay-dark cursor-not-allowed text-subcontent"
            ]
        ]}
      >
        <label
          for={@file_id}
          class={[
            "min-w-0",
            if(@file_editable || @file_inline, do: "relative block", else: "hidden"),
            @text_look && "flex flex-col gap-1 cursor-pointer has-[:disabled]:cursor-not-allowed"
          ]}
        >
          <% input_class =
            if @text_look do
              "sr-only"
            else
              [
                @class ||
                  [
                    "block w-full min-h-11 px-3 rounded-default border bg-transparent text-content focus:outline-none focus:border-brand focus:ring-2 focus:ring-brand disabled:overlay-dark disabled:text-subcontent disabled:cursor-not-allowed",
                    if(@label, do: "input-floating-control", else: "py-2"),
                    (@errors == [] || @error_class) && "border-outline"
                  ],
                @errors != [] &&
                  (@error_class || "border-error focus:border-error focus:ring-error")
              ]
            end %>
          <.live_file_input
            :if={@upload}
            upload={@file_upload}
            {@rest}
            data-file-input
            disabled={@rest[:disabled] || not @file_editable}
            class={
              if @file_inline,
                do: ["sr-only peer", @label && !@text_look && "input-floating-control"],
                else: input_class
            }
          />
          <input
            :if={!@upload}
            type="file"
            id={@file_id}
            name={@name}
            {@rest}
            data-file-input
            placeholder={@placeholder}
            disabled={@rest[:disabled] || not @file_editable}
            class={
              if @file_inline,
                do: ["sr-only peer", @label && !@text_look && "input-floating-control"],
                else: input_class
            }
          />
          <span
            :if={(@file_editable || @file_inline) && @label not in [nil, ""]}
            class={
              if @text_look,
                do: ["text-sm font-medium", (@errors != [] && "text-error") || "text-subcontent"],
                else: [
                  "input-floating-label",
                  @errors != [] && "input-floating-label-error"
                ]
            }
          >
            {@label}<span
              :if={
                @rest[:required] && @rest[:disabled] in [nil, false] &&
                  @rest[:readonly] in [nil, false] &&
                  (@file_editable || @render_as == "like-enabled")
              }
              aria-hidden="true"
              class="input-required ml-1 text-error"
            >*</span>
          </span>

          <span
            data-file-name
            data-file-readonly-name={if @file_inline && !@file_editable, do: ""}
            data-file-display={if @file_inline && !@text_look, do: ""}
            data-file-count={if @selection == "singles" && @preview && !@text_look, do: ""}
            data-file-default-name={
              if @file_inline && !@file_editable, do: @file_readonly_name, else: @file_placeholder
            }
            aria-live={if @selection == "singles", do: "polite"}
            class={[
              if(
                @file_inline ||
                  (@text_look && (@upload == nil || (@stored == [] && @file_entries == []))),
                do: "block",
                else: "hidden"
              ),
              "w-full text-sm overflow-hidden text-ellipsis whitespace-nowrap group-has-[input:focus-visible]/upload:underline",
              if(@file_inline && !@text_look,
                do: [
                  @class || "min-h-10.5 px-3 py-2.5",
                  "peer-focus-visible:underline",
                  @rest[:disabled] && "cursor-not-allowed"
                ],
                else: if(@label, do: "min-h-6 py-1", else: "min-h-11 content-center text-center")
              ),
              if(@rest[:disabled] || !@file_editable,
                do: "text-subcontent",
                else: "text-content"
              ),
              @errors != [] && (@error_class || "text-error")
            ]}
          >{cond do
            @file_has_placeholder && !@file_has_value -> @file_placeholder
            @selection == "singles" && @preview -> @file_count_label
            @file_inline && @file_caption != [] -> render_slot(@file_caption, @file_caption_value)
            @file_inline -> @file_name
            true -> @file_placeholder
          end}</span>
        </label>

        <span
          :if={@file_steps}
          data-file-position
          class="px-1 text-sm whitespace-nowrap text-subcontent"
        >{@file_position}</span>
        <div
          :if={@upload == nil || (@file_inline && !@preview)}
          class={if @file_inline, do: "grid place-items-center", else: "contents"}
        >
          <button
            type="button"
            data-file-clear
            hidden
            disabled={@rest[:disabled] || not @file_editable}
            aria-label="Clear selected file"
            class={[
              "button-base",
              "grid size-7 place-items-center rounded-default text-error cursor-pointer focus-visible:outline-2 focus-visible:outline-brand disabled:cursor-not-allowed",
              !@file_inline && "absolute top-2 right-2 bg-primary"
            ]}
          ><.icon name="hero-x-mark-mini" class="size-5" /></button>
        </div>

        <div
          :if={@file_steps}
          class={[
            "grid grid-cols-[1fr] grid-rows-[1fr_1fr] self-stretch border-l border-outline",
            @text_look &&
              "opacity-0 pointer-events-none group-hover/file-control:opacity-100 group-hover/file-control:pointer-events-auto has-[:focus-visible]:opacity-100 has-[:focus-visible]:pointer-events-auto"
          ]}
        >
          <button
            type="button"
            data-file-cycle-input="next"
            data-file-next
            aria-label="Next file"
            aria-controls={@file_id}
            disabled={length(@stored) + length(@file_entries) < 2}
            class={[
              "button-base",
              "grid min-h-3.5 place-items-center rounded-none text-subcontent cursor-pointer hover:text-content focus-visible:outline-2 focus-visible:outline-brand disabled:cursor-not-allowed",
              !@text_look && "rounded-tr-default hover:overlay-dark"
            ]}
          ><.icon name="hero-chevron-up-micro" class="size-3" /></button>
          <button
            type="button"
            data-file-cycle-input="previous"
            data-file-previous
            aria-label="Previous file"
            aria-controls={@file_id}
            disabled={length(@stored) + length(@file_entries) < 2}
            class={[
              "button-base",
              "grid min-h-3.5 place-items-center rounded-none border-t border-outline text-subcontent cursor-pointer hover:text-content focus-visible:outline-2 focus-visible:outline-brand disabled:cursor-not-allowed",
              !@text_look && "rounded-br-default hover:overlay-dark"
            ]}
          ><.icon name="hero-chevron-down-micro" class="size-3" /></button>
        </div>
      </div>

      <span
        :if={(not @file_editable && !@file_inline) and @label not in [nil, ""]}
        class="block text-sm font-medium text-subcontent"
      >
        {@label}<span
          :if={
            @rest[:required] && @rest[:disabled] in [nil, false] &&
              @rest[:readonly] in [nil, false] &&
              @render_as == "like-enabled"
          }
          aria-hidden="true"
          class="input-required ml-1 text-error"
        >*</span>
      </span>

      <span
        :if={@upload == nil && !@file_inline && not @file_editable}
        data-file-readonly-name
        data-file-default-name={@file_readonly_name}
        class={[
          "block w-full overflow-hidden text-ellipsis whitespace-nowrap text-sm text-subcontent",
          if(@text_look,
            do: "min-h-6 py-1",
            else: [
              "min-h-11 rounded-default border border-outline bg-transparent px-3 py-2",
              @render_as in ["disabled", "like-disabled"] && "overlay-dark"
            ]
          )
        ]}
      >{if @selection == "singles", do: @file_count_label, else: @file_readonly_name}</span>
      <%= if @file_detached do %>
        <.portal
          id={"#{@file_id}-file-preview-portal"}
          target={"[id=#{Jason.encode!(@preview_id)}]"}
          class="contents"
        >
          {file_previews(assigns)}
        </.portal>
      <% else %>
        {file_previews(assigns)}
      <% end %>
      <.image_editor :if={@file_editor_enabled} />
      <div id={"#{@file_id}-file-replacements"} phx-update="ignore" data-file-replacements />
      <p data-file-error hidden role="alert" class="mt-2 text-sm text-error" />
      <.error :for={msg <- @errors}>{msg}</.error>
    </div>
  <% :file_preview -> %>
    <div id={@id} data-file-preview-outlet class={@class} {@rest} />
  <% :file_previews -> %>
    <div
      id={"#{@file_id}-file-previews"}
      phx-hook="FilePreview"
      data-file-input-id={@file_id}
      data-file-detached={to_string(@file_detached)}
      data-file-preview-as={@preview_as}
      data-file-collection
      hidden={
        (!@preview && @selection != "multiple") ||
          (@file_detached && @render_as in ["hidden", "hidden-enabled", "hidden-disabled"])
      }
      class={[
        "group/file-previews relative",
        @file_detached && "w-full",
        @file_detached && @preview_as == "thumbnail" && "h-full",
        !@file_detached && @selection == "singles" &&
          if(@preview_as == "thumbnail", do: "mt-3", else: "mt-1")
      ]}
    >
      <button
        :if={@selection == "singles" && @preview}
        type="button"
        data-file-cycle="previous"
        data-file-previous
        hidden={length(@stored) + length(@file_entries) < 2}
        aria-label="Previous file"
        class="button-base left-1 grid size-7 place-items-center rounded-full text-content cursor-pointer hover:overlay-dark focus-visible:text-brand focus-visible:outline-none"
      ><.icon name="hero-chevron-left-mini" class="size-5" /></button>
      <div
        data-file-preview-content
        class={["min-w-0", @file_detached && @preview_as == "thumbnail" && "h-full"]}
      >
        <div
          :if={@stored != [] or @file_entries != []}
          data-file-server-previews
          class={[
            @previews_class,
            @file_detached && @preview_as == "thumbnail" && "grid-rows-[minmax(0,1fr)]"
          ]}
        >
          <.file_preview_item
            :for={{url, index} <- Enum.with_index(@stored)}
            input_id={@file_id}
            url={url}
            preview={@preview}
            selection={@selection}
            preview_as={@preview_as}
            thumbnail_class={@thumbnail_class}
            media_slot={@stored_preview}
            caption_slot={@preview_caption}
            editable={@upload != nil && @file_editable}
            edit_enabled={@file_editor_enabled && @file_editable}
            disabled={@rest[:disabled]}
            text_look={@text_look}
            hidden={
              @selection != "multiple" &&
                (index > 0 || (@selection == "single" && @file_entries != []))
            }
            target={@rest[:"phx-target"]}
          />
          <.file_preview_item
            :for={{entry, index} <- Enum.with_index(@file_entries)}
            input_id={@file_id}
            entry={entry}
            preview={@preview}
            selection={@selection}
            preview_as={@preview_as}
            thumbnail_class={@thumbnail_class}
            media_slot={@pending_preview}
            caption_slot={@pending_caption}
            editable={@file_editable}
            edit_enabled={@file_editor_enabled && @file_editable}
            disabled={@rest[:disabled]}
            text_look={@text_look}
            hidden={
              @selection != "multiple" &&
                (index > 0 || (@selection == "singles" && @stored != []))
            }
            target={@rest[:"phx-target"]}
          />
        </div>

        <div
          :if={@upload == nil && (@preview || @selection != "multiple")}
          id={"#{@file_id}-file-preview-frame"}
          data-file-preview-container
          data-file-preview-as={@preview_as}
          hidden
          class={[
            "relative rounded-default border border-outline",
            !@file_detached && @selection != "singles" && "mt-3",
            if(@preview_as == "thumbnail",
              do: ["bg-transparent", @thumbnail_class],
              else: [
                "grid grid-cols-[minmax(0,1fr)_auto] items-center gap-1 bg-secondary p-1.5",
                @selection == "singles" && "px-9"
              ]
            )
          ]}
        >
          <div
            id={"#{@file_id}-file-local-preview"}
            phx-update="ignore"
            data-file-preview-region
            class="contents"
          >
            <img
              data-file-preview-image
              hidden
              alt="Selected image"
              class="size-full rounded-default object-contain"
            />
            <iframe
              data-file-preview-pdf
              hidden
              title="Selected PDF"
              class="size-full rounded-default border-0"
            />
            <a
              data-file-preview-open
              hidden
              target="_blank"
              rel="noopener noreferrer"
              class={[
                "grid size-6 place-items-center rounded-default border border-outline bg-primary text-content hover:overlay-dark focus-visible:outline-2 focus-visible:outline-brand",
                @preview_as == "thumbnail" && "absolute bottom-1 left-1"
              ]}
              aria-label="Open selected file"
            ><.icon name="hero-arrow-top-right-on-square-micro" class="size-4" /></a>
            <span data-file-preview-name hidden class="block truncate text-sm text-subcontent" />
            <span
              data-file-preview-caption
              data-file-caption
              hidden
              class="block truncate text-sm"
            />
            <button
              type="button"
              data-file-edit
              hidden
              disabled={@rest[:disabled] || not @file_editable}
              aria-label="Edit selected image"
              class="button-base grid min-h-7 place-items-center rounded-default border border-outline bg-primary px-2 text-sm text-content cursor-pointer hover:overlay-dark focus-visible:outline-2 focus-visible:outline-brand disabled:cursor-not-allowed"
            >Edit</button>
          </div>
        </div>
      </div>

      <button
        :if={@selection == "singles" && @preview}
        type="button"
        data-file-cycle="next"
        data-file-next
        hidden={length(@stored) + length(@file_entries) < 2}
        aria-label="Next file"
        class="button-base right-1 grid size-7 place-items-center rounded-full text-content cursor-pointer hover:overlay-dark focus-visible:text-brand focus-visible:outline-none"
      ><.icon name="hero-chevron-right-mini" class="size-5" /></button>
      <span
        :if={@selection == "singles" && @preview}
        data-file-position
        data-file-preview-position
        class="absolute bottom-1 right-1 z-10 rounded-default bg-primary px-1 text-sm text-content opacity-0 pointer-events-none transition-opacity group-hover/file-previews:opacity-100"
      >{@file_position}</span>
    </div>
  <% :file_preview_item -> %>
    <div
      id={"#{@input_id}-file-#{@identity}"}
      data-file-item
      data-file-key={(@entry && @entry.ref) || @url}
      data-file-stored={@entry == nil}
      data-file-entry-ref={@entry && @entry.ref}
      data-file-url={@url}
      data-file-content-type={@content_type}
      data-file-item-name={@file_name}
      hidden={@hidden}
      class={["min-w-0", @hidden && "hidden"]}
    >
      <div
        data-file-preview-as={@preview_as}
        class={
          if @preview_as == "thumbnail" do
            [
              "group/preview relative rounded-default border border-outline bg-transparent",
              @thumbnail_class
            ]
          else
            [
              "group/preview relative grid items-center gap-1 rounded-default border border-outline bg-secondary p-1.5 text-sm text-content",
              if(@selection == "singles", do: "px-9", else: "mr-1 mt-1"),
              if(@preview && not @media_available,
                do: "grid-cols-[minmax(0,1fr)_auto_auto]",
                else: "grid-cols-[minmax(0,1fr)_auto]"
              )
            ]
          end
        }
      >
        <.dynamic_tag
          :if={@caption_hover}
          tag_name={@caption_tag}
          {@caption_rest}
          data-file-caption
          data-file-filename
          class="block truncate text-sm"
        >
          <%= if @caption_slot != [] do %>
            {render_slot(@caption_slot, @caption_value)}
          <% else %>
            {@file_name}
          <% end %>
        </.dynamic_tag>

        <.dynamic_tag
          :if={@media_available}
          tag_name={if @text_look, do: "label", else: "div"}
          {@caption_rest}
          class={[
            @preview_as == "thumbnail" && "size-full",
            @preview_as == "tag" && @caption_used && "hidden",
            @text_look && "block group-has-[input:focus-visible]/upload:underline",
            @text_look && if(@disabled, do: "cursor-not-allowed", else: "cursor-pointer")
          ]}
        >
          <%= cond do %>
            <% @media_slot != [] -> %>
              {render_slot(@media_slot, @caption_value)}
            <% @content_type == "application/pdf" -> %>
              <div
                id={"#{@input_id}-pdf-#{@identity}"}
                phx-hook="UploadPdfPreview"
                phx-update="ignore"
                data-pdf-url={@url}
                data-upload-ref={@entry && @entry.upload_ref}
                data-entry-ref={@entry && @entry.ref}
                class="relative size-full overflow-hidden rounded-default bg-transparent"
              >
                <iframe
                  data-pdf-viewer
                  title={"PDF preview of #{@file_name}"}
                  hidden
                  class="size-full border-0"
                />
                <p
                  data-pdf-status
                  role="status"
                  class="pointer-events-none absolute inset-0 grid place-items-center px-2 text-center text-sm text-subcontent"
                >
                  Loading PDF preview...
                </p>

                <a
                  data-pdf-open
                  target="_blank"
                  rel="noopener noreferrer"
                  aria-label={"Open #{@file_name}"}
                  data-tooltip={"Open #{@file_name}"}
                  hidden
                  class="absolute bottom-1 left-1 grid size-6 place-items-center rounded-default border border-outline bg-primary text-content hover:overlay-dark focus-visible:outline-2 focus-visible:outline-brand"
                ><.icon name="hero-arrow-top-right-on-square-micro" class="size-4" /></a>
              </div>
            <% @entry != nil -> %>
              <.live_img_preview
                entry={@entry}
                alt={@file_name}
                class="size-full rounded-default object-contain"
              />
            <% true -> %>
              <img src={@url} alt={@file_name} class="size-full rounded-default object-contain" />
          <% end %>
        </.dynamic_tag>

        <.dynamic_tag
          :if={not @media_available or (@preview_as == "tag" && @caption_used)}
          tag_name={@caption_tag}
          {@caption_rest}
          data-file-filename
          class={[
            "min-w-0 truncate",
            @preview_as == "thumbnail" &&
              "grid size-full place-items-center px-2 text-sm text-subcontent",
            @text_look && "group-has-[input:focus-visible]/upload:underline",
            @text_look && if(@disabled, do: "cursor-not-allowed", else: "cursor-pointer")
          ]}
        >
          <%= if @caption_slot != [] do %>
            {render_slot(@caption_slot, @caption_value)}
          <% else %>
            {@file_name}
          <% end %>
        </.dynamic_tag>

        <a
          :if={@preview && not @media_available}
          href={@url}
          data-file-open
          data-upload-ref={@entry && @entry.upload_ref}
          data-entry-ref={@entry && @entry.ref}
          aria-label={"Open #{@file_name}"}
          target="_blank"
          rel="noopener noreferrer"
          class={[
            "grid size-6 place-items-center rounded-default border border-outline bg-primary text-content hover:overlay-dark focus-visible:outline-2 focus-visible:outline-brand",
            @preview_as == "thumbnail" && "absolute bottom-1 left-1"
          ]}
        ><.icon name="hero-arrow-top-right-on-square-micro" class="size-4" /></a>
        <button
          :if={@edit_enabled && @content_type in ~w(image/png image/jpeg image/gif image/webp)}
          type="button"
          data-file-edit={(@entry && @entry.ref) || @url}
          disabled={@disabled}
          aria-label={"Edit #{@file_name}"}
          class="button-base grid min-h-7 place-items-center rounded-default border border-outline bg-primary px-2 text-sm text-content cursor-pointer hover:overlay-dark focus-visible:outline-2 focus-visible:outline-brand disabled:cursor-not-allowed"
        >Edit</button>
        <button
          :if={@editable}
          type="button"
          data-file-remove
          disabled={@disabled}
          phx-click={if @entry, do: "cancel_upload", else: "remove_upload"}
          phx-value-ref={@entry && @entry.ref}
          phx-value-url={@url}
          phx-target={@target}
          aria-label={if @entry, do: "Cancel #{@file_name}", else: "Remove file"}
          class={[
            "button-base",
            "min-h-5 min-w-5 text-error cursor-pointer opacity-0 pointer-events-none group-hover/preview:opacity-100 group-hover/preview:pointer-events-auto focus-visible:opacity-100 focus-visible:pointer-events-auto disabled:opacity-0!",
            @preview_as == "thumbnail" && "absolute top-1 right-1"
          ]}
        ><.icon name="hero-x-mark-mini" class="size-5" /></button>
      </div>

      <span
        :if={@media_slot != [] && !@caption_used && !@caption_hover}
        data-file-filename
        class="sr-only"
      >{@file_name}</span>
      <.dynamic_tag
        :if={!@caption_hover && @preview_as == "thumbnail" && @media_available && @caption_used}
        tag_name={@caption_tag}
        {@caption_rest}
        data-file-filename
        class={[
          "mt-1 block truncate text-sm text-subcontent",
          @text_look && if(@disabled, do: "cursor-not-allowed", else: "cursor-pointer")
        ]}
      >
        <%= if @caption_slot != [] do %>
          {render_slot(@caption_slot, @caption_value)}
        <% else %>
          {@file_name}
        <% end %>
      </.dynamic_tag>
    </div>
  <% :image_editor -> %>
    <template data-file-editor-template>
      <dialog
        class="file-editor m-auto w-[min(56rem,calc(100vw-2rem))] max-h-[calc(100vh-2rem)] grid-cols-[1fr] gap-4 overflow-auto rounded-default border border-outline bg-primary p-4 text-content shadow-lg open:grid backdrop:[background:var(--color-dark)]"
        aria-label="Edit image"
      >
        <h2 class="text-lg font-semibold">Edit image</h2>

        <div class="file-editor-canvas h-[min(60vh,28rem)] min-h-48">
          <img data-editor-source hidden alt="Image to edit" />
          <cropper-canvas class="size-full bg-primary bg-transparency-grid bg-size-[1rem_1rem]">
            <cropper-image
              alt="Image to edit"
              rotatable
              scalable
              translatable
              initial-fit="contain"
            >
            </cropper-image>

            <cropper-shade hidden theme-color="var(--color-dark)"></cropper-shade>

            <cropper-handle action="select" plain></cropper-handle>

            <cropper-selection
              initial-coverage="0.8"
              min-inset="0"
              movable
              resizable
              precise
              outlined
              theme-color="var(--color-brand)"
            >
              <cropper-grid role="grid" covered theme-color="var(--color-content)"></cropper-grid>

              <cropper-crosshair centered theme-color="var(--color-content)"></cropper-crosshair>

              <cropper-handle action="move" theme-color="var(--color-light)"></cropper-handle>

              <cropper-handle action="n-resize" theme-color="var(--color-brand)"></cropper-handle>

              <cropper-handle action="e-resize" theme-color="var(--color-brand)"></cropper-handle>

              <cropper-handle action="s-resize" theme-color="var(--color-brand)"></cropper-handle>

              <cropper-handle action="w-resize" theme-color="var(--color-brand)"></cropper-handle>

              <cropper-handle action="ne-resize" theme-color="var(--color-brand)">
              </cropper-handle>

              <cropper-handle action="nw-resize" theme-color="var(--color-brand)">
              </cropper-handle>

              <cropper-handle action="se-resize" theme-color="var(--color-brand)">
              </cropper-handle>

              <cropper-handle action="sw-resize" theme-color="var(--color-brand)">
              </cropper-handle>
            </cropper-selection>
          </cropper-canvas>
        </div>

        <div class="grid grid-cols-[repeat(auto-fit,minmax(6rem,1fr))] gap-2">
          <.button type="button" variant={:neutral} data-editor-action="rotate-left" disabled>Rotate left</.button>
          <.button type="button" variant={:neutral} data-editor-action="rotate-right" disabled>Rotate right</.button>
          <.button type="button" variant={:neutral} data-editor-action="flip-horizontal" disabled>Flip horizontally</.button>
          <.button type="button" variant={:neutral} data-editor-action="flip-vertical" disabled>Flip vertically</.button>
          <.button type="button" variant={:neutral} data-editor-action="reset" disabled>Reset</.button>
        </div>

        <p
          class="min-h-5 text-sm text-subcontent"
          data-editor-status
          role="status"
          aria-live="polite"
        >
          Loading image...
        </p>

        <p class="text-sm text-error" data-editor-error role="alert" hidden></p>

        <div class="grid grid-cols-[repeat(auto-fit,minmax(6rem,1fr))] gap-2">
          <.button type="button" variant={:neutral} data-editor-action="cancel">Cancel</.button>
          <.button type="button" variant={:primary} data-editor-action="confirm" disabled>Use image</.button>
        </div>
      </dialog>
    </template>
  <% :calendar -> %>
    <%!-- Event calendar --%>
    <div id={@id} class="mt-4 flex flex-col gap-3">
      <.cal_nav view={@view} cursor={@cursor} today={@today} />
      <%= case @view do %>
        <% :month -> %>
          <.month_body events={@events} cursor={@cursor} today={@today} />
        <% :year -> %>
          <.year_body events={@events} cursor={@cursor} today={@today} />
        <% :schedule -> %>
          <.agenda_body events={@events} cursor={@cursor} active={@active_event} />
        <% grid_view -> %>
          <% grid = time_columns(grid_view, @cursor, @events, @resources, @today, @now_local) %>
          <p :if={grid.columns == []} class="text-sm text-subcontent">No resources to show.</p>

          <.time_body
            :if={grid.columns != []}
            id={@id}
            columns={grid.columns}
            now_col={grid.now_col}
            now_minutes={grid.now_minutes}
            active={@active_event}
          />
      <% end %>
    </div>
  <% :cal_nav -> %>
    <div class="grid grid-cols-[max-content_2.75rem_2.75rem_1fr_max-content] items-center gap-2">
      <.button
        type="button"
        phx-click="calendar_change"
        phx-value-view={@view}
        phx-value-date={Date.to_iso8601(@today)}
        variant={:neutral}
      >
        Today
      </.button>

      <.button
        type="button"
        phx-click="calendar_change"
        phx-value-view={@view}
        phx-value-date={Date.to_iso8601(CalendarUtils.shift(@view, @cursor, -1))}
        aria-label="Previous calendar period"
        variant={:neutral}
        class="size-11 p-0!"
      >
        <.icon name="hero-chevron-left" class="size-4" />
      </.button>

      <.button
        type="button"
        phx-click="calendar_change"
        phx-value-view={@view}
        phx-value-date={Date.to_iso8601(CalendarUtils.shift(@view, @cursor, 1))}
        aria-label="Next calendar period"
        variant={:neutral}
        class="size-11 p-0!"
      >
        <.icon name="hero-chevron-right" class="size-4" />
      </.button>

      <h2 class="text-lg font-semibold text-content">{@period_title}</h2>

      <div class="grid grid-cols-[repeat(6,max-content)] gap-2">
        <.button
          :for={{value, label} <- CalendarUtils.views()}
          type="button"
          phx-click="calendar_change"
          phx-value-view={value}
          phx-value-date={Date.to_iso8601(@cursor)}
          aria-pressed={if @view == value, do: "true", else: "false"}
        >
          {label}
        </.button>
      </div>
    </div>
  <% :time_body -> %>
    <div class="rounded-default border border-outline bg-primary">
      <svg
        viewBox={"0 0 #{@width} #{@header}"}
        class="block w-full"
        preserveAspectRatio="xMidYMid meet"
      >
        <g :for={{col, i} <- Enum.with_index(@columns)}>
          <text
            x={@gutter + i * @col_w + @col_w / 2}
            y={@header / 2 - 3}
            text-anchor="middle"
            font-size="11"
            class="fill-subcontent"
          >
            {col.sublabel}
          </text>

          <text
            x={@gutter + i * @col_w + @col_w / 2}
            y={@header / 2 + 12}
            text-anchor="middle"
            font-size="14"
            class={["font-semibold", (col[:today?] && "fill-brand") || "fill-content"]}
          >
            {col.label}
          </text>
        </g>
      </svg>

      <div class="max-h-[42rem] overflow-auto border-t border-outline">
        <svg
          viewBox={"0 0 #{@width} #{@day}"}
          class="block w-full"
          preserveAspectRatio="xMidYMid meet"
        >
          <g :for={h <- 0..23}>
            <line
              x1={@gutter}
              y1={h * @hour}
              x2={@width}
              y2={h * @hour}
              class="stroke-outline"
              stroke-width="0.5"
            />
            <text
              x={@gutter - 6}
              y={h * @hour + 4}
              text-anchor="end"
              font-size="11"
              class="fill-subcontent"
            >
              {case h do
                0 -> "12 AM"
                12 -> "12 PM"
                h when h < 12 -> "#{h} AM"
                h -> "#{h - 12} PM"
              end}
            </text>
          </g>

          <line
            :for={i <- 0..@ncols}
            x1={@gutter + i * @col_w}
            y1="0"
            x2={@gutter + i * @col_w}
            y2={@day}
            class="stroke-outline"
            stroke-width="0.5"
          />
          <g :for={{col, i} <- Enum.with_index(@columns)}>
            <g :for={event <- col.events} class={[event.fill_class, "hover:overlay-dark"]}>
              <% box = event_box(event, i, @col_w) %>
              <rect
                aria-hidden="true"
                x={box.x}
                y={box.y}
                width={box.w}
                height={box.h}
                stroke-width={(event.id == @active && "3") || "1"}
                class={["rounded-default", event.stroke_class]}
              />
              <text
                x={box.x + 6}
                y={box.y + 15}
                font-size="12"
                class={["pointer-events-none font-medium", event.label_fill_class]}
              >
                {String.slice(event.title, 0, trunc(box.w / 7))}
              </text>

              <text
                :if={box.h > 34}
                x={box.x + 6}
                y={box.y + 30}
                font-size="11"
                class={["pointer-events-none", event.label_fill_class]}
              >
                {Calendar.strftime(event.start, "%-I:%M %p")}
              </text>

              <foreignObject x={box.x} y={box.y} width={box.w} height={box.h}>
                <button
                  id={"#{@id}-event-#{i}-#{event.id}"}
                  type="button"
                  aria-label={event.label}
                  aria-pressed={event.id == @active}
                  data-tooltip={event.label}
                  phx-click="calendar_change"
                  phx-value-event={event.id}
                  class="block h-full w-full cursor-pointer rounded-default focus-visible:outline-2 focus-visible:outline-brand"
                >
                  <span class="sr-only">{event.title}</span>
                </button>
              </foreignObject>
            </g>
          </g>

          <g :if={@now_minutes}>
            <line
              x1={@now_x1}
              y1={@now_minutes}
              x2={@now_x2 || @width}
              y2={@now_minutes}
              class="stroke-error"
              stroke-width="1.5"
            /> <circle cx={@now_x1} cy={@now_minutes} r="4" class="fill-error" />
          </g>
        </svg>
      </div>
    </div>
  <% :month_body -> %>
    <div class="overflow-hidden rounded-default border border-outline">
      <div class="grid grid-cols-[1fr_1fr_1fr_1fr_1fr_1fr_1fr]">
        <div
          :for={label <- ~w(Mon Tue Wed Thu Fri Sat Sun)}
          class="border-b border-r border-outline px-2 py-1.5 text-center text-xs font-medium text-subcontent"
        >
          {label}
        </div>

        <div
          :for={day <- @days}
          class={[
            "min-h-[6.5rem] border-b border-r border-outline bg-primary p-1",
            day.month != @cursor.month && "overlay-dark"
          ]}
        >
          <% day_events =
            @events |> CalendarUtils.events_on(day) |> Enum.sort_by(& &1.start, DateTime) %>
          <div class="mb-1 grid justify-items-end">
            <span class={[
              "grid size-6 place-items-center rounded-full text-xs",
              cond do
                day == @today -> "bg-brand font-semibold text-content-inverse dark:text-content"
                day.month != @cursor.month -> "text-subcontent"
                true -> "text-content"
              end
            ]}>
              {day.day}
            </span>
          </div>

          <div class="flex flex-col gap-0.5">
            <button
              :for={event <- Enum.take(day_events, 3)}
              type="button"
              phx-click="calendar_change"
              phx-value-event={event.id}
              aria-label={event.label}
              class={[
                "truncate rounded-default px-1 py-0.5 text-left text-xs hover:overlay-dark",
                event.bar_class
              ]}
            >
              {Calendar.strftime(event.start, "%-I:%M %p")} {event.title}
            </button>

            <button
              :if={length(day_events) > 3}
              type="button"
              phx-click="calendar_change"
              phx-value-view="day"
              phx-value-date={Date.to_iso8601(day)}
              class="px-1 text-left text-xs text-subcontent hover:overlay-dark"
            >
              {length(day_events) - 3} more
            </button>
          </div>
        </div>
      </div>
    </div>
  <% :year_body -> %>
    <div class="grid grid-cols-[1fr_1fr_1fr_1fr] gap-3">
      <div :for={month <- 1..12} class="rounded-default border border-outline bg-primary p-2">
        <p class="mb-1 text-center text-sm font-semibold text-content">
          {Calendar.strftime(Date.new!(2000, month, 1), "%B")}
        </p>

        <div class="grid grid-cols-[1fr_1fr_1fr_1fr_1fr_1fr_1fr]">
          <div
            :for={label <- ~w(M T W T F S S)}
            class="pb-0.5 text-center text-[0.6rem] text-subcontent"
          >
            {label}
          </div>
        </div>

        <div
          :for={week <- CalendarUtils.month_grid(Date.new!(@cursor.year, month, 1))}
          class="grid grid-cols-[1fr_1fr_1fr_1fr_1fr_1fr_1fr]"
        >
          <button
            :for={day <- week}
            type="button"
            phx-click="calendar_change"
            phx-value-view="day"
            phx-value-date={Date.to_iso8601(day)}
            class={[
              "rounded-default py-0.5 text-center text-[0.65rem] hover:overlay-dark",
              cond do
                day == @today -> "bg-brand font-semibold text-content-inverse dark:text-content"
                day.month != month -> "text-subcontent"
                MapSet.member?(@event_days, day) -> "font-bold text-brand"
                true -> "text-content"
              end
            ]}
          >
            {day.day}
          </button>
        </div>
      </div>
    </div>
  <% :agenda_body -> %>
    <div class="divide-y divide-outline rounded-default border border-outline bg-primary">
      <p :if={@groups == []} class="p-4 text-sm text-subcontent">No events in this range.</p>

      <div :for={{day, day_events} <- @groups} class="grid grid-cols-[8rem_1fr]">
        <button
          type="button"
          phx-click="calendar_change"
          phx-value-view="day"
          phx-value-date={Date.to_iso8601(day)}
          class="p-3 text-left hover:overlay-dark"
        >
          <p class="text-sm font-semibold text-content">{Calendar.strftime(day, "%a")}</p>

          <p class="text-xs text-subcontent">{Calendar.strftime(day, "%-d %b")}</p>
        </button>

        <div class="flex flex-col divide-y divide-outline">
          <button
            :for={event <- Enum.sort_by(day_events, & &1.start, DateTime)}
            type="button"
            phx-click="calendar_change"
            phx-value-event={event.id}
            aria-label={event.label}
            aria-pressed={event.id == @active}
            class={[
              "grid grid-cols-[0.75rem_9rem_1fr_auto] items-center gap-2 bg-primary p-3 text-left",
              if(event.id == @active, do: "overlay-dark", else: "hover:overlay-dark")
            ]}
          >
            <span class={["size-2.5 rounded-full", event.dot_class]}></span>
            <span class="text-xs text-subcontent">
              {Calendar.strftime(event.start, "%-I:%M %p")} to {Calendar.strftime(
                event.finish,
                "%-I:%M %p"
              )}
            </span>
            <span class="truncate text-sm text-content">{event.title}</span>
            <span :if={event.subtitle} class="text-xs text-subcontent">{event.subtitle}</span>
          </button>
        </div>
      </div>
    </div>
<% end %>
