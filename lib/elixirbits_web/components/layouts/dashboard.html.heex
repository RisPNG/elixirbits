<%= case @component do %>
  <% :dashboard -> %>
    <div
      class="shell-surface grid min-h-screen grid-rows-[4rem_minmax(0,1fr)]"
      data-user-timezone={@user_timezone}
    >
      <header
        data-page-chrome="header"
        class={[
          "shell-surface sticky top-0 z-30 grid items-center gap-3 px-4",
          (@show_nav? && "grid-cols-[2.75rem_minmax(0,1fr)_max-content]") ||
            "grid-cols-[minmax(0,1fr)_max-content]"
        ]}
      >
        <button
          :if={@show_nav?}
          type="button"
          phx-click="toggle_nav"
          data-page-chrome="menu"
          aria-label="Toggle navigation"
          aria-expanded={to_string(@nav.open?)}
          aria-controls="app-navigation"
          class="grid size-11 place-items-center rounded-default text-subcontent transition-colors hover:overlay-dark focus-visible:outline-2 focus-visible:outline-brand cursor-pointer"
        >
          <.icon name="hero-bars-3" class="size-5" />
        </button>

        <.link
          navigate={~p"/dashboard"}
          data-page-chrome="brand"
          class="grid w-fit max-w-full grid-cols-[2rem_minmax(0,1fr)] items-center gap-2"
        >
          <img src={~p"/images/logo.svg"} width="32" alt="" />
          <span class="truncate text-sm font-semibold">
            {(@nav.organization && @nav.organization.name) || "Elixirbits"}
          </span>
        </.link>

        <div class="grid grid-cols-[max-content_max-content] items-center gap-3">
          <.theme_toggle />
          <button
            :if={@nav.user}
            type="button"
            popovertarget="account-menu"
            aria-label="Open account menu"
            aria-haspopup="dialog"
            class="grid size-11 cursor-pointer place-items-center rounded-full bg-brand overlay-opacity-[0.14] text-content transition-colors hover:overlay-dark focus-visible:outline-2 focus-visible:outline-brand"
          >
            <img
              :if={@nav.user.display_pic_url}
              src={@nav.user.display_pic_url}
              alt=""
              class="size-10 rounded-full object-cover"
            />
            <span :if={!@nav.user.display_pic_url} class="text-sm font-semibold">
              {String.upcase(
                String.slice(@nav.user.display_name || to_string(@nav.user.email), 0, 1)
              )}
            </span>
          </button>

          <.button :if={is_nil(@nav.user)} variant={:neutral} navigate={~p"/dashboard/sign-in"}>
            Sign in
          </.button>
        </div>

        <div
          :if={@nav.user}
          id="account-menu"
          popover="auto"
          role="dialog"
          aria-label="Account"
          data-popover-align="end"
          data-popover-motion
          phx-hook="PopoverPlacement"
          class="panel-surface fixed inset-auto mx-0 my-2 w-80 max-w-[calc(100vw-1rem)] max-h-[min(calc(100vh_-_5rem),var(--popover-room,100vh))] space-y-5 overflow-y-auto rounded-default border border-outline p-5 shadow-lg [position-anchor:auto] [position-area:block-end_span-inline-start] [position-try-fallbacks:flip-inline,flip-block,flip-block_flip-inline] [position-try-order:most-block-size]"
        >
          <div class="space-y-1">
            <p class="truncate text-sm font-semibold text-content">
              {@nav.user.display_name || to_string(@nav.user.email)}
            </p>

            <p :if={@nav.user.display_name} class="truncate text-xs text-subcontent">
              {@nav.user.email}
            </p>

            <p :if={@nav.user.roles != []} class="truncate text-xs text-subcontent">
              {Enum.join(@nav.user.roles, ", ")}
            </p>
          </div>

          <.form
            :let={form}
            for={@nav.timezone_form}
            id="user-timezone-form"
            phx-change="timezone_change"
            phx-submit="change_timezone"
            class="space-y-3 border-t border-outline pt-4"
          >
            <.input
              id="user-timezone"
              field={form[:timezone]}
              type="combobox"
              label="Timezone"
              options={@nav.timezone_options}
              placeholder="Automatic (browser)"
              clear_button={false}
            />
            <p class="text-xs text-subcontent">Currently using {@user_timezone}</p>
            <.button type="submit" variant={:neutral}>Save timezone</.button>
          </.form>

          <.link
            href={~p"/dashboard/sign-out"}
            class="grid min-h-10 items-center border-t border-outline pt-3 text-sm text-content underline-offset-4 hover:underline focus-visible:underline"
          >
            Sign out
          </.link>
        </div>
      </header>

      <div
        class="dashboard-grid grid min-w-0 grid-cols-[minmax(0,1fr)]"
        data-navigation={if @show_nav?, do: if(@nav.open?, do: "expanded", else: "compact")}
        data-nav-staged={if @nav.staged?, do: "true"}
      >
        <aside
          :if={@show_nav?}
          id="app-navigation"
          data-page-chrome="rail"
          aria-label="Application navigation"
          class="shell-surface sticky top-16 h-[calc(100dvh-4rem)] min-h-0 self-start overflow-x-hidden overflow-y-auto"
        >
          <nav class="px-3 py-4">
            <.nav_branch
              entries={Map.get(@by_parent, nil, [])}
              by_parent={@by_parent}
              open_codes={@nav.open_codes}
              active_codes={@nav.active_codes}
              current_path={@nav.path}
              depth={0}
              expanded={@nav.open?}
            />
          </nav>
        </aside>

        <main class="workspace-canvas min-w-0 px-8 py-10">
          <div id="dashboard-page" class="mx-auto min-w-0 max-w-[80rem]">
            <div class={@content_class}>
              {render_slot(@inner_block)}
            </div>
          </div>
        </main>
      </div>
    </div>
    <.flash_group flash={@flash} />
  <% :nav_branch -> %>
    <ul class="grid gap-1">
      <li :for={entry <- @entries}>
        <% children = Map.get(@by_parent, entry.code, [])
        open? = children != [] && @expanded && entry.code in @open_codes
        active? = entry.code in @active_codes
        group? = is_nil(entry.url) || children != []
        item_class = ["nav-row", @depth == 0 && "nav-row-root"] %>
        <div class={[
          "rounded-default",
          @depth == 0 && "nav-root-entry",
          group? && "nav-group",
          group? && (open? || active?) && "nav-group-highlight"
        ]}>
          <%= if entry.url do %>
            <div class={[
              "grid items-center",
              children != [] && "nav-row-with-toggle",
              children == [] && "grid-cols-[minmax(0,1fr)]"
            ]}>
              <.link
                navigate={"/" <> entry.url}
                aria-current={
                  if active?,
                    do: if(@current_path == "/" <> entry.url, do: "page", else: "location")
                }
                aria-label={entry.name}
                title={if !@expanded, do: entry.name}
                class={[item_class, active? && "nav-row-current"]}
              >
                <.icon :if={@depth == 0} name={entry.icon || "hero-slash"} class="size-5" />
                <span class="nav-label truncate">{entry.name}</span>
              </.link>
              <button
                :if={children != []}
                type="button"
                phx-click="toggle_nav_section"
                phx-value-code={entry.code}
                aria-label={"Toggle #{entry.name}"}
                aria-expanded={to_string(open?)}
                aria-controls={"nav-#{entry.code}"}
                tabindex={if !@expanded, do: "-1"}
                class="nav-row-toggle grid size-9 cursor-pointer place-items-center rounded-full focus-visible:outline-2 focus-visible:outline-brand"
              >
                <.icon name="hero-chevron-down-micro" class="nav-chevron size-4" />
              </button>
            </div>
          <% else %>
            <button
              type="button"
              phx-click="toggle_nav_section"
              phx-value-code={entry.code}
              aria-label={entry.name}
              title={if !@expanded, do: entry.name}
              aria-expanded={if children != [], do: to_string(open?)}
              aria-controls={if children != [], do: "nav-#{entry.code}"}
              disabled={children == []}
              class={[item_class, children != [] && "nav-row-disclosure"]}
            >
              <.icon :if={@depth == 0} name={entry.icon || "hero-slash"} class="size-5" />
              <span class="nav-label truncate">{entry.name}</span>
              <.icon
                :if={children != []}
                name="hero-chevron-down-micro"
                class="nav-chevron size-4"
              />
            </button>
          <% end %>

          <div
            :if={children != []}
            id={"nav-#{entry.code}"}
            class="nav-disclosure"
            data-open={to_string(open?)}
            inert={!open?}
          >
            <div class="nav-disclosure-clip">
              <.nav_branch
                entries={children}
                by_parent={@by_parent}
                open_codes={@open_codes}
                active_codes={@active_codes}
                current_path={@current_path}
                depth={@depth + 1}
                expanded={@expanded}
              />
            </div>
          </div>
        </div>
      </li>
    </ul>
<% end %>
